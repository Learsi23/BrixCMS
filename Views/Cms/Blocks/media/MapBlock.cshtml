@model BrixCMS.Open.Models.Blocks.MapBlock
@{
    var address     = Model.Address?.Value ?? "";
    var zoom        = Model.Zoom?.Value ?? "15";
    var mapType     = Model.MapType?.Value ?? "roadmap";
    var mapHeight   = Model.MapHeight?.Value ?? "450px";
    var maxWidth    = Model.MaxWidth?.Value ?? "100%";
    var borderRadius = Model.BorderRadius?.Value ?? "16px";
    var bgColor     = Model.BackgroundColor?.Value ?? "#ffffff";
    var padY        = Model.PaddingY?.Value ?? "3rem";
    var textAlign   = Model.TextAlign?.Value ?? "center";
    var showCard    = Model.ShowInfoCard?.IsTrue ?? true;

    // Google Maps embed URL (sin API key — URL pública)
    var encodedAddress = Uri.EscapeDataString(address);
    var mapTypeParsed  = mapType switch { "satellite" => "&t=k", "hybrid" => "&t=h", "terrain" => "&t=p", _ => "" };
    var embedUrl = string.IsNullOrWhiteSpace(address)
        ? ""
        : $"https://maps.google.com/maps?q={encodedAddress}&z={zoom}{mapTypeParsed}&ie=UTF8&iwloc=&output=embed";

    var hasTitle    = !string.IsNullOrWhiteSpace(Model.Title?.Value);
    var hasSubtitle = !string.IsNullOrWhiteSpace(Model.Subtitle?.Value);
    var hasCard     = showCard && (
        !string.IsNullOrWhiteSpace(Model.PlaceName?.Value) ||
        !string.IsNullOrWhiteSpace(Model.AddressDisplay?.Value) ||
        !string.IsNullOrWhiteSpace(Model.Phone?.Value) ||
        !string.IsNullOrWhiteSpace(Model.Email?.Value) ||
        !string.IsNullOrWhiteSpace(Model.Hours?.Value));
}

<section style="background-color:@bgColor; padding:@padY 1.5rem;">
    <div style="max-width:@maxWidth; margin:0 auto;">

        @* Encabezado *@
        @if (hasTitle || hasSubtitle)
        {
            <div class="mb-8 text-@textAlign">
                @if (hasTitle)
                {
                    <h2 class="text-3xl font-bold mb-2"
                        style="color:@(Model.TitleColor?.Value ?? "#111827")">
                        @Html.Raw(Model.Title!.Value)
                    </h2>
                }
                @if (hasSubtitle)
                {
                    <p class="text-lg"
                       style="color:@(Model.SubtitleColor?.Value ?? "#6b7280")">
                        @Html.Raw(Model.Subtitle!.Value)
                    </p>
                }
            </div>
        }

        @* Contenedor mapa + card *@
        <div class="relative w-full overflow-hidden"
             style="border-radius:@borderRadius; box-shadow:0 8px 40px rgba(0,0,0,0.12);">

            @if (!string.IsNullOrWhiteSpace(embedUrl))
            {
                <iframe src="@embedUrl"
                        width="100%"
                        height="@mapHeight"
                        style="border:none; display:block;"
                        allowfullscreen
                        loading="lazy"
                        referrerpolicy="no-referrer-when-downgrade"
                        title="Mapa de ubicación">
                </iframe>
            }
            else
            {
                <div class="flex items-center justify-center bg-gray-100 text-gray-400 flex-col gap-3"
                     style="height:@mapHeight;">
                    <i class="fas fa-map-marked-alt text-5xl opacity-30"></i>
                    <p class="text-sm font-medium">Introduce una dirección para ver el mapa</p>
                </div>
            }

            @* Info card flotante sobre el mapa *@
            @if (hasCard)
            {
                <div class="absolute top-4 right-4 rounded-2xl shadow-xl p-5 max-w-xs w-full"
                     style="background-color:@(Model.CardBgColor?.Value ?? "#ffffff"); color:@(Model.CardTextColor?.Value ?? "#374151");">

                    @if (!string.IsNullOrWhiteSpace(Model.PlaceName?.Value))
                    {
                        <p class="font-black text-base mb-3 leading-tight">
                            <i class="fas fa-map-marker-alt text-red-500 mr-2"></i>
                            @Model.PlaceName.Value
                        </p>
                    }

                    <div class="space-y-2 text-sm">
                        @if (!string.IsNullOrWhiteSpace(Model.AddressDisplay?.Value))
                        {
                            <div class="flex items-start gap-2">
                                <i class="fas fa-location-dot text-gray-400 mt-0.5 flex-shrink-0 w-4 text-center"></i>
                                <span>@Model.AddressDisplay.Value</span>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.Phone?.Value))
                        {
                            <div class="flex items-center gap-2">
                                <i class="fas fa-phone text-gray-400 flex-shrink-0 w-4 text-center"></i>
                                <a href="tel:@Model.Phone.Value"
                                   class="hover:underline transition">@Model.Phone.Value</a>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.Email?.Value))
                        {
                            <div class="flex items-center gap-2">
                                <i class="fas fa-envelope text-gray-400 flex-shrink-0 w-4 text-center"></i>
                                <a href="mailto:@Model.Email.Value"
                                   class="hover:underline transition">@Model.Email.Value</a>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.Hours?.Value))
                        {
                            <div class="flex items-start gap-2">
                                <i class="fas fa-clock text-gray-400 mt-0.5 flex-shrink-0 w-4 text-center"></i>
                                <span class="whitespace-pre-line">@Model.Hours.Value</span>
                            </div>
                        }
                    </div>

                    @if (!string.IsNullOrWhiteSpace(address))
                    {
                        <a href="https://www.google.com/maps/search/@encodedAddress"
                           target="_blank"
                           rel="noopener"
                           class="mt-4 flex items-center justify-center gap-2 w-full py-2 rounded-xl text-xs font-bold uppercase tracking-wider transition hover:opacity-80"
                           style="background-color:#10b981; color:#ffffff;">
                            <i class="fas fa-directions"></i>
                            Cómo llegar
                        </a>
                    }
                </div>
            }

        </div>

    </div>
</section>
