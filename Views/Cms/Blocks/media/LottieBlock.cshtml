@using BrixCMS.Open.Models.Blocks
@model LottieBlock

@{
    var lottieUrl = Model.LottieUrl?.Value ?? "";
    var width = Model.Width?.Value ?? "300px";
    var height = Model.Height?.Value ?? "300px";
    var autoPlay = Model.AutoPlay?.Value ?? "true";
    var loop = Model.Loop?.Value ?? "true";
    var speed = Model.Speed?.Value ?? "1";
    var bgColor = Model.BackgroundColor?.Value ?? "transparent";
    var borderRadius = Model.BorderRadius?.Value ?? "0";
    var sectionId = Model.SectionId?.Value ?? "";
    var paddingY = Model.PaddingY?.Value ?? "1rem";
}

<section id="@sectionId" class="py-4 flex justify-center" style="padding:@paddingY 0;">
    @if (string.IsNullOrEmpty(lottieUrl))
    {
        <div class="text-center text-gray-400 py-8">
            <p>Configure Lottie JSON URL in block settings</p>
        </div>
    }
    else
    {
        <div class="relative overflow-hidden" style="width:@width;height:@height;background-color:@bgColor;border-radius:@borderRadius;">
            <dotlottie-player
                src="@lottieUrl"
                autoplay="@(autoPlay == "true")"
                loop="@(loop == "true")"
                speed="@speed"
                style="width:100%;height:100%;">
            </dotlottie-player>
        </div>
    }
</section>

<script src="https://unpkg.com/@@dotlottie/player-component@2.0.0/dist/dotlottie-player.js"></script>
