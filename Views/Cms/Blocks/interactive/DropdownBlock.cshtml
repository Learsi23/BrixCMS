@using BrixCMS.Open.Components.BlazorBlocks
@using BrixCMS.Open.Models.Blocks
@model DropdownBlock

@{
    var backgroundColor = Model?.BackgroundColor?.Value ?? "transparent";
    var backgroundGradient = Model?.BackgroundGradient?.Value ?? "";
    var title = Model?.Title?.Value;
    var titleColor = Model?.TitleColor?.Value ?? "black";
    var titleFontSize = Model?.TitleSize?.Value ?? "32px";

    // Si hay gradiente usamos 'background', si no, 'background-color'
    var hasGradient = !string.IsNullOrEmpty(backgroundGradient);
    var finalStyle = hasGradient
        ? $"background: {backgroundGradient};"
        : $"background-color: {backgroundColor};";
}

<div class="py-8 px-4" style="@finalStyle">
    <div class="max-w-[1200px] mx-auto w-full h-auto">
        @if (!string.IsNullOrEmpty(title))
        {
            <h2 class="mb-6 font-bold" style="color: @(titleColor); font-size: @(titleFontSize);">
                @title
            </h2>
        }

        <component type="typeof(DropdownBlazor)" render-mode="ServerPrerendered" param-Block="Model" />
    </div>
</div>
