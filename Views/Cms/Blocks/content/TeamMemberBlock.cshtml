@using BrixCMS.Open.Models.Blocks
@model TeamMemberBlock

<div class="p-4 border border-gray-200 rounded-xl text-center">
    @if (!string.IsNullOrEmpty(Model.Photo?.Value))
    {
        <img src="@Model.Photo.Value" class="w-20 h-20 rounded-full object-cover mx-auto mb-3" alt="@Model.Name?.Value" />
    }
    <p class="font-semibold">@(Model.Name?.Value ?? "")</p>
    <p class="text-sm text-gray-400">@(Model.Role?.Value ?? "")</p>
</div>
