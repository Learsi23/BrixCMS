@model BrixCMS.Open.Data.Fields.TextAreaField

@{
    var fieldName = ViewData.TemplateInfo.HtmlFieldPrefix;
    var rows = Model.Rows > 0 ? Model.Rows : 4;
    var maxLength = Model.MaxLength > 0 ? Model.MaxLength : 2000;
    var value = Model.Value ?? "";
}

<div class="form-group mb-3">
    @if (!string.IsNullOrEmpty(ViewData["Label"]?.ToString()))
    {
        <label class="form-label fw-bold small text-uppercase text-muted">@ViewData["Label"]</label>
    }

    <textarea class="form-control shadow-sm"
              id="@fieldName"
              name="@fieldName"
              rows="@rows"
              maxlength="@maxLength"
              placeholder="@ViewData["Placeholder"]"
              style="resize: vertical; border-radius: 8px;">@value</textarea>

    <div class="d-flex justify-content-between mt-1">
        <small class="text-muted" style="font-size: 10px;">Máximo @maxLength caracteres</small>
        <small class="text-muted current-count" style="font-size: 10px;"></small>
    </div>
</div>
