@using BrixCMS.Open.Components.BlazorBlocks
@using BrixCMS.Open.Models.BlazorBlocks
@model StartHeroBlock

@{
    // CORRECCIÓN: BoolField tiene propiedad .Value
    bool fNext = Model.FirstImageNextToText == true;
    bool sNext = Model.SecondImageNextToText == true;
}

<div class="w-full">
    <component type="typeof(StartHeroBlazor)"
               render-mode="ServerPrerendered"
               param-LeftIcon="@(Model.LeftIcon?.Value ?? "")"
               param-LeftIconSize="@(Model.LeftIconSize?.Value ?? "")"
               param-LeftIconClass="@(Model.LeftIconClass?.Value ?? "")"
               param-LeftIconColor="@(Model.LeftIconColor?.Value ?? "")"
               param-LeftIconFaSize="@(Model.LeftIconFaSize?.Value ?? "")"
               param-RightIcon="@(Model.RightIcon?.Value ?? "")"
               param-RightIconSize="@(Model.RightIconSize?.Value ?? "")"
               param-RightIconClass="@(Model.RightIconClass?.Value ?? "")"
               param-RightIconColor="@(Model.RightIconColor?.Value ?? "")"
               param-TitleSida="@(Model.TitleSida?.Value ?? "")"
               param-TitleSidaColor="@(Model.TitleSidaColor?.Value ?? "")"
               param-TitleSidaSize="@(Model.TitleSidaSize?.Value ?? "")"
               param-TitleSidaWeight="@(Model.TitleSidaWeight?.Value ?? "")"
               param-TitleSidaAlignment="@(Model.TitleSidaAlignment?.Value ?? "")"
               param-Title="@(Model.Title?.Value ?? "")"
               param-TitleColor="@(Model.TitleColor?.Value ?? "")"
               param-TitleSize="@(Model.TitleSize?.Value ?? "")"
               param-TitleWeight="@(Model.TitleWeight?.Value ?? "")"
               param-TitleAlignment="@(Model.TitleAlignment?.Value ?? "")"
               param-Text="@(Model.Text?.Value ?? "")"
               param-TextColor="@(Model.TextColor?.Value ?? "")"
               param-TextSize="@(Model.TextSize?.Value ?? "")"
               param-TextWeight="@(Model.TextWeight?.Value ?? "")"
               param-TextAlignment="@(Model.TextAlignment?.Value ?? "")"
               param-SubTitle="@(Model.SubTitle?.Value ?? "")"
               param-SubTitleColor="@(Model.SubTitleColor?.Value ?? "")"
               param-SubTitleSize="@(Model.SubTitleSize?.Value ?? "")"
               param-SubTitletWeight="@(Model.SubTitletWeight?.Value ?? "")"
               param-SubTitleAlignment="@(Model.SubTitleAlignment?.Value ?? "")"
               param-BackgroundColor="@(Model.BackgroundColor?.Value ?? "")"
               param-BackgroundImage="@(Model.BackgroundImage?.Value ?? "")"
               param-BackgroundOpacity="@(Model.BackgroundOpacity?.Value.ToString() ?? "")"
               param-BackgroundBlur="@(Model.BackgroundBlur?.Value.ToString() ?? "")"
               param-Border="@(Model.Border?.Value ?? "")"
               param-BorderRadius="@(Model.BorderRadius?.Value ?? "")"
               param-FirstImage="@(Model.FirstImage?.Value ?? "")"
               param-FirstImageSize="@(Model.FirstImageSize?.Value ?? "")"
               param-FirstImageOffsetTop="@(Model.FirstImageOffsetTop?.Value ?? "")"
               param-FirstImageOffsetBottom="@(Model.FirstImageOffsetBottom?.Value ?? "")"
               param-FirstImageOffsetLeft="@(Model.FirstImageOffsetLeft?.Value ?? "")"
               param-FirstImageOffsetRight="@(Model.FirstImageOffsetRight?.Value ?? "")"
               param-FirstImageLayer="@(Model.FirstImageLayer?.Value ?? "")"
               param-FirstImageNextToText="@fNext"
               param-SecondImage="@(Model.SecondImage?.Value ?? "")"
               param-SecondImageSize="@(Model.SecondImageSize?.Value ?? "")"
               param-SecondImageOffsetTop="@(Model.SecondImageOffsetTop?.Value ?? "")"
               param-SecondImageOffsetBottom="@(Model.SecondImageOffsetBottom?.Value ?? "")"
               param-SecondImageOffsetLeft="@(Model.SecondImageOffsetLeft?.Value ?? "")"
               param-SecondImageOffsetRight="@(Model.SecondImageOffsetRight?.Value ?? "")"
               param-SecondImageLayer="@(Model.SecondImageLayer?.Value ?? "")"
               param-SecondImageNextToText="@sNext" />
</div>
