                </p>
            </div>
            @foreach (var (col, links) in new[] {
                ("Produkt",  new[]{ "Funktioner","Prissättning","Custom Blocks","Changelog" }),
                ("Resurser", new[]{ "Dokumentation","Video Guides","API Reference","Community" }),
                ("Företag",  new[]{ "Om oss","Kontakt","Integritetspolicy","Användarvillkor" }),
            })
            {
                <div>
