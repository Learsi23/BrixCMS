                    <ul class="space-y-2.5">
                        @foreach (var link in links)
                        {
                            <li><a href="#" class="text-sm transition-colors" style="color:#56566A" onmouseover="this.style.color='#F0F0F5'" onmouseout="this.style.color='#56566A'">@link</a></li>
                        }
                    </ul>
                </div>
            }
        </div>
        <div class="flex flex-col sm:flex-row items-center justify-between gap-3 pt-6" style="border-top:1px solid #2A2A30">
            <p class="text-xs" style="color:#56566A">© 2026 BrixCMS. Alla rättigheter förbehållna. Priser exkl. moms.</p>
            <p class="text-xs" style="color:#56566A">Byggt med ♥ i Sverige</p>
        </div>
    </div>
</footer>
