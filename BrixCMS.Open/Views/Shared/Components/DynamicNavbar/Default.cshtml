@model BrixCMS.Open.Models.NavbarSettings
@using BrixCMS.Open.Data
@using BrixCMS.Open.Extensions

@{
    var logoUrl   = Model.Logo?.TrimStart('~');
    var menuItems = Model.MenuItems ?? new List<MenuItemConfig>();
    var navId     = "mobile-nav-" + Guid.NewGuid().ToString("N")[..8];

    var db = ViewContext.HttpContext.RequestServices.GetService<BrixDbContext>();
    var allPages = db?.Pages.Where(x => x.IsPublished).OrderBy(x => x.SortOrder).ToList() ?? new List<Page>();
    var allPagesById = allPages.ToDictionary(p => p.Id);
    var childrenByParentId = allPages
        .Where(p => p.ParentId.HasValue)
        .GroupBy(p => p.ParentId!.Value)
        .ToDictionary(g => g.Key, g => g.ToList());
    var topLevel = allPages.Where(p => !p.ParentId.HasValue).ToList();

    var handledSlugs = new System.Collections.Generic.HashSet<string>();
    foreach (var item in menuItems)
    {
        if (!string.IsNullOrEmpty(item.PageSlug))
        {
            handledSlugs.Add(item.PageSlug.ToLowerInvariant());
        }
        else if (!string.IsNullOrEmpty(item.CustomUrl))
        {
            var slugFromUrl = item.CustomUrl.TrimStart('/').Split('/')[0].Split('?')[0].Split('#')[0];
            if (!string.IsNullOrEmpty(slugFromUrl))
                handledSlugs.Add(slugFromUrl.ToLowerInvariant());
        }
    }
}

<nav class="@Model.PaddingVertical @(Model.IsSticky ? "sticky top-0 z-50" : "") @(Model.HasShadow ? "shadow-md" : "")" style="background-color: @Model.BackgroundColor;">
    <div class="container mx-auto px-4 flex items-center justify-between">

        @* ── Logo ── *@
        @if (!string.IsNullOrEmpty(logoUrl))
        {
            <a href="@(Model.LogoLink ?? "/")" data-enhance-nav="false" class="flex items-center flex-shrink-0">
                <img src="@logoUrl" alt="@(Model.LogoAltText ?? "Logo")"
                     style="width: @(Model.LogoWidth ?? "150px"); height: auto;" />
            </a>
        }

        @* ── Desktop menu ── *@
        <div class="hidden md:flex items-center gap-4">
            @if (menuItems.Count > 0)
            {
                @foreach (var item in menuItems)
                {
                    var url    = !string.IsNullOrEmpty(item.CustomUrl) ? item.CustomUrl
                               : !string.IsNullOrEmpty(item.PageSlug)  ? "/" + item.PageSlug
                               : "#";
                    var text   = !string.IsNullOrEmpty(item.CustomText) ? item.CustomText : "Link";
                    var target = item.OpenInNewTab ? "_blank" : "_self";
                    var rel    = item.OpenInNewTab ? "noopener noreferrer" : "";
                    @if (!string.IsNullOrEmpty(item.IconClass))
                    {
                        <a href="@url" target="@target" rel="@rel" data-enhance-nav="false"
                           aria-label="@(item.IconAriaLabel ?? item.IconClass)"
                           class="hover:opacity-75 transition-opacity" style="color: @Model.TextColor;">
                            <i class="@item.IconClass text-xl"></i>
                        </a>
                    }
                    else
                    {
                        <a href="@url" target="@target" rel="@rel" data-enhance-nav="false"
                           class="hover:opacity-75 transition-opacity" style="color: @Model.TextColor;">
                            @text
                        </a>
                    }
                }
                @foreach (var p in topLevel)
                {
                    if (handledSlugs.Contains((p.Slug ?? "").ToLowerInvariant())) { continue; }
                    var hasChildren = childrenByParentId.ContainsKey(p.Id);
                    var path = p.GetFullPath(allPagesById);
                    <div class="relative group">
                        <a href="@path" data-enhance-nav="false"
                           class="hover:opacity-75 transition-opacity inline-flex items-center gap-1"
                           style="color: @Model.TextColor;">
                            @p.Title
                            @if (hasChildren)
                            {
                                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                                </svg>
                            }
                        </a>
                        @if (hasChildren)
                        {
                            <div class="absolute top-full left-0 mt-1 bg-white shadow-lg rounded-lg border border-gray-200 py-2 min-w-[180px] opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50">
                                @foreach (var child in childrenByParentId[p.Id])
                                {
                                    <a href="@child.GetFullPath(allPagesById)" data-enhance-nav="false"
                                       class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-50 hover:text-gray-900 transition-colors">
                                        @child.Title
                                    </a>
                                }
                            </div>
                        }
                    </div>
                }
            }
            else
            {
                @foreach (var p in topLevel)
                {
                    var hasChildren = childrenByParentId.ContainsKey(p.Id);
                    var path = p.GetFullPath(allPagesById);
                    <div class="relative group">
                        <a href="@path" data-enhance-nav="false"
                           class="hover:opacity-75 transition-opacity inline-flex items-center gap-1"
                           style="color: @Model.TextColor;">
                            @p.Title
                            @if (hasChildren)
                            {
                                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                                </svg>
                            }
                        </a>
                        @if (hasChildren)
                        {
                            <div class="absolute top-full left-0 mt-1 bg-white shadow-lg rounded-lg border border-gray-200 py-2 min-w-[180px] opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50">
                                @foreach (var child in childrenByParentId[p.Id])
                                {
                                    <a href="@child.GetFullPath(allPagesById)" data-enhance-nav="false"
                                       class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-50 hover:text-gray-900 transition-colors">
                                        @child.Title
                                    </a>
                                }
                            </div>
                        }
                    </div>
                }
            }
        </div>

        @* ── Hamburger (mobile only) ── *@
        <button onclick="(function(){var m=document.getElementById('@navId');m.classList.toggle('hidden');})()"
                aria-label="Toggle menu"
                class="md:hidden p-2 rounded-lg hover:opacity-75 transition-opacity"
                style="color: @Model.TextColor;">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
        </button>

    </div>

    @* ── Mobile menu (hidden by default) ── *@
    <div id="@navId" class="hidden md:hidden border-t" style="border-color: @Model.TextColor + '22';">
        <div class="container mx-auto px-4 py-3 flex flex-col gap-1">
            @if (menuItems.Count > 0)
            {
                @foreach (var item in menuItems)
                {
                    var url    = !string.IsNullOrEmpty(item.CustomUrl) ? item.CustomUrl
                               : !string.IsNullOrEmpty(item.PageSlug)  ? "/" + item.PageSlug
                               : "#";
                    var text   = !string.IsNullOrEmpty(item.CustomText) ? item.CustomText : "Link";
                    var target = item.OpenInNewTab ? "_blank" : "_self";
                    var rel    = item.OpenInNewTab ? "noopener noreferrer" : "";
                    @if (!string.IsNullOrEmpty(item.IconClass))
                    {
                        <a href="@url" target="@target" rel="@rel" data-enhance-nav="false"
                           aria-label="@(item.IconAriaLabel ?? item.IconClass)"
                           class="block py-2 px-2 rounded hover:opacity-75 transition-opacity"
                           style="color: @Model.TextColor;">
                            <i class="@item.IconClass text-xl"></i>
                        </a>
                    }
                    else
                    {
                        <a href="@url" target="@target" rel="@rel" data-enhance-nav="false"
                           class="block py-2 px-2 rounded hover:opacity-75 transition-opacity"
                           style="color: @Model.TextColor;">
                            @text
                        </a>
                    }
                }
                @foreach (var p in topLevel)
                {
                    if (handledSlugs.Contains((p.Slug ?? "").ToLowerInvariant())) { continue; }
                    <a href="@p.GetFullPath(allPagesById)" data-enhance-nav="false"
                       class="block py-2 px-2 rounded hover:opacity-75 transition-opacity"
                       style="color: @Model.TextColor;">
                        @p.Title
                    </a>
                }
            }
            else
            {
                @foreach (var p in allPages)
                {
                    <a href="@p.GetFullPath(allPagesById)" data-enhance-nav="false"
                       class="block py-2 px-2 rounded hover:opacity-75 transition-opacity"
                       style="color: @Model.TextColor;">
                        @p.Title
                    </a>
                }
            }
        </div>
    </div>
</nav>
