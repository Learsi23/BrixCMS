@using BrixCMS.Open.Components.BlazorBlocks
@using BrixCMS.Open.Data
@inject BrixDbContext _db
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery _antiforgery
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>BrixCMS - @ViewData["Title"]</title>

  
    <link rel="icon" type="image/png" href="~/favicon.png" />
    @if (!string.IsNullOrEmpty(ViewData["MetaDescription"] as string))
    {
        <meta name="description" content="@ViewData["MetaDescription"]" />
        <meta property="og:description" content="@ViewData["MetaDescription"]" />
        <meta name="twitter:description" content="@ViewData["MetaDescription"]" />
    }
    @{
        var ogTitle = ViewData["OgTitle"] as string ?? ViewData["Title"] as string ?? "BrixCMS";
        var ogImage = ViewData["OgImage"] as string ?? "";
        var ogUrl   = $"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.Path}";
    }
    <meta property="og:title" content="@ogTitle" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="@ogUrl" />
    @if (!string.IsNullOrEmpty(ogImage))
    {
        <meta property="og:image" content="@ogImage" />
        <meta name="twitter:image" content="@ogImage" />
    }
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@ogTitle" />
    <link rel="canonical" href="@ogUrl" />
    <meta name="generator" content="BrixCMS" />
    <meta name="csrf-token" content="@_antiforgery.GetAndStoreTokens(Context).RequestToken" />
    <link rel="icon" type="image/png" href="~/favicon.png" />

    <script src="https://cdn.tailwindcss.com"></script>
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <script defer src="~/js/cookieBanner.js"></script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        [x-cloak] {
            display: none !important;
        }</style>
</head>
<body class="min-h-screen flex flex-col bg-gray-50">

    @* NAVEGACI�N DIN�MICA GLOBAL *@
    @await Component.InvokeAsync("DynamicNavbar")

        <div class="flex-1">
            <main role="main">
                @RenderBody()
            </main>
            
        </div>
    @* FOOTER DIN�MICO GLOBAL *@
    @await Component.InvokeAsync("DynamicFooter")

    <script src="~/js/Script.js?v=@DateTime.UtcNow.Ticks"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        // CSRF helper � reads token from meta tag set by IAntiforgery
        function csrfHeaders() {
            var token = document.querySelector('meta[name="csrf-token"]')?.content ?? '';
            return { 'Content-Type': 'application/json', 'X-CSRF-TOKEN': token };
        }

        // Get or create cart session key (persisted in localStorage across page loads)
        var cartSessionKey = localStorage.getItem('brixCartSessionKey');
        if (!cartSessionKey) {
            cartSessionKey = 'brix_' + Date.now() + '_' + Math.random().toString(36).slice(2);
            localStorage.setItem('brixCartSessionKey', cartSessionKey);
        }
        
        // Helper function to get cart count
        function updateCartCount() {
            fetch('/Cart/GetCartCount?sessionKey=' + encodeURIComponent(cartSessionKey))
                .then(r => r.json())
                .then(data => {
                    var cartCount = document.getElementById('cart-count');
                    if (cartCount) {
                        cartCount.innerText = data.totalProducts || 0;
                        console.log('Cart count updated: ' + data.totalProducts);
                    }
                })
                .catch(function(e) { 
                    console.log('Error getting cart count: ' + e); 
                });
        }
        
        updateCartCount();
    </script>
    @* ? Blazor al final *@
    <script src="_framework/blazor.web.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
