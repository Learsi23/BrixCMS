@using BrixCMS.Open.Models.Blocks
@model NewsletterBlock

@{
    var bg       = Model.BackgroundColor?.Value ?? "#f9fafb";
    var btnColor = Model.ButtonColor?.Value ?? "#111827";
    var btnTxt   = Model.ButtonTextColor?.Value ?? "#ffffff";
    var success  = Model.SuccessMessage?.Value ?? "Thanks for subscribing!";
    var btnLabel = Model.ButtonLabel?.Value ?? "Subscribe";
    var uid      = "nl-" + Guid.NewGuid().ToString()[..8];
}

<section class="w-full py-14 px-4" style="background-color:@bg;">
    <div class="max-w-xl mx-auto text-center"
         x-data="newsletterForm('@uid', '@Html.Raw(success.Replace("'", "\\'"))')"
         id="@uid">

        @if (!string.IsNullOrEmpty(Model.Heading?.Value))
        {
            <h2 class="text-2xl font-bold text-gray-900 mb-2">@Model.Heading.Value</h2>
        }
        @if (!string.IsNullOrEmpty(Model.Subtitle?.Value))
        {
            <p class="text-gray-500 mb-6">@Model.Subtitle.Value</p>
        }

        <form @@submit.prevent="submit" class="flex flex-col sm:flex-row gap-3 justify-center">
            <input type="email"
                   x-model="email"
                   required
                   placeholder="your@email.com"
                   class="flex-1 px-4 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-gray-800" />
            <button type="submit"
                    :disabled="loading"
                    class="px-6 py-2.5 rounded-lg text-sm font-semibold transition disabled:opacity-50"
                    style="background-color:@btnColor; color:@btnTxt;">
                <span x-show="!loading">@btnLabel</span>
                <span x-show="loading" x-cloak>...</span>
            </button>
        </form>

        <p x-show="successMsg" x-cloak class="mt-4 text-green-600 font-medium" x-text="successMsg"></p>
        <p x-show="errorMsg"   x-cloak class="mt-4 text-red-500 text-sm"       x-text="errorMsg"></p>
    </div>
</section>

<script>
document.addEventListener('alpine:init', () => {
    Alpine.data('newsletterForm', (uid, successText) => ({
        email: '',
        loading: false,
        successMsg: '',
        errorMsg: '',
        async submit() {
            this.loading = true;
            this.errorMsg = '';
            this.successMsg = '';
            try {
                const res = await fetch('/api/newsletter/subscribe', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ email: this.email })
                });
                if (res.ok) {
                    this.successMsg = successText;
                    this.email = '';
                } else {
                    const data = await res.json().catch(() => ({}));
                    this.errorMsg = data.error || 'Something went wrong. Please try again.';
                }
            } catch {
                this.errorMsg = 'Network error. Please try again.';
            } finally {
                this.loading = false;
            }
        }
    }));
});
</script>
