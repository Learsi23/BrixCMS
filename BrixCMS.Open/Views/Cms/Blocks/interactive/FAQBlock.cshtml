@using BrixCMS.Open.Models.Blocks
@using BrixCMS.Open.Services
@using System.Text.Json
@model FAQBlock
@inject BrixCMS.Open.Data.BrixDbContext Db

@{
    var blockData = (BrixCMS.Open.Data.Block)ViewData["RawBlock"];
    var childBlocks = Db.Blocks
        .Where(b => b.ParentId == blockData.Id)
        .OrderBy(b => b.SortOrder)
        .ToList();
    
    var style = Model.Style?.Value ?? "cards";
    var bgColor = Model.BackgroundColor?.Value ?? "transparent";
    var paddingY = Model.PaddingY?.Value ?? "3rem";
    var title = Model.Title?.Value ?? "";
    var titleColor = Model.TitleColor?.Value ?? "#000000";
    var titleAlign = Model.TitleAlign?.Value ?? "center";
    var description = Model.Description?.Value ?? "";
    var descriptionColor = Model.DescriptionColor?.Value ?? "#666666";
    var questionColor = Model.QuestionColor?.Value ?? "#000000";
    var questionWeight = Model.QuestionWeight?.Value ?? "600";
    var answerColor = Model.AnswerColor?.Value ?? "#555555";
    var iconColor = Model.IconColor?.Value ?? "#5B6EF5";
    var borderColor = Model.BorderColor?.Value ?? "#e5e7eb";
    var sectionId = Model.SectionId?.Value ?? "";
    var columns = Model.Columns?.Value ?? "1";
    
    var gridClass = columns == "2" ? "grid grid-cols-1 md:grid-cols-2 gap-6" : "space-y-4";
    
    // Extract "Question" from AccordionItemBlock JsonData: {"Question":{"Value":"..."},"Answer":{"Value":"..."}}
    string ExtractQuestion(string? json)
    {
        if (string.IsNullOrEmpty(json)) return "";
        try {
            var d = JsonSerializer.Deserialize<Dictionary<string, JsonElement>>(json);
            if (d != null && d.TryGetValue("Question", out var qEl)) {
                if (qEl.ValueKind == JsonValueKind.Object && qEl.TryGetProperty("Value", out var qv))
                    return qv.GetString() ?? "";
                return qEl.GetString() ?? "";
            }
        } catch { }
        return "";
    }
}

<section id="@sectionId" style="background-color:@bgColor; padding:@paddingY 0;">
    <div class="mx-auto" style="max-width:1200px; padding:0 1rem;">
        
        @if (!string.IsNullOrEmpty(title))
        {
            <h2 class="font-bold mb-4" style="color:@titleColor; text-align:@titleAlign; font-size:2rem;">
                @Html.Raw(title)
            </h2>
        }
        
        @if (!string.IsNullOrEmpty(description))
        {
            <p class="mb-8" style="color:@descriptionColor; text-align:@titleAlign;">
                @Html.Raw(description)
            </p>
        }
        
        <div class="@gridClass">
            @if (childBlocks.Any())
            {
                foreach (var item in childBlocks)
                {
                    var itemDataStr = item.JsonData ?? "{}";
                    var question = ExtractQuestion(itemDataStr);
                    var answer   = "";

                    try {
                        var itemData = JsonSerializer.Deserialize<Dictionary<string, JsonElement>>(itemDataStr);
                        if (itemData != null && itemData.TryGetValue("Answer", out var ansEl)) {
                            if (ansEl.ValueKind == JsonValueKind.Object && ansEl.TryGetProperty("Value", out var v))
                                answer = v.GetString() ?? "";
                            else
                                answer = ansEl.GetString() ?? "";
                        }
                    } catch {}
                    
                    <div class="faq-item @(style == "cards" ? "bg-white rounded-lg shadow-sm p-4" : style == "bordered" ? "border-b" : "py-4")"
                         style="@(style == "bordered" ? $"border-bottom:1px solid {borderColor};" : "")"
                         data-question="@question">
                        <button onclick="this.nextElementSibling.classList.toggle('hidden'); var icon=this.querySelector('.faq-icon'); icon.textContent=icon.textContent==='+' ? '−' : '+';"
                                class="w-full flex justify-between items-center text-left focus:outline-none">
                            <span class="font-medium" style="color:@questionColor; font-weight:@questionWeight;">
                                @question
                            </span>
                            <span class="ml-4 flex-shrink-0 transition-transform faq-icon" style="color:@iconColor;">
                                +
                            </span>
                        </button>
                        <div class="hidden mt-3 pt-3" style="@(style == "bordered" ? $"border-top:1px solid {borderColor};" : "")">
                            <p style="color:@answerColor;">
                                @answer
                            </p>
                        </div>
                    </div>
                }
            }
            else
            {
                <p style="color:#94a3b8; text-align:center; padding:2rem;">
                    Add FAQ Item blocks inside this FAQ block
                </p>
            }
        </div>
    </div>
</section>
