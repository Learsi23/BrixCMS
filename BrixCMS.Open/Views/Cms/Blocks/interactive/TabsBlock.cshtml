@using BrixCMS.Open.Services
@using BrixCMS.Open.Models.Blocks
@model TabsBlock
@inject BrixCMS.Open.Data.BrixDbContext Db
@inject BlockRegistry Registry

@{
    var blockData = (BrixCMS.Open.Data.Block)ViewData["RawBlock"];
    var allBlocks = ViewData["AllBlocks"] as List<BrixCMS.Open.Data.Block>;
    var children  = allBlocks != null
        ? allBlocks.Where(b => b.ParentId == blockData.Id).OrderBy(b => b.SortOrder).ToList()
        : Db.Blocks.Where(b => b.ParentId == blockData.Id).OrderBy(b => b.SortOrder).ToList();

    var bg           = Model.BackgroundColor?.Value;
    var activeColor  = Model.TabActiveColor?.Value ?? "#3b82f6";
    var activeText   = Model.TabActiveTextColor?.Value ?? "#ffffff";
    var inactiveText = Model.TabInactiveTextColor?.Value ?? "#6b7280";
    var tabsId       = "tabs-" + blockData.Id.ToString()[..8];
}

<section style="@(string.IsNullOrWhiteSpace(bg)||bg=="transparent"?"":$"background-color:{bg};")"
         class="py-10 px-4">
    <div class="max-w-4xl mx-auto">
        @if (!children.Any())
        {
            <div class="text-center text-gray-400 py-10 border-2 border-dashed border-gray-200 rounded-xl">
                Añade pestañas con "+ Add tab"
            </div>
        }
        else
        {
            <div id="@tabsId" x-data="{ activeTab: 0 }">
                @* Tab bar *@
                <div class="flex flex-wrap border-b border-gray-200 mb-6 gap-1">
                    @{int ti=0; foreach(var child in children){
                        var tabItem = Registry.CreateModel(child) as TabItemBlock;
                        if(tabItem==null){ti++;continue;}
                        var tabIdx = ti;
                        <button type="button"
                                @@click="activeTab=@tabIdx"
                                class="flex items-center gap-2 px-5 py-2.5 text-sm font-medium rounded-t-lg transition-all border-b-2"
                                :style="activeTab===@tabIdx
                                    ? 'background-color:@activeColor; color:@activeText; border-color:@activeColor;'
                                    : 'color:@inactiveText; border-color:transparent; background:transparent;'">
                            @if(!string.IsNullOrWhiteSpace(tabItem.TabIcon?.Value)){
                                <i class="@tabItem.TabIcon.Value text-xs"></i>
                            }
                            @(tabItem.TabLabel?.Value ?? $"Tab {ti+1}")
                        </button>
                    ti++;}}
                </div>

                @* Tab panels *@
                @{int pi=0; foreach(var child in children){
                    var tabItem = Registry.CreateModel(child) as TabItemBlock;
                    if(tabItem==null){pi++;continue;}
                    var panelIdx = pi;
                    <div x-show="activeTab===@panelIdx" x-cloak class="prose max-w-none text-gray-700">
                        @Html.Raw(tabItem.Content?.Value ?? "")
                    </div>
                pi++;}}
            </div>
        }

        @if (ViewContext.HttpContext.Request.Path.ToString().Contains("/edit"))
        {
            <div class="mt-4 text-center">
                <button type="button" onclick="openSelectorForParent('@blockData.Id')"
                        class="bg-sky-500 hover:bg-sky-600 text-white px-4 py-2 rounded-lg text-xs font-bold transition-colors">
                    + Add tab
                </button>
            </div>
        }
    </div>
</section>
