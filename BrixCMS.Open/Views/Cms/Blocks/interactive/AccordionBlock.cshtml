@using BrixCMS.Open.Services
@using BrixCMS.Open.Models.Blocks
@model AccordionBlock
@inject BrixCMS.Open.Data.BrixDbContext Db
@inject BlockRegistry Registry

@{
    var blockData   = (BrixCMS.Open.Data.Block)ViewData["RawBlock"];
    var allBlocks   = ViewData["AllBlocks"] as List<BrixCMS.Open.Data.Block>;
    var children    = allBlocks != null
        ? allBlocks.Where(b => b.ParentId == blockData.Id).OrderBy(b => b.SortOrder).ToList()
        : Db.Blocks.Where(b => b.ParentId == blockData.Id).OrderBy(b => b.SortOrder).ToList();

    var bgColor     = Model.BackgroundColor?.Value;
    var activeColor = Model.ActiveColor?.Value ?? "#3b82f6";
    var allowMulti  = Model.AllowMultiple?.IsTrue ?? false;
    var accId       = "acc-" + blockData.Id.ToString()[..8];
}

<section style="@(string.IsNullOrWhiteSpace(bgColor) || bgColor=="transparent" ? "" : $"background-color:{bgColor};")"
         class="py-10 px-4">
    <div class="max-w-3xl mx-auto">

        @if (!string.IsNullOrWhiteSpace(Model.Title?.Value))
        {
            <h2 class="text-3xl font-bold mb-8 text-center"
                style="color:@(Model.TitleColor?.Value ?? "inherit")">
                @Model.Title.Value
            </h2>
        }

        <div x-data="{ open: @(allowMulti ? "[]" : "null") }" class="space-y-3" id="@accId">
            @{
                int idx = 0;
                foreach (var child in children)
                {
                    var item = Registry.CreateModel(child) as AccordionItemBlock;
                    if (item == null) { idx++; continue; }
                    var itemIdx = idx;
                    <div class="border border-gray-200 rounded-xl overflow-hidden shadow-sm"
                         x-data="{ id: @itemIdx }">
                        @if (allowMulti)
                        {
                        <button type="button"
                                class="w-full flex justify-between items-center px-5 py-4 text-left font-semibold text-gray-800 hover:bg-gray-50 transition-colors"
                                @@click="open.includes(id) ? open = open.filter(i => i !== id) : open.push(id)"
                                style="color:inherit;">
                            <span>@(item.Question?.Value ?? "")</span>
                            <svg class="w-5 h-5 flex-shrink-0 transition-transform duration-300"
                                 :class="open.includes(id) ? 'rotate-45' : 'rotate-0'"
                                 fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                            </svg>
                        </button>
                        <div x-show="open.includes(id)"
                             x-cloak
                             class="px-5 py-4 text-gray-600 border-t border-gray-100"
                             style="border-left: 3px solid @activeColor;">
                            @Html.Raw(item.Answer?.Value ?? "")
                        </div>
                        }
                        else
                        {
                        <button type="button"
                                class="w-full flex justify-between items-center px-5 py-4 text-left font-semibold text-gray-800 hover:bg-gray-50 transition-colors"
                                @@click="open === id ? open = null : open = id"
                                style="color:inherit;">
                            <span>@(item.Question?.Value ?? "")</span>
                            <svg class="w-5 h-5 flex-shrink-0 transition-transform duration-300"
                                 :class="open === id ? 'rotate-45' : 'rotate-0'"
                                 fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                            </svg>
                        </button>
                        <div x-show="open === id"
                             x-cloak
                             class="px-5 py-4 text-gray-600 border-t border-gray-100"
                             style="border-left: 3px solid @activeColor;">
                            @Html.Raw(item.Answer?.Value ?? "")
                        </div>
                        }
                    </div>
                    idx++;
                }
            }

            @if (!children.Any())
            {
                <div class="text-center text-gray-400 py-8 border-2 border-dashed border-gray-200 rounded-xl">
                    Añade preguntas con "+ Add item"
                </div>
            }
        </div>

        @if (ViewContext.HttpContext.Request.Path.ToString().Contains("/edit", StringComparison.OrdinalIgnoreCase))
        {
            <div class="mt-4 text-center">
                <button type="button" onclick="openSelectorForParent('@blockData.Id')"
                        class="bg-blue-500 hover:bg-blue-600 text-white px-4 py-2 rounded-lg text-xs font-bold transition-colors">
                    + Add accordion item
                </button>
            </div>
        }
    </div>
</section>
