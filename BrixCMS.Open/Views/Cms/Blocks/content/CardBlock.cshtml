@using BrixCMS.Open.Models.Blocks
@model CardBlock

@{
    var __blockId = ViewData["IsPreview"] is true ? (ViewData["RawBlock"] as BrixCMS.Open.Data.Block)?.Id : null;
    var layout = Model.LayoutType?.Value?.ToLower() ?? "vertical";
    var isHorizontal = layout == "horizontal";
    var isOverlay = layout == "overlay";
    var accent = Model.AccentColor?.Value ?? "#3b82f6";
    var hover = Model.HoverColor?.Value ?? accent;
    var btnTextColor = Model.ButtonTextColor?.Value ?? "#ffffff";
    var btnRadius = Model.BorderRadius?.Value ?? "0.5rem";
    var btnBorder = Model.Border?.Value ?? "none";
    var btnPadding = Model.Padding?.Value ?? "0.625rem 1.5rem";
    var imageUrl = !string.IsNullOrEmpty(Model.Image?.Value) ? Model.Image.Value : "/images/no-image.png";
    var targetUrl = Model.TargetUrl?.Value ?? "#";
    var textAlign = Model.TextAlign?.Value?.ToLower() ?? "center";
    if (textAlign != "left" && textAlign != "right") { textAlign = "center"; }
    var subtitle = Model.Subtitle?.Value;
    var subtitleColor = Model.SubtitleColor?.Value ?? "#6b7280";

    var raw = ViewData["RawJson"] as Dictionary<string, System.Text.Json.JsonElement> ?? new();
    string ImgExtra(string field, string prop, string def = "")
    {
        if (raw.TryGetValue(field, out var el) && el.ValueKind == System.Text.Json.JsonValueKind.Object &&
            el.TryGetProperty(prop, out var v))
            return v.GetString() ?? def;
        return def;
    }
    var imgW = ImgExtra("Image", "Width", "");
    var imgH = ImgExtra("Image", "Height", "200");
    var imgFit = ImgExtra("Image", "ObjectFit", "cover");
}

<div class="card shadow-md transition-all hover:shadow-xl hover:-translate-y-1"
     style="background-color:@(isOverlay ? "transparent" : Model.CardBgColor?.Value ?? "#ffffff");
            background-image:@(isOverlay ? $"url('{imageUrl}')" : "none");
            background-size:cover;
            background-position:center;
            border-radius:12px;
            padding:0;
            max-width:@(isHorizontal ? "560px" : "320px");
            margin:0 auto;
            display:flex;
            flex-direction:@(isHorizontal ? "row" : "column");
            overflow:hidden;
            position:relative;
            border:1px solid #f0f0f0;">

    <a href="@targetUrl" class="block" style="text-decoration:none; color:inherit; @(isHorizontal ? "display:flex; flex:1;" : "")">
        @if (!isOverlay)
        {
            @* Imagen destacada *@
            <div style="overflow:hidden; @(isHorizontal ? "flex:0 0 40%;" : "")">
                <img src="@imageUrl"
                     alt="@Model.Title?.Value"
                     style="width:100%; height:@(isHorizontal ? "100%" : imgH + "px"); object-fit:@imgFit; transition:transform 0.3s;"
                     class="hover:scale-105" />
            </div>
        }
        else
        {
            @* Overlay layout: image is the card background (set above); dark scrim for text legibility *@
            <div style="position:absolute; inset:0; background:linear-gradient(to top, rgba(0,0,0,0.75), rgba(0,0,0,0.15));"></div>
        }

        @* Contenido *@
        <div style="padding:1rem 1rem 0.75rem 1rem; text-align:@textAlign; position:relative; @(isHorizontal ? "flex:1;" : "")">
            @if (!string.IsNullOrEmpty(Model.Badge?.Value))
            {
                <span style="display:inline-block; background-color:@accent; color:white; font-size:0.7rem;
                             padding:0.2rem 0.6rem; border-radius:20px; margin-bottom:0.5rem;">
                    @Model.Badge.Value
                </span>
            }

            <h3 data-editable-field="Title" data-block-id="@__blockId" style="font-size:1.1rem; font-weight:bold; margin:0.5rem 0; color:@(isOverlay ? "#ffffff" : "#1f2937");">
                @(Model.Title?.Value ?? "Nuevo Producto")
            </h3>

            @if (!string.IsNullOrEmpty(subtitle))
            {
                <p data-editable-field="Subtitle" data-block-id="@__blockId" style="font-size:0.9rem; color:@(isOverlay ? "#e5e7eb" : subtitleColor); margin:0 0 0.5rem 0;">
                    @subtitle
                </p>
            }

            @if (!string.IsNullOrEmpty(Model.Description?.Value))
            {
                @* Not inline-editable: the display below is truncated to 80 chars for the card
                   preview, so contenteditable would save the "..." truncation as the real value. *@
                <p style="font-size:0.8rem; color:@(isOverlay ? "#e5e7eb" : "#6b7280"); margin:0.5rem 0; line-height:1.4;
                          display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden;">
                    @Html.Raw(Model.Description.Value.Length > 80 ? Model.Description.Value.Substring(0, 80) + "..." : Model.Description.Value)
                </p>
            }

            @if (!string.IsNullOrEmpty(Model.IconClass?.Value))
            {
                <i class="@Model.IconClass.Value" style="color:@accent; font-size:0.9rem; margin:0.25rem 0;"></i>
            }
        </div>
    </a>

    @* Bot�n de acci�n *@
    <div style="padding:0 1rem 1rem 1rem; position:relative; text-align:@textAlign; @(isHorizontal ? "flex:0 0 100%;" : "")">
        <button class="@(textAlign == "center" ? "w-full" : "") font-semibold transition-all"
                style="background-color:@accent; color:@btnTextColor; border:@btnBorder; border-radius:@btnRadius; padding:@btnPadding; cursor:pointer;"
                onmouseover="this.style.backgroundColor='@hover'"
                onmouseout="this.style.backgroundColor='@accent'"
                onclick="window.location.href='@targetUrl'">
            <span>@(Model.ButtonText?.Value ?? "Comprar")</span>
            <i class="fas fa-arrow-right" style="margin-left:0.5rem; font-size:0.75rem;"></i>
        </button>
    </div>
</div>

@* Estilos responsivos *@
<style>
    @@media (max-width: 640px) {
        .card {
            max-width: 100% !important;
            flex-direction: column !important;
        }
    }
</style>
