@using BrixCMS.Open.Models.Blocks
@model TableBlock

@using System.Text.Json

@{
    var tableDataJson = Model.TableData?.Value ?? "";
    var caption = Model.Caption?.Value ?? "";
    var style = Model.Style?.Value ?? "striped";
    var headerBg = Model.HeaderBackground?.Value ?? "#f3f4f6";
    var headerColor = Model.HeaderColor?.Value ?? "#000000";
    var rowBg = Model.RowBackground?.Value ?? "#ffffff";
    var rowAltBg = Model.RowAlternateBackground?.Value ?? "#f9fafb";
    var borderColor = Model.BorderColor?.Value ?? "#e5e7eb";
    var cellPadding = Model.CellPadding?.Value ?? "12px";
    var textAlign = Model.TextAlign?.Value ?? "left";
    var mobileScroll = Model.MobileScroll?.Value ?? "true";
    var sectionId = Model.SectionId?.Value ?? "";
    
    var headers = new List<string>();
    var rows = new List<List<string>>();
    
    try {
        if (!string.IsNullOrEmpty(tableDataJson)) {
            var data = JsonSerializer.Deserialize<Dictionary<string, object>>(tableDataJson);
            if (data != null) {
                if (data.ContainsKey("headers")) {
                    var h = data["headers"];
                    if (h is JsonElement he) headers = JsonSerializer.Deserialize<List<string>>(he.GetRawText()) ?? new List<string>();
                }
                if (data.ContainsKey("rows")) {
                    var r = data["rows"];
                    if (r is JsonElement re) rows = JsonSerializer.Deserialize<List<List<string>>>(re.GetRawText()) ?? new List<List<string>>();
                }
            }
        }
    } catch {}
}

<section id="@sectionId" class="py-4">
    @if (headers.Count == 0)
    {
        <div class="text-center text-gray-400 py-8">
            <p>Configure table data in block settings (JSON format)</p>
        </div>
    }
    else
    {
        <div class="@(mobileScroll == "true" ? "overflow-x-auto" : "")">
            <table class="w-full" style="border-collapse:@(style == "bordered" ? "collapse" : "separate"); border-spacing:0;">
                @if (!string.IsNullOrEmpty(caption))
                {
                    <caption class="caption-bottom p-2 text-sm" style="color:@headerColor;">@caption</caption>
                }
                <thead>
                    <tr>
                        @foreach (var header in headers)
                        {
                            <th class="p-3 text-left font-semibold" style="background-color:@headerBg;color:@headerColor;padding:@cellPadding;text-align:@textAlign;border-bottom:@(style == "bordered" ? $"2px solid {borderColor}" : "none");">
                                @header
                            </th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @for (var i = 0; i < rows.Count; i++)
                    {
                        <tr>
                            @foreach (var cell in rows[i])
                            {
                                <td class="p-3" style="background-color:@(i % 2 == 0 ? rowBg : rowAltBg);color:@headerColor;padding:@cellPadding;text-align:@textAlign;border-bottom:1px solid @borderColor;">
                                    @cell
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>
