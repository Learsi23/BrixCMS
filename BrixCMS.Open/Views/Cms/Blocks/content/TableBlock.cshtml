@using BrixCMS.Open.Models.Blocks
@model TableBlock

@{
    // ── Parse pipe-separated CSV ────────────────────────────────────────────
    // Format: first line = headers, each subsequent line = one row.
    // Columns separated by the pipe character |
    // Example:
    //   Product | Price | Status
    //   Apple   | €1.50 | Available
    //   Banana  | €0.80 | Sold out

    var raw          = Model.TableData?.Value ?? "";
    var caption      = Model.Caption?.Value ?? "";
    var style        = Model.Style?.Value ?? "striped";
    var headerBg     = Model.HeaderBackground?.Value ?? "#f3f4f6";
    var headerColor  = Model.HeaderColor?.Value ?? "#000000";
    var cellColor    = Model.CellColor?.Value ?? "#111827";
    var rowBg        = Model.RowBackground?.Value ?? "#ffffff";
    var rowAltBg     = Model.RowAlternateBackground?.Value ?? "#f9fafb";
    var borderColor  = Model.BorderColor?.Value ?? "#e5e7eb";
    var cellPadding  = Model.CellPadding?.Value ?? "12px";
    var textAlign    = Model.TextAlign?.Value ?? "left";
    var mobileScroll = Model.MobileScroll?.Value ?? "true";
    var sectionId    = Model.SectionId?.Value ?? "";

    var headers = new List<string>();
    var rows    = new List<List<string>>();

    // ── Detect legacy JSON format and convert on-the-fly ───────────────────
    // Old format: {"headers":["A","B"],"rows":[["r1c1","r1c2"],...]}
    if (raw.TrimStart().StartsWith("{"))
    {
        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(raw);
            var root = doc.RootElement;
            if (root.TryGetProperty("headers", out var hEl))
                headers = hEl.EnumerateArray().Select(h => h.GetString() ?? "").ToList();
            if (root.TryGetProperty("rows", out var rEl))
                rows = rEl.EnumerateArray()
                          .Select(r => r.EnumerateArray().Select(c => c.GetString() ?? "").ToList())
                          .ToList();
        }
        catch { /* fall through to pipe parser */ }
    }

    // ── Pipe-separated CSV (current format) ────────────────────────────────
    if (headers.Count == 0)
    {
        var lines = raw
            .Split('\n', StringSplitOptions.RemoveEmptyEntries)
            .Select(l => l.Trim())
            .Where(l => l.Length > 0)
            .ToList();

        if (lines.Count > 0)
        {
            headers = lines[0].Split('|').Select(h => h.Trim()).ToList();
            rows    = lines.Skip(1)
                           .Select(l => l.Split('|').Select(c => c.Trim()).ToList())
                           .ToList();
        }
    }
}

<section id="@sectionId" class="container mx-auto py-6">
    @if (headers.Count == 0)
    {
        <div class="text-center text-gray-400 py-8 text-sm">
            <i class="fas fa-table mb-2 block text-2xl text-gray-300"></i>
            <p>Add table content in block settings.</p>
            <p class="text-xs mt-1 text-gray-300">Example: <code>Name | Price | Status</code></p>
        </div>
    }
    else
    {
        <div class="@(mobileScroll == "true" ? "overflow-x-auto" : "")">
            <table class="w-full" style="border-collapse:@(style == "bordered" ? "collapse" : "separate"); border-spacing:0;">
                @if (!string.IsNullOrEmpty(caption))
                {
                    <caption class="caption-bottom p-2 text-sm" style="color:@headerColor;">@caption</caption>
                }
                <thead>
                    <tr>
                        @foreach (var header in headers)
                        {
                            <th style="background-color:@headerBg; color:@headerColor; padding:@cellPadding; text-align:@textAlign; border-bottom:@(style == "bordered" ? $"2px solid {borderColor}" : "none"); font-weight:600;">
                                @header
                            </th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @for (var i = 0; i < rows.Count; i++)
                    {
                        <tr>
                            @foreach (var cell in rows[i])
                            {
                                <td style="background-color:@(i % 2 == 0 ? rowBg : rowAltBg); color:@cellColor; padding:@cellPadding; text-align:@textAlign; border-bottom:1px solid @borderColor;">
                                    @cell
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>
