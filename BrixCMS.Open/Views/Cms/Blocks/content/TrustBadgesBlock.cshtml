@using BrixCMS.Open.Models.Blocks
@model TrustBadgesBlock

@{
    var iconColor = Model.IconColor?.Value      ?? "#111827";
    var bg        = Model.BackgroundColor?.Value ?? "#f9fafb";
    var border    = Model.ShowBorder?.IsTrue     ?? true;

    // Build badges from individual fields — only include a badge if it has a label
    var badges = new[]
    {
        new { Icon = Model.Badge1Icon?.Value ?? "", Label = Model.Badge1Label?.Value ?? "", Sub = Model.Badge1Sublabel?.Value ?? "" },
        new { Icon = Model.Badge2Icon?.Value ?? "", Label = Model.Badge2Label?.Value ?? "", Sub = Model.Badge2Sublabel?.Value ?? "" },
        new { Icon = Model.Badge3Icon?.Value ?? "", Label = Model.Badge3Label?.Value ?? "", Sub = Model.Badge3Sublabel?.Value ?? "" },
        new { Icon = Model.Badge4Icon?.Value ?? "", Label = Model.Badge4Label?.Value ?? "", Sub = Model.Badge4Sublabel?.Value ?? "" },
    }.Where(b => !string.IsNullOrEmpty(b.Label)).ToList();
}

<section style="background-color:@bg; border-top:@(border ? "1px solid #e5e7eb" : "none"); border-bottom:@(border ? "1px solid #e5e7eb" : "none");"
         class="py-8 px-4">
    <div class="max-w-5xl mx-auto">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
            @foreach (var badge in badges)
            {
                <div class="flex flex-col items-center text-center gap-2">
                    @if (!string.IsNullOrEmpty(badge.Icon))
                    {
                        <i class="@badge.Icon text-2xl" style="color:@iconColor;"></i>
                    }
                    <span class="font-semibold text-sm text-gray-800">@badge.Label</span>
                    @if (!string.IsNullOrEmpty(badge.Sub))
                    {
                        <span class="text-xs text-gray-500">@badge.Sub</span>
                    }
                </div>
            }
        </div>
    </div>
</section>
