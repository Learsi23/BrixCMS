@using BrixCMS.Open.Models.Blocks
@model BYOKConfigBlock

@{
    var layout = Model.Layout?.Value ?? "left-right";
    var bgColor = Model.BackgroundColor?.Value ?? "transparent";
    
    var titleColor = Model.TitleColor?.Value ?? "#ffffff";
    var titleSize = Model.TitleSize?.Value ?? "2rem";
    var subColor = Model.SubtitleColor?.Value ?? "#9ca3af";
    
    var isLeftRight = layout == "left-right";
}

<section class="w-full" style="background-color:@bgColor; padding:4rem 0;">
    <div class="mx-auto" style="max-width:1200px; padding:0 1rem;">
        
        @if (isLeftRight)
        {
            <div class="grid" style="grid-template-columns:1fr 1fr; gap:4rem; align-items:center;">
                
                @* Left: Text + Feature Cards *@
                <div>
                    @if (!string.IsNullOrWhiteSpace(Model.Title?.Value))
                    {
                        <h2 class="font-bold mb-4" style="color:@titleColor; font-size:@titleSize;">
                            @Html.Raw(Model.Title.Value)
                        </h2>
                    }
                    
                    @if (!string.IsNullOrWhiteSpace(Model.Subtitle?.Value))
                    {
                        <p class="mb-6" style="color:@subColor; font-size:1.125rem; line-height:1.7;">
                            @Model.Subtitle.Value
                        </p>
                    }
                    
                    @* Feature Cards *@
                    <div class="flex flex-col gap-4">
                        @if (!string.IsNullOrWhiteSpace(Model.Card1Title?.Value))
                        {
                            <div class="p-4 rounded-lg border" style="background:#111113; border-color:#2A2A30;">
                                <div class="flex items-start gap-3">
                                    @if (!string.IsNullOrWhiteSpace(Model.Card1Icon?.Value))
                                    {
                                        <span class="text-xl">@Model.Card1Icon.Value</span>
                                    }
                                    <div>
                                        <div class="font-semibold" style="color:#F0F0F5;">@Model.Card1Title.Value</div>
                                        @if (!string.IsNullOrWhiteSpace(Model.Card1Desc?.Value))
                                        {
                                            <div class="text-sm mt-1" style="color:#9696A6;">@Model.Card1Desc.Value</div>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                        
                        @if (!string.IsNullOrWhiteSpace(Model.Card2Title?.Value))
                        {
                            <div class="p-4 rounded-lg border" style="background:#111113; border-color:#2A2A30;">
                                <div class="flex items-start gap-3">
                                    @if (!string.IsNullOrWhiteSpace(Model.Card2Icon?.Value))
                                    {
                                        <span class="text-xl">@Model.Card2Icon.Value</span>
                                    }
                                    <div>
                                        <div class="font-semibold" style="color:#F0F0F5;">@Model.Card2Title.Value</div>
                                        @if (!string.IsNullOrWhiteSpace(Model.Card2Desc?.Value))
                                        {
                                            <div class="text-sm mt-1" style="color:#9696A6;">@Model.Card2Desc.Value</div>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
                
                @* Right: API Keys Panel *@
                <div>
                    @if (Model.ShowApiKeys?.IsTrue == true)
                    {
                        <div class="p-6 rounded-xl border" style="background:#18181C; border-color:#2A2A30;">
                            <div class="text-xs uppercase tracking-wider mb-4" style="color:#56566A; font-weight:700;">API-konfiguration</div>
                            
                            @* OpenAI *@
                            <div class="flex items-center gap-3 py-3 border-b" style="border-color:#2A2A30;">
                                <span class="text-xs" style="color:#56566A; width:100px;">@Model.OpenAILabel?.Value</span>
                                <code class="flex-1 text-sm px-3 py-2 rounded" style="background:#111113; border:1px solid #2A2A30; color:#A5B4FC; font-family:monospace;">
                                    @Model.OpenAIKey?.Value
                                </code>
                                <span class="text-xs px-2 py-1 rounded-full" style="background:rgba(34,197,94,0.1); border:1px solid rgba(34,197,94,0.2); color:#22C55E;">
                                    ✓ @Model.OpenAIStatus?.Value
                                </span>
                            </div>
                            
                            @* Stripe *@
                            <div class="flex items-center gap-3 py-3 border-b" style="border-color:#2A2A30;">
                                <span class="text-xs" style="color:#56566A; width:100px;">@Model.StripeLabel?.Value</span>
                                <code class="flex-1 text-sm px-3 py-2 rounded" style="background:#111113; border:1px solid #2A2A30; color:#A5B4FC; font-family:monospace;">
                                    @Model.StripeKey?.Value
                                </code>
                                <span class="text-xs px-2 py-1 rounded-full" style="background:rgba(34,197,94,0.1); border:1px solid rgba(34,197,94,0.2); color:#22C55E;">
                                    ✓ @Model.StripeStatus?.Value
                                </span>
                            </div>
                            
                            @* Gemini *@
                            <div class="flex items-center gap-3 py-3">
                                <span class="text-xs" style="color:#56566A; width:100px;">@Model.GeminiLabel?.Value</span>
                                <code class="flex-1 text-sm px-3 py-2 rounded" style="background:#111113; border:1px solid #2A2A30; color:#A5B4FC; font-family:monospace;">
                                    @Model.GeminiKey?.Value
                                </code>
                                <span class="text-xs px-2 py-1 rounded-full" style="background:rgba(34,197,94,0.1); border:1px solid rgba(34,197,94,0.2); color:#22C55E;">
                                    ✓ @Model.GeminiStatus?.Value
                                </span>
                            </div>
                            
                            @* Sales Stats *@
                            @if (Model.ShowSalesStats?.IsTrue == true)
                            {
                                <div class="mt-4 pt-4 border-t" style="border-color:#2A2A30;">
                                    <div class="flex justify-between text-xs mb-2">
                                        <span style="color:#56566A;">@Model.SalesLabel?.Value</span>
                                        <span style="color:#F0F0F5; font-weight:600;">@Model.SalesValue?.Value</span>
                                    </div>
                                    <div class="flex justify-between text-xs">
                                        <span style="color:#56566A;">@Model.FeeLabel?.Value</span>
                                        <span style="color:#F0F0F5; font-weight:600;">@Model.FeeValue?.Value</span>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        }
        else
        {
            @* Single column layout *@
            <div class="text-center">
                @if (!string.IsNullOrWhiteSpace(Model.Title?.Value))
                {
                    <h2 class="font-bold mb-4" style="color:@titleColor; font-size:@titleSize;">
                        @Html.Raw(Model.Title.Value)
                    </h2>
                }
                @if (!string.IsNullOrWhiteSpace(Model.Subtitle?.Value))
                {
                    <p class="mb-8" style="color:@subColor; font-size:1.125rem;">
                        @Model.Subtitle.Value
                    </p>
                }
            </div>
        }
    </div>
</section>
