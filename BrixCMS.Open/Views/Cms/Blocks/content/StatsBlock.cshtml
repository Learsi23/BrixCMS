@model BrixCMS.Open.Models.Blocks.StatsBlock
@{
    var __blockId = ViewData["IsPreview"] is true ? (ViewData["RawBlock"] as BrixCMS.Open.Data.Block)?.Id : null;
    var bgColor    = Model.BackgroundColor?.Value ?? "#f9fafb";
    var cardBg     = Model.CardBgColor?.Value ?? "#ffffff";
    var padY       = Model.PaddingY?.Value ?? "4rem";
    var numColor   = Model.NumberColor?.Value ?? "#10b981";
    var lblColor   = Model.LabelColor?.Value ?? "#6b7280";

    var stats = new[]
    {
        (Model.Stat1Number?.Value, Model.Stat1Label?.Value, Model.Stat1Icon?.Value),
        (Model.Stat2Number?.Value, Model.Stat2Label?.Value, Model.Stat2Icon?.Value),
        (Model.Stat3Number?.Value, Model.Stat3Label?.Value, Model.Stat3Icon?.Value),
        (Model.Stat4Number?.Value, Model.Stat4Label?.Value, Model.Stat4Icon?.Value),
    }.Where(s => !string.IsNullOrWhiteSpace(s.Item1)).ToArray();

    var cols = stats.Length switch { 1 => "grid-cols-1", 2 => "grid-cols-2", 3 => "grid-cols-3", _ => "grid-cols-2 lg:grid-cols-4" };
}

<section style="background-color:@bgColor; padding:@padY 1.5rem;">
    <div class="container mx-auto max-w-6xl">

        @if (!string.IsNullOrWhiteSpace(Model.Title?.Value))
        {
            <div class="text-center mb-10">
                <h2 class="text-3xl font-bold mb-2" data-editable-field="Title" data-block-id="@__blockId" style="color:@(Model.TitleColor?.Value ?? "#111827")">
                    @Html.Raw(Model.Title.Value)
                </h2>
                @if (!string.IsNullOrWhiteSpace(Model.Subtitle?.Value))
                {
                    <p class="text-lg" data-editable-field="Subtitle" data-block-id="@__blockId" data-multiline="1" style="color:@(Model.SubtitleColor?.Value ?? "#6b7280")">
                        @Html.Raw(Model.Subtitle.Value)
                    </p>
                }
            </div>
        }

        <div class="grid @cols gap-6">
            @foreach (var (number, label, icon) in stats)
            {
                <div class="rounded-2xl p-8 text-center shadow-sm border border-gray-100"
                     style="background-color:@cardBg;">
                    @if (!string.IsNullOrWhiteSpace(icon))
                    {
                        <div class="mb-3">
                            <i class="@icon text-3xl" style="color:@numColor;"></i>
                        </div>
                    }
                    <div class="text-4xl font-black mb-2 leading-none" style="color:@numColor;">
                        @number
                    </div>
                    @if (!string.IsNullOrWhiteSpace(label))
                    {
                        <p class="text-sm font-semibold uppercase tracking-wider" style="color:@lblColor;">
                            @label
                        </p>
                    }
                </div>
            }
        </div>

    </div>
</section>
