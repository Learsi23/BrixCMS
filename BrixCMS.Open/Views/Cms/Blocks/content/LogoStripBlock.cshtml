@model BrixCMS.Open.Models.Blocks.LogoStripBlock
@{
    var logos = new[]
    {
        (Model.Logo1?.Value, Model.Logo1Url?.Value),
        (Model.Logo2?.Value, Model.Logo2Url?.Value),
        (Model.Logo3?.Value, Model.Logo3Url?.Value),
        (Model.Logo4?.Value, Model.Logo4Url?.Value),
        (Model.Logo5?.Value, Model.Logo5Url?.Value),
        (Model.Logo6?.Value, Model.Logo6Url?.Value),
    }.Where(l => !string.IsNullOrWhiteSpace(l.Item1)).ToArray();

    var height    = Model.LogoHeight?.Value ?? "40px";
    var grayscale = Model.Grayscale?.IsTrue ?? true;
    var bgColor   = Model.BackgroundColor?.Value ?? "#f9fafb";
    var padY      = Model.PaddingY?.Value ?? "2.5rem";
    var imgFilter = grayscale ? "filter:grayscale(100%); opacity:0.6;" : "";
    var imgHover  = grayscale ? "transition:filter .2s,opacity .2s;" : "";
}

<section style="background-color:@bgColor; padding:@padY 1.5rem;">
    <div class="container mx-auto max-w-6xl">

        @if (!string.IsNullOrWhiteSpace(Model.Heading?.Value))
        {
            <p class="text-center text-xs font-bold uppercase tracking-widest mb-8"
               style="color:@(Model.HeadingColor?.Value ?? "#9ca3af");">
                @Model.Heading.Value
            </p>
        }

        <div class="flex flex-wrap items-center justify-center gap-8 md:gap-12">
            @foreach (var (imgUrl, linkUrl) in logos)
            {
                var tag = string.IsNullOrWhiteSpace(linkUrl) ? "div" : "a";
                var href = string.IsNullOrWhiteSpace(linkUrl) ? "" : $"href=\"{linkUrl}\" target=\"_blank\"";

                @Html.Raw($"<{tag} {href} class=\"flex items-center justify-center\">")
                <img src="@imgUrl"
                     alt="partner logo"
                     style="height:@height; width:auto; object-fit:contain; @imgFilter @imgHover"
                     class="hover:grayscale-0 hover:opacity-100" />
                @Html.Raw($"</{tag}>")
            }
        </div>

    </div>
</section>
