@using BrixCMS.Open.Models.Blocks
@model ImageBlock

@{
    var src    = Model.Source?.Value ?? "";
    var alt    = Model.AltText?.Value ?? "";
    var imgW   = Model.Source?.Width ?? "";
    var imgH   = Model.Source?.Height ?? "";
    var imgFit = string.IsNullOrWhiteSpace(Model.Source?.ObjectFit) ? "cover" : Model.Source!.ObjectFit;
}

<div style="@(string.IsNullOrEmpty(imgW) ? "" : $"width:{imgW}px;") @(string.IsNullOrEmpty(imgH) ? "" : $"height:{imgH}px;")">
    <img src="@src"
         alt="@alt"
         style="width:100%; height:100%; object-fit:@imgFit;"
         class="rounded-xl" />
</div>
