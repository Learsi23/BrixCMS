@using BrixCMS.Open.Models.Blocks
@model BrixGridDemoBlock

@{
    var layout = Model.Layout?.Value ?? "grid-text";
    var bgColor = Model.BackgroundColor?.Value ?? "transparent";
    var accentColor = Model.AccentColor?.Value ?? "#5B6EF5";
    
    var titleColor = Model.TitleColor?.Value ?? "#ffffff";
    var titleSize = Model.TitleSize?.Value ?? "2rem";
    var subColor = Model.SubtitleColor?.Value ?? "#9ca3af";
    
    var gridCols = Model.GridColumns?.Value ?? "4";
    var gap = Model.Gap?.Value ?? "8px";
    var isGridText = layout == "grid-text";
}

<section class="w-full" style="background-color:@bgColor; padding:4rem 0;">
    <div class="mx-auto" style="max-width:1200px; padding:0 1rem;">
        
        @if (isGridText)
        {
            <div class="grid md:grid-cols-2 gap-8 items-center">
                
                @* Left: Grid Demo *@
                <div>
                    <div class="p-4 rounded-xl border" style="background:#111113; border-color:#2A2A30;">
                        <div class="grid gap-@gap" style="grid-template-columns:repeat(@gridCols, 1fr); grid-template-rows:repeat(3, 80px);">
                            
                            @* Block 1: Hero Banner (full width) *@
                            @if (!string.IsNullOrWhiteSpace(Model.Block1Label?.Value))
                            {
                                <div class="rounded-lg flex items-center justify-center text-xs font-semibold
                                    @(Model.Block1Highlight?.IsTrue == true ? "border-2" : "border")
                                    " style="
                                        background:@(Model.Block1Highlight?.IsTrue == true ? "rgba(91,110,245,0.1)" : "#18181C");
                                        border-color:@(Model.Block1Highlight?.IsTrue == true ? accentColor : "#2A2A30");
                                        color:@(Model.Block1Highlight?.IsTrue == true ? accentColor : "#56566A");
                                    ">
                                    @Model.Block1Label.Value
                                </div>
                            }
                            
                            @* Block 2: Product Grid (tall) *@
                            @if (!string.IsNullOrWhiteSpace(Model.Block2Label?.Value))
                            {
                                <div class="rounded-lg border flex items-center justify-center text-xs font-semibold" 
                                     style="background:#18181C; border-color:#2A2A30; color:#56566A; grid-row: span 2;">
                                    @Model.Block2Label.Value<br /><span class="text-xs opacity-60">(2 rows)</span>
                                </div>
                            }
                            
                            @* Block 3: Image *@
                            @if (!string.IsNullOrWhiteSpace(Model.Block3Label?.Value))
                            {
                                <div class="rounded-lg border flex items-center justify-center text-xs font-semibold" 
                                     style="background:#18181C; border-color:#2A2A30; color:#56566A;">
                                    @Model.Block3Label.Value
                                </div>
                            }
                            
                            @* Block 4: Text *@
                            @if (!string.IsNullOrWhiteSpace(Model.Block4Label?.Value))
                            {
                                <div class="rounded-lg border flex items-center justify-center text-xs font-semibold" 
                                     style="background:#18181C; border-color:#2A2A30; color:#56566A;">
                                    @Model.Block4Label.Value
                                </div>
                            }
                            
                            @* Block 5: CTA *@
                            @if (!string.IsNullOrWhiteSpace(Model.Block5Label?.Value))
                            {
                                <div class="rounded-lg border flex items-center justify-center text-xs font-semibold" 
                                     style="background:#18181C; border-color:#2A2A30; color:#56566A;">
                                    @Model.Block5Label.Value
                                </div>
                            }
                            
                            @* Block 6: Video *@
                            @if (!string.IsNullOrWhiteSpace(Model.Block6Label?.Value))
                            {
                                <div class="rounded-lg border flex items-center justify-center text-xs font-semibold" 
                                     style="background:#18181C; border-color:#2A2A30; color:#56566A;">
                                    @Model.Block6Label.Value
                                </div>
                            }
                            
                            @* Block 7: Reviews (span 3) *@
                            @if (!string.IsNullOrWhiteSpace(Model.Block7Label?.Value))
                            {
                                <div class="rounded-lg border flex items-center justify-center text-xs font-semibold" 
                                     style="background:#18181C; border-color:#2A2A30; color:#56566A; grid-column: span 3;">
                                    @Model.Block7Label.Value
                                </div>
                            }
                            
                            @* Block 8: Footer (full width) *@
                            @if (!string.IsNullOrWhiteSpace(Model.Block8Label?.Value))
                            {
                                <div class="rounded-lg border flex items-center justify-center text-xs font-semibold" 
                                     style="background:#18181C; border-color:#2A2A30; color:#56566A; grid-column: span 4;">
                                    @Model.Block8Label.Value
                                </div>
                            }
                            
                        </div>
                    </div>
                </div>
                
                @* Right: Text + Features *@
                <div>
                    @if (!string.IsNullOrWhiteSpace(Model.Title?.Value))
                    {
                        <h2 class="font-bold mb-4" style="color:@titleColor; font-size:@titleSize;">
                            @Html.Raw(Model.Title.Value)
                        </h2>
                    }
                    
                    @if (!string.IsNullOrWhiteSpace(Model.Subtitle?.Value))
                    {
                        <p class="mb-6" style="color:@subColor; font-size:1.125rem; line-height:1.7;">
                            @Model.Subtitle.Value
                        </p>
                    }
                    
                    @if (Model.ShowFeatures?.IsTrue == true)
                    {
                        <div class="flex flex-col gap-3">
                            @if (!string.IsNullOrWhiteSpace(Model.Feature1?.Value))
                            {
                                <div class="flex items-center gap-2">
                                    <span style="color:#22C55E; font-weight:700;">✓</span>
                                    <span style="color:#9696A6;">@Model.Feature1.Value</span>
                                </div>
                            }
                            @if (!string.IsNullOrWhiteSpace(Model.Feature2?.Value))
                            {
                                <div class="flex items-center gap-2">
                                    <span style="color:#22C55E; font-weight:700;">✓</span>
                                    <span style="color:#9696A6;">@Model.Feature2.Value</span>
                                </div>
                            }
                            @if (!string.IsNullOrWhiteSpace(Model.Feature3?.Value))
                            {
                                <div class="flex items-center gap-2">
                                    <span style="color:#22C55E; font-weight:700;">✓</span>
                                    <span style="color:#9696A6;">@Model.Feature3.Value</span>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        }
        else
        {
            @* Header only *@
            <div class="text-center mb-8">
                @if (!string.IsNullOrWhiteSpace(Model.Title?.Value))
                {
                    <h2 class="font-bold" style="color:@titleColor; font-size:@titleSize;">
                        @Html.Raw(Model.Title.Value)
                    </h2>
                }
                @if (!string.IsNullOrWhiteSpace(Model.Subtitle?.Value))
                {
                    <p class="mt-4" style="color:@subColor; font-size:1.125rem;">
                        @Model.Subtitle.Value
                    </p>
                }
            </div>
        }
    </div>
</section>
