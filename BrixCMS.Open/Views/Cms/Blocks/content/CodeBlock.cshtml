@using BrixCMS.Open.Models.Blocks
@model CodeBlock

@{
    var code = Model.Code?.Value ?? "";
    var language = Model.Language?.Value ?? "javascript";
    var theme = Model.Theme?.Value ?? "dark";
    var bgColor = theme switch {
        "github" => "#f6f8fa",
        "monokai" => "#272822",
        "dracula" => "#282a36",
        _ => "#1e293b"
    };
    var textColor = theme switch {
        "github" => "#24292e",
        _ => "#e2e8f0"
    };
    var borderRadius = Model.BorderRadius?.Value ?? "8px";
    var showLineNumbers = Model.ShowLineNumbers?.Value ?? "true";
    var showCopy = Model.ShowCopyButton?.Value ?? "true";
    var maxHeight = Model.MaxHeight?.Value ?? "";
    var fontSize = Model.FontSize?.Value ?? "14px";
    var title = Model.Title?.Value ?? "";
    var titleBg = Model.TitleBackground?.Value ?? "#0f172a";
    var sectionId = Model.SectionId?.Value ?? "";
    
    var lines = code.Split('\n');
}

<section id="@sectionId" class="py-4">
    <div class="overflow-hidden rounded-lg" style="background-color:@bgColor;border-radius:@borderRadius;@(string.IsNullOrEmpty(maxHeight) ? "" : $"max-height:{maxHeight};overflow:auto;")">
        @if (!string.IsNullOrEmpty(title) || showCopy == "true")
        {
            <div class="flex items-center justify-between px-4 py-2" style="background-color:@titleBg;">
                <span class="text-sm font-mono" style="color:@textColor;opacity:0.7;">
                    @(string.IsNullOrEmpty(title) ? language : title)
                </span>
                @if (showCopy == "true")
                {
                    <button onclick="navigator.clipboard.writeText(this.closest('.overflow-hidden').querySelector('code').innerText);this.innerText='Copied!';setTimeout(()=>this.innerText='Copy',2000);"
                            class="text-sm px-2 py-1 rounded transition-opacity hover:opacity-70"
                            style="color:@textColor;background-color:transparent;border:1px solid @textColor;">
                        Copy
                    </button>
                }
            </div>
        }
        <pre class="p-4 font-mono" style="color:@textColor;font-size:@fontSize;line-height:1.5;">
            @if (showLineNumbers == "true")
            {
                <span class="mr-4 inline-block text-right select-none" style="color:@textColor;opacity:0.4;">
                    @for (var i = 1; i <= lines.Length; i++)
                    {
                        @i<span class="block"> </span>
                    }
                </span>
            }
            <code>@code</code>
        </pre>
    </div>
</section>
