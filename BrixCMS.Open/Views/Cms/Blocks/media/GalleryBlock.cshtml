@using BrixCMS.Open.Services
@using BrixCMS.Open.Models.Blocks.Gallery
@using BrixCMS.Open.Models.Base
@model GalleryBlock
@inject BrixCMS.Open.Data.BrixDbContext Db
@inject BlockRegistry Registry

@{
    var blockData = (BrixCMS.Open.Data.Block)ViewData["RawBlock"];
    var blockId   = blockData.Id;

    var allBlocks = ViewData["AllBlocks"] as List<BrixCMS.Open.Data.Block>;
    var children  = allBlocks != null
        ? allBlocks.Where(b => b.ParentId == blockId).OrderBy(b => b.SortOrder).ToList()
        : Db.Blocks.Where(b => b.ParentId == blockId).OrderBy(b => b.SortOrder).ToList();

    var containerStyle = "";
    var titleStyle     = "";
    var galleryId      = "gallery-" + blockId.ToString()[..8];
    var lightbox       = Model.EnableLightbox?.IsTrue ?? true;

    if (Model.BackgroundColor?.Value != null && Model.BackgroundColor.Value != "transparent")
        containerStyle += $"background-color: {Model.BackgroundColor.Value};";
    if (!string.IsNullOrEmpty(Model.Padding?.Value))
        containerStyle += $"padding: {Model.Padding.Value};";
    if (!string.IsNullOrEmpty(Model.BorderRadius?.Value))
        containerStyle += $"border-radius: {Model.BorderRadius.Value};";
    if (Model.TitleColor?.Value != null && Model.TitleColor.Value != "transparent")
        titleStyle += $"color: {Model.TitleColor.Value};";
    if (!string.IsNullOrEmpty(Model.TitleSize?.Value))
        titleStyle += $"font-size: {Model.TitleSize.Value};";
}

<div class="gallery-block" style="@containerStyle"
     x-data="{ lbShow: false, lbUrl: '', lbName: '' }">
    <div class="max-w-[1200px] mx-auto w-full">

        @if (!string.IsNullOrEmpty(Model.Title?.Value))
        {
            <h2 class="mb-6 font-bold text-center" style="@titleStyle">@Model.Title.Value</h2>
        }

        @if (!children.Any())
        {
            <div class="text-center text-gray-400 py-12 border-2 border-dashed border-gray-300 rounded-lg">
                No hay elementos en la galería. Haz clic en "+ Add item" para añadir contenido.
            </div>
        }
        else
        {
            @switch (Model.LayoutType?.Value)
            {
                case "grid":
                case "masonry":
                    <div class="grid" style="grid-template-columns: repeat(@(Model.ItemsPerView?.Value ?? "3"), 1fr); gap: @(Model.Gap?.Value ?? "16px");">
                        @foreach (var child in children)
                        {
                            var childModel = Registry.CreateModel(child);
                            var childData  = new ViewDataDictionary(ViewData);
                            childData["RawBlock"]  = child;
                            childData["AllBlocks"] = allBlocks;
                            <div class="@(lightbox ? "cursor-zoom-in" : "")"
                                 @(lightbox ? "@@click=\"let img=$el.querySelector('img'); if(img){ lbUrl=img.src; lbName=img.alt||img.src.split('/').pop(); lbShow=true; }\"" : "")>
                                @await Html.PartialAsync(Registry.GetViewPath(child.Type), childModel, childData)
                            </div>
                        }
                    </div>
                    break;

                default: // carousel
                    <div class="flex overflow-x-auto gap-4 pb-4 snap-x snap-mandatory">
                        @foreach (var child in children)
                        {
                            var childModel = Registry.CreateModel(child);
                            var childData  = new ViewDataDictionary(ViewData);
                            childData["RawBlock"]  = child;
                            childData["AllBlocks"] = allBlocks;
                            <div class="flex-shrink-0 snap-start @(lightbox ? "cursor-zoom-in" : "")"
                                 style="width:clamp(220px,30%,380px); height:@(Model.ItemHeight?.Value ?? "300px");"
                                 @(lightbox ? "@@click=\"let img=$el.querySelector('img'); if(img){ lbUrl=img.src; lbName=img.alt||img.src.split('/').pop(); lbShow=true; }\"" : "")>
                                @await Html.PartialAsync(Registry.GetViewPath(child.Type), childModel, childData)
                            </div>
                        }
                    </div>
                    break;
            }
        }

        @if (ViewContext.HttpContext.Request.Path.ToString().Contains("/edit"))
        {
            <div class="mt-4 text-center">
                <button type="button" onclick="openSelectorForParent('@blockId')"
                        class="bg-emerald-500 hover:bg-emerald-600 text-white px-4 py-2 rounded-lg text-xs font-bold transition-colors">
                    + Add item to gallery
                </button>
                <div class="mt-2 text-[10px] text-gray-400">ID: @blockId</div>
            </div>
        }
    </div>

    @* Lightbox modal *@
    @if (lightbox)
    {
        <div x-show="lbShow"
             x-cloak
             class="fixed inset-0 bg-black/90 flex items-center justify-center z-[9999] p-4"
             @@click="lbShow=false"
             @@keydown.escape.window="lbShow=false"
             x-transition:enter="transition ease-out duration-200"
             x-transition:enter-start="opacity-0"
             x-transition:enter-end="opacity-100"
             x-transition:leave="transition ease-in duration-150"
             x-transition:leave-start="opacity-100"
             x-transition:leave-end="opacity-0">
            <div class="relative max-w-5xl w-full flex flex-col items-center" @@click.stop>
                <button @@click="lbShow=false"
                        class="absolute -top-10 right-0 text-white/60 hover:text-white text-2xl font-bold transition-colors">
                    &#x2715;
                </button>
                <img :src="lbUrl" class="max-h-[85vh] max-w-full object-contain rounded-xl shadow-2xl" :alt="lbName" />
                <p class="mt-3 text-white/50 text-xs font-mono" x-text="lbName"></p>
            </div>
        </div>
    }
</div>
