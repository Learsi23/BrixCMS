@model BrixCMS.Open.Data.Fields.TextAreaField

@{
    var fieldName = ViewData.TemplateInfo.HtmlFieldPrefix;
    var rows = Model.Rows > 0 ? Model.Rows : 4;
    var maxLength = Model.MaxLength > 0 ? Model.MaxLength : 2000;
    var value = Model.Value ?? "";
}

<div class="mb-3">
    @if (!string.IsNullOrEmpty(ViewData["Label"]?.ToString()))
    {
        <label class="block text-xs font-bold text-gray-500 uppercase tracking-wider mb-1">@ViewData["Label"]</label>
    }

    <textarea class="w-full px-3 py-2 text-sm rounded-lg border border-gray-200 shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white"
              id="@fieldName"
              name="@fieldName"
              rows="@rows"
              maxlength="@maxLength"
              placeholder="@ViewData["Placeholder"]"
              style="resize: vertical; border-radius: 8px;">@value</textarea>

    <div class="flex justify-between mt-1">
        <small class="text-gray-400" style="font-size: 10px;">Máximo @maxLength caracteres</small>
        <small class="text-gray-400 current-count" style="font-size: 10px;"></small>
    </div>
</div>
