{
  "$schema": "http://json.schemastore.org/template",
  "author": "BrixCMS",
  "classifications": [ "Web", "CMS", "Blazor", "MVC", "ASP.NET Core" ],
  "identity": "BrixCMS.Open.Web",
  "name": "BrixCMS Open — Block-based CMS",
  "shortName": "brixcms",
  "description": "Open-source .NET 10 block-based CMS with Blazor Server, MVC, SQLite and local Ollama AI chatbot. 40+ pre-built blocks, visual page editor, PDF chatbot — zero config.",
  "groupIdentity": "BrixCMS.Open",
  "precedence": "100",
  "tags": {
    "language": "C#",
    "type": "project"
  },
  "sourceName": "BrixCMS.Open",
  "preferNameDirectory": true,
  "primaryOutputs": [
    {
      "path": "BrixCMS.Open.csproj"
    }
  ],
  "sources": [
    {
      "exclude": [
        "**/.vs/**",
        "**/bin/**",
        "**/obj/**",
        "**/*.db",
        "**/*.db-shm",
        "**/*.db-wal",
        "**/*.user",
        "**/appsettings.Development.json",
        "**/Migrations/**"
      ]
    }
  ],
  "symbols": {
    "Framework": {
      "type": "parameter",
      "description": "Target framework",
      "datatype": "choice",
      "choices": [
        {
          "choice": "net10.0",
          "description": ".NET 10"
        }
      ],
      "replaces": "net10.0",
      "defaultValue": "net10.0"
    },
    "UserSecretsId": {
      "type": "generated",
      "generator": "guid",
      "replaces": "cf90e7a9-d19d-40a3-ab6c-6f22eb17254e",
      "parameters": {
        "format": "D"
      }
    },
    "EncryptionKey": {
      "type": "generated",
      "generator": "guid",
      "replaces": "BRIX_ENCRYPTION_KEY_PLACEHOLDER",
      "parameters": {
        "format": "N"
      }
    }
  },
  "ide": {
    "default": {
      "VisualStudio": {
        "defaultProjectNameRegex": ".*",
        "icon": {
          "name": "browser"
        }
      }
    }
  },
  "postActions": [
    {
      "description": "Restore NuGet packages",
      "manualInstructions": [ { "text": "Run 'dotnet restore'" } ],
      "actionId": "210D431B-A78B-4D2F-B762-4ED3E3EA9025",
      "continueOnError": true
    }
  ]
}
