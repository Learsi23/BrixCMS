@using System.ComponentModel
@using Microsoft.Extensions.AI
@using BrixCMS.Open.Services
@using BrixCMS.Open.Components.Pages.Chat
@using OllamaSharp
@using Microsoft.JSInterop
@using System.Text.Json

@inject IChatClient ChatClient
@inject NavigationManager Nav
@inject SemanticSearch Search
@inject ILogger<Chat> Logger
@inject PromptsService Prompts
@inject ILoggerFactory LoggerFactory
@inject IConfiguration Config
@inject IJSRuntime JS
@implements IDisposable

@if (ShowHeader)
{
    <ChatHeader OnNewChat="@ResetConversationAsync"
                Logo="@(Logo ?? "/images/logo-menu.png")"
                Title="@(Title ?? "BrixCMS")"
                LogoSize="@(LogoSize ?? "32px")" />
}

<div style="display: flex; flex-direction: column; height: 100%; background: @Theme.ChatBgColor;">
    <div style="flex: 1; overflow-y: auto; min-height: 0; padding: 1rem;">
        <div style="max-width: 48rem; margin: 0 auto;">
            <ChatMessageList Messages="@messages"
                             InProgressMessage="@inProgressMessage"
                             Logo="@(Logo ?? "/images/logo-menu.png")"
                             AiLogo="@(Theme.AiLogo ?? AiLogo ?? "/images/logo-menu.png")"
                             AiLogoSize="@(Theme.AiLogoSize)"
                             Theme="Theme">
                <NoMessagesContent>
                    <div style="text-align: center; padding: 3rem 0;">
                        <div style="width: 4rem; height: 4rem; margin: 0 auto 1rem auto; border-radius: 1rem; background: linear-gradient(135deg, #6366f1, #9333ea); display: flex; align-items: center; justify-content: center; box-shadow: 0 10px 15px -3px rgba(0,0,0,0.1);">
                            <span style="font-size: 2rem;">🤖</span>
                        </div>
                        <p style="font-size: 0.875rem; margin: 0; color: @HexToRgba(Theme.InputTextColor, "60");">
                            Send a message to start the conversation
                        </p>
                    </div>
                </NoMessagesContent>
            </ChatMessageList>
        </div>
    </div>

    <div style="flex-shrink: 0; padding: 0.75rem 1rem; background: @Theme.ChatBgColor; border-top: 1px solid @HexToRgba(Theme.InputBorderColor, "50");">
        <div style="max-width: 48rem; margin: 0 auto;">
            <ChatInput OnSend="@AddUserMessageAsync" @ref="@chatInput" Theme="Theme" />
        </div>
    </div>
</div>

@code {
    [Parameter] public string? CustomSystemPrompt { get; set; }
    [Parameter] public string? WelcomeMessage { get; set; }
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Logo { get; set; }
    [Parameter] public string? LogoSize { get; set; }
    [Parameter] public string? AiLogo { get; set; }
    [Parameter] public string? AiLogoSize { get; set; }
    [Parameter] public string? AiProvider { get; set; }
    [Parameter] public string? PdfFilter { get; set; }
    [Parameter] public bool ShowHeader { get; set; } = true;
    [Parameter] public string? ChatId { get; set; }
    [Parameter] public ChatTheme Theme { get; set; } = ChatTheme.Default;

    private readonly ChatOptions chatOptions = new();
    private readonly List<ChatMessage> messages = new();
    private ChatMessage? inProgressMessage;
    private CancellationTokenSource? responseCts;
    private string? accumulatedResponse;
    private string systemPrompt = string.Empty;
    private IChatClient? _ownedClient;
    private ChatInput? chatInput;
    private bool loadedFromStorage;
    private string effectiveChatId = string.Empty;

    protected override void OnInitialized()
    {
        systemPrompt = Prompts.GenerateChatSystemPrompt(CustomSystemPrompt);
        _ownedClient = BuildClientForProvider(AiProvider);
        chatOptions.Tools = [AIFunctionFactory.Create(SearchAsync, "SearchAsync")];
        effectiveChatId = !string.IsNullOrWhiteSpace(ChatId) ? ChatId : "default";
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadMessagesFromStorage();
        if (!loadedFromStorage)
        {
            await AddWelcomeMessage();
        }
    }

    private async Task LoadMessagesFromStorage()
    {
        try
        {
            var storedJson = await JS.InvokeAsync<string>("chatStorage.load", effectiveChatId);
            if (!string.IsNullOrEmpty(storedJson) && storedJson != "null")
            {
                var stored = JsonSerializer.Deserialize<List<StoredMessage>>(storedJson);
                if (stored != null && stored.Count > 0)
                {
                    messages.Clear();
                    foreach (var sm in stored)
                    {
                        var role = sm.Role == "User" ? ChatRole.User : ChatRole.Assistant;
                        messages.Add(new ChatMessage(role, sm.Text));
                    }
                    loadedFromStorage = true;
                    Logger.LogInformation("💾 [CHAT] Loaded {Count} messages from localStorage", messages.Count);
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to load chat from localStorage");
        }
    }

    private async Task SaveMessagesToStorage()
    {
        try
        {
            var stored = messages.Select(m => new StoredMessage
            {
                Role = m.Role == ChatRole.User ? "User" : "Assistant",
                Text = m.Text ?? string.Empty
            }).ToList();
            var json = JsonSerializer.Serialize(stored);
            await JS.InvokeVoidAsync("chatStorage.save", effectiveChatId, json);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to save chat to localStorage");
        }
    }

    private async Task AddWelcomeMessage()
    {
        if (!messages.Any(m => m.Role == ChatRole.Assistant))
        {
            var msg = !string.IsNullOrWhiteSpace(WelcomeMessage)
                ? WelcomeMessage
                : "Hi! I'm your AI Assistant. How can I help you today?";
            messages.Add(new(ChatRole.Assistant, msg));
            await SaveMessagesToStorage();
            StateHasChanged();
        }
    }

    private IChatClient? BuildClientForProvider(string? provider)
    {
        provider = (provider ?? "auto").Trim().ToLowerInvariant();
        if (provider == "ollama")
        {
            var url = Config["Ollama:BaseUrl"] ?? "http://localhost:11434";
            var model = Config["Ollama:ChatModel"] ?? "llama3.2";
            return ((IChatClient)new OllamaApiClient(new Uri(url), model))
                .AsBuilder().UseFunctionInvocation().UseLogging(LoggerFactory).Build();
        }
        return null;
    }

    private async Task AddUserMessageAsync(ChatMessage userMessage)
    {
        CancelCurrentResponse();
        messages.Add(userMessage);
        await SaveMessagesToStorage();
        if (chatInput is not null) await chatInput.FocusAsync();
        StateHasChanged();

        responseCts = new();
        accumulatedResponse = string.Empty;
        inProgressMessage = null;

        try
        {
            Logger.LogInformation("🔄 [CHAT] Provider={Provider} | Messages={Count}", AiProvider ?? "auto", messages.Count);
            var messagesForApi = new List<ChatMessage> { new(ChatRole.System, systemPrompt) };
            messagesForApi.AddRange(messages);
            var activeClient = _ownedClient ?? ChatClient;

            await foreach (var update in activeClient.GetStreamingResponseAsync(messagesForApi, chatOptions, responseCts.Token))
            {
                if (!string.IsNullOrEmpty(update.Text))
                {
                    accumulatedResponse += update.Text;
                    inProgressMessage = new(ChatRole.Assistant, accumulatedResponse);
                    await InvokeAsync(StateHasChanged);
                }
            }

            Logger.LogInformation("✅ [CHAT] Response length={Length}", accumulatedResponse?.Length ?? 0);
            if (!string.IsNullOrWhiteSpace(accumulatedResponse))
            {
                messages.Add(new(ChatRole.Assistant, accumulatedResponse));
                inProgressMessage = null;
                await SaveMessagesToStorage();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
            Logger.LogInformation("⚠️ [CHAT] Cancelled");
            if (!string.IsNullOrWhiteSpace(accumulatedResponse))
            {
                messages.Add(new(ChatRole.Assistant, accumulatedResponse));
                await SaveMessagesToStorage();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "❌ [CHAT] Error: {Message}", ex.Message);
            inProgressMessage = new(ChatRole.Assistant, $"❌ Error: {ex.Message}");
            accumulatedResponse = null;
            await InvokeAsync(StateHasChanged);
        }
        finally { responseCts = null; }
    }

    private void CancelCurrentResponse()
    {
        if (responseCts is not null) { responseCts.Cancel(); responseCts.Dispose(); }
        if (inProgressMessage is not null && !string.IsNullOrWhiteSpace(inProgressMessage.Text))
            messages.Add(inProgressMessage);
        inProgressMessage = null;
        accumulatedResponse = null;
    }

    public async Task ResetConversationAsync()
    {
        CancelCurrentResponse();
        messages.Clear();
        if (chatInput is not null) await chatInput.FocusAsync();
        await JS.InvokeVoidAsync("chatStorage.clear", effectiveChatId);
        await AddWelcomeMessage();
    }

    [Description("Searches the knowledge-base documents (PDFs) for information.")]
    private async Task<IEnumerable<string>> SearchAsync(
        [Description("The phrase or question to search for")] string searchPhrase,
        [Description("Optional: limit search to a specific filename")] string? filenameFilter = null)
    {
        await InvokeAsync(StateHasChanged);
        var effectiveFilter = !string.IsNullOrWhiteSpace(PdfFilter) ? PdfFilter : filenameFilter;
        var results = await Search.SearchAsync(searchPhrase, effectiveFilter, maxResults: 5);
        return results.Select(r => $"<result filename=\"{r.DocumentId}\" page_number=\"{r.PageNumber}\">{r.Text}</result>");
    }

    public void Dispose()
    {
        CancelCurrentResponse();
        responseCts?.Dispose();
        if (_ownedClient is IDisposable d) d.Dispose();
    }

    private static string HexToRgba(string hex, string alpha)
    {
        if (string.IsNullOrEmpty(hex)) return $"rgba(0,0,0,{alpha})";
        hex = hex.TrimStart('#');
        if (hex.Length == 3) hex = $"{hex[0]}{hex[0]}{hex[1]}{hex[1]}{hex[2]}{hex[2]}";
        var r = Convert.ToInt32(hex.Substring(0, 2), 16);
        var g = Convert.ToInt32(hex.Substring(2, 2), 16);
        var b = Convert.ToInt32(hex.Substring(4, 2), 16);
        return $"rgba({r},{g},{b},{Convert.ToInt32(alpha, 16) / 255.0:F2})";
    }

    private class StoredMessage
    {
        public string Role { get; set; } = string.Empty;
        public string Text { get; set; } = string.Empty;
    }
}