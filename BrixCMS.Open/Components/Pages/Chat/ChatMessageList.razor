@using Microsoft.Extensions.AI
@inject IJSRuntime JS

<div class="flex-1 overflow-y-auto" @ref="messagesContainer">
    <div class="space-y-6">
        @foreach (var message in Messages)
        {
            <ChatMessageItem @key="message" Message="@message" Logo="@AiLogo" AiLogoSize="@AiLogoSize" />
        }
        @if (InProgressMessage is not null)
        {
            <ChatMessageItem @key="@("streaming")"
                             Message="@InProgressMessage"
                             InProgress="true"
                             Logo="@AiLogo"
                             AiLogoSize="@AiLogoSize" />
            <div class="flex justify-center py-4">
                <div class="animate-pulse flex space-x-2">
                    <div class="w-3 h-3 bg-blue-400 rounded-full animate-bounce"></div>
                    <div class="w-3 h-3 bg-blue-400 rounded-full animate-bounce delay-100"></div>
                    <div class="w-3 h-3 bg-blue-400 rounded-full animate-bounce delay-200"></div>
                </div>
            </div>
        }
        else if (!Messages.Any(m => m.Role == ChatRole.User || m.Role == ChatRole.Assistant))
        {
            @NoMessagesContent
        }
    </div>
</div>

@code {
    private ElementReference messagesContainer;
    private IJSObjectReference? _autoScrollRef;

    [Parameter] public string? Logo { get; set; }
    [Parameter] public string? AiLogo { get; set; }
    [Parameter] public string AiLogoSize { get; set; } = "24px";

    [Parameter] public required IEnumerable<ChatMessage> Messages { get; set; } = Enumerable.Empty<ChatMessage>();
    [Parameter] public ChatMessage? InProgressMessage { get; set; }
    [Parameter] public RenderFragment? NoMessagesContent { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && messagesContainer.Context is not null)
        {
            await Task.Delay(100);
            try
            {
                _autoScrollRef = await JS.InvokeAsync<IJSObjectReference>(
                    "initAutoScroll",
                    messagesContainer);
            }
            catch
            {
                // Fallback silencioso
            }
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_autoScrollRef is not null)
                await _autoScrollRef.InvokeVoidAsync("dispose");
        }
        catch { /* Ignorar */ }
    }
}