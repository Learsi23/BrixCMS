@using Microsoft.AspNetCore.Components

@{
    var cardId = "card-" + Guid.NewGuid().ToString().Substring(0, 8);
}

@if (!string.IsNullOrEmpty(GlobalFontFamily))
{
    <style>
        @@import url('https://fonts.googleapis.com/css2?family=@(GlobalFontFamily.Replace(" ", "+")):wght@300;400;700&display=swap');
    </style>
}

<style>
    #@cardId {
        background-color: @BackgroundColor;
        background-image: @(string.IsNullOrEmpty(BackgroundImage) ? "none" : $"url('{BackgroundImage}')");
        background-size: cover;
        background-position: center;
        padding: @Padding;
        border-radius: @BorderRadius;
        border: @Border;
        font-family: '@GlobalFontFamily', sans-serif;
        
        /* ALINEACIÓN GLOBAL PARA TODOS LOS TEXTOS */
        text-align: @TextAlign; 
        
        overflow: hidden;
        transition: transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275), background-color 0.4s ease, box-shadow 0.4s ease;
        display: block;
    }

    #@cardId:hover {
        background-color: @BackgroundHoverColor !important;
        @((EnableHoverScale) ? "transform: scale(1.04); box-shadow: 0 15px 30px rgba(0,0,0,0.15);" : "")
    }

    /* Cambio de color global al hacer hover en el card */
    #@cardId:hover h2 { color: @TitleHoverColor !important; }
    #@cardId:hover h4 { color: @SubtitleHoverColor !important; }
    #@cardId:hover p { color: @TextHoverColor !important; }
    #@cardId:hover .description { color: @DescriptionHoverColor !important; }

    /* Asegurar que los textos no tengan márgenes raros que rompan la alineación */
    #@cardId h2, #@cardId h4, #@cardId p, #@cardId .description {
        margin-left: auto;
        margin-right: auto;
        transition: color 0.3s ease;
    }
</style>

<div id="@cardId" class="multi-card">
    @if (!string.IsNullOrEmpty(Title))
    {
        <h2 style="color:@TitleColor; font-size:@TitleSize; font-weight:@TitleWeight; margin-bottom: 0.5rem;">
            @((MarkupString)Title)
        </h2>
    }

    @if (!string.IsNullOrEmpty(Subtitle))
    {
        <h4 style="color:@SubtitleColor; font-size:@SubtitleSize; font-weight:@SubtitleWeight; margin-bottom: 1rem;">
            @((MarkupString)Subtitle)
        </h4>
    }

    @if (!string.IsNullOrEmpty(ExtraText))
    {
        <p style="color:@ExtraTextColor; font-size:@ExtraTextSize; font-weight:@ExtraTextWeight; margin-bottom: 1rem;">
            @((MarkupString)ExtraText)
        </p>
    }

    @if (!string.IsNullOrEmpty(Description))
    {
        <div class="description" style="color:@DescriptionColor; font-size:@DescriptionSize; font-weight:@DescriptionWeight; margin-bottom: 1.5rem;">
            @* APLICAMOS EL MARKUPSTRING PARA QUE LOS <br/> FUNCIONEN *@
            @((MarkupString)Description)
        </div>
    }

    @* El botón hereda la alineación del padre si no se especifica otra *@
    <div style="display: flex; justify-content: @(TextAlign == "center" ? "center" : (TextAlign == "right" ? "flex-end" : "flex-start"));">
        @if (!string.IsNullOrEmpty(ButtonText))
        {
            <ButtonLinkBlazor Text="@ButtonText" Url="@ButtonUrl" Color="@ButtonColor"
                              HoverColor="@ButtonHoverColor" TextColor="@ButtonTextColor"
                              BorderRadius="@ButtonBorderRadius" Padding="@ButtonPadding" />
        }
    </div>
</div>

@code {
    [Parameter] public string GlobalFontFamily { get; set; } = "";
    [Parameter] public string TextAlign { get; set; } = "left";
    [Parameter] public bool EnableHoverScale { get; set; } = false;
    
    [Parameter] public string BackgroundColor { get; set; } = "";
    [Parameter] public string BackgroundHoverColor { get; set; } = "";
    [Parameter] public string BackgroundImage { get; set; } = "";
    [Parameter] public string Padding { get; set; } = "";
    [Parameter] public string BorderRadius { get; set; } = "";
    [Parameter] public string Border { get; set; } = "";

    // Parámetros de texto...
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string TitleColor { get; set; } = "";
    [Parameter] public string TitleHoverColor { get; set; } = "";
    [Parameter] public string TitleSize { get; set; } = "";
    [Parameter] public string TitleWeight { get; set; } = "";

    [Parameter] public string Subtitle { get; set; } = "";
    [Parameter] public string SubtitleColor { get; set; } = "";
    [Parameter] public string SubtitleHoverColor { get; set; } = "";
    [Parameter] public string SubtitleSize { get; set; } = "";
    [Parameter] public string SubtitleWeight { get; set; } = "";

    [Parameter] public string ExtraText { get; set; } = "";
    [Parameter] public string ExtraTextColor { get; set; } = "";
    [Parameter] public string TextHoverColor { get; set; } = "";
    [Parameter] public string ExtraTextSize { get; set; } = "";
    [Parameter] public string ExtraTextWeight { get; set; } = "";

    [Parameter] public string Description { get; set; } = "";
    [Parameter] public string DescriptionColor { get; set; } = "";
    [Parameter] public string DescriptionHoverColor { get; set; } = "";
    [Parameter] public string DescriptionSize { get; set; } = "";
    [Parameter] public string DescriptionWeight { get; set; } = "";

    [Parameter] public string ButtonText { get; set; } = "";
    [Parameter] public string ButtonUrl { get; set; } = "";
    [Parameter] public string ButtonColor { get; set; } = "";
    [Parameter] public string ButtonHoverColor { get; set; } = "";
    [Parameter] public string ButtonTextColor { get; set; } = "";
    [Parameter] public string ButtonBorderRadius { get; set; } = "";
    [Parameter] public string ButtonPadding { get; set; } = "";
    [Parameter] public string ButtonPosition { get; set; } = "left";
}
