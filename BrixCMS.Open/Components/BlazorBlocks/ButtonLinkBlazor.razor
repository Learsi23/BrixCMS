@inject NavigationManager NavigationManager

@if (!string.IsNullOrEmpty(Url))
{
    <a href="@Url"
       class="button-link"
       style="background-color:@Color; color:@TextColor; border:@Border; border-radius:@BorderRadius; padding:@Padding; width:@Width; text-align:@ButtonPosition; display:inline-block; text-decoration:none;"
       onmouseover="this.style.backgroundColor='@HoverColor'"
       onmouseout="this.style.backgroundColor='@Color'">
        @Text
    </a>
}


@code {
    [Parameter] public string Text { get; set; }
    [Parameter] public string Url { get; set; }
    [Parameter] public string Color { get; set; }
    [Parameter] public string HoverColor { get; set; }
    [Parameter] public string BorderRadius { get; set; }
    [Parameter] public string Border { get; set; }
    [Parameter] public string Width { get; set; }
    [Parameter] public string Padding { get; set; }
    [Parameter] public string TextColor { get; set; }
    [Parameter] public string ButtonPosition { get; set; }

    private void NavigateToLink()
    {
        if (!string.IsNullOrWhiteSpace(Url))
        {
         
            if (Url.StartsWith("http", StringComparison.OrdinalIgnoreCase))
            {
                NavigationManager.NavigateTo(Url, forceLoad: true);
            }
            else
            {
               
                var relativeUrl = Url.StartsWith("/") ? Url : $"/{Url}";
                NavigationManager.NavigateTo(relativeUrl, forceLoad: false);
            }
        }
    }
}
