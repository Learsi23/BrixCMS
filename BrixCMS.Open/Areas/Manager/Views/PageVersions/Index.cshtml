@model List<BrixCMS.Open.Data.PageVersion>
@{
    ViewData["Title"] = "Page History";
    Layout = "_ManagerLayout";
    var page = ViewBag.Page as BrixCMS.Open.Data.Page;
    var success = ViewBag.Success as string;
    var error = ViewBag.Error as string;
}

<div class="p-6 max-w-[900px] mx-auto">

    <div class="mb-6 flex items-center gap-3">
        <div>
            <h1 class="text-2xl font-bold text-slate-800 flex items-center gap-2">
                <i class="fas fa-clock-rotate-left text-violet-500"></i> History — @(page?.Title ?? "page")
            </h1>
            <p class="text-slate-500 text-sm mt-1">
                A snapshot is saved automatically every time this page is published.
                Restoring saves your current version first, so you can always undo an undo.
            </p>
        </div>
        <a href="/Manager/Manager/Edit/@(page?.Id)" class="ml-auto text-sm font-semibold text-slate-500 hover:text-violet-600">
            <i class="fas fa-arrow-left"></i> Back to editor
        </a>
    </div>

    @if (!string.IsNullOrEmpty(success))
    {
        <div class="mb-4 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-800 px-4 py-3 text-sm flex items-center gap-3">
            <i class="fas fa-check-circle"></i> <span>@success</span>
        </div>
    }
    @if (!string.IsNullOrEmpty(error))
    {
        <div class="mb-4 rounded-xl bg-red-50 border border-red-200 text-red-700 px-4 py-3 text-sm flex items-center gap-2">
            <i class="fas fa-triangle-exclamation"></i> <span>@error</span>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="rounded-2xl border-2 border-dashed border-slate-200 p-10 text-center text-slate-400">
            No history yet — it starts recording the next time you publish this page.
        </div>
    }
    else
    {
        <div class="bg-white rounded-2xl shadow-sm border border-slate-100 divide-y divide-slate-100">
            @foreach (var v in Model)
            {
                var blockCount = System.Text.Json.JsonDocument.Parse(string.IsNullOrEmpty(v.BlocksJson) ? "[]" : v.BlocksJson).RootElement.GetArrayLength();
                <div class="p-4 flex items-center gap-4">
                    <div class="flex-1 min-w-0">
                        <div class="font-bold text-slate-700 text-sm">@v.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</div>
                        <div class="text-xs text-slate-400 mt-0.5">
                            @v.Label · @v.Title · @blockCount block(s)
                            @if (!string.IsNullOrEmpty(v.CreatedByEmail))
                            {
                                <span> · @v.CreatedByEmail</span>
                            }
                        </div>
                    </div>
                    <form asp-action="Restore" method="post"
                          onsubmit="return confirm('Restore the page to this version? Your current version will be saved first, so this can be undone.');">
                        <input type="hidden" name="pageId" value="@v.PageId" />
                        <input type="hidden" name="versionId" value="@v.Id" />
                        <button type="submit" class="bg-violet-600 hover:bg-violet-700 text-white px-4 py-2 rounded-lg text-sm font-bold transition">
                            Restore
                        </button>
                    </form>
                </div>
            }
        </div>
    }
</div>
