@model ConfiguracionViewModel
@using BrixCMS.Open.Models
@{
    ViewData["Title"] = "Navbar & Footer";
    Layout = "_ManagerLayout";

    var nav         = Model.SiteSettings.Navbar;
    var foot        = Model.SiteSettings.Footer;
    var socialList  = foot.SocialMedia ?? new List<SocialMediaConfig>();
    if (socialList.Count == 0) socialList = new List<SocialMediaConfig> { new SocialMediaConfig() };
    var menuItems   = nav.MenuItems   ?? new List<MenuItemConfig>();
    var footerPages = foot.Pages      ?? new List<MenuItemConfig>();
}

<div class="p-8 max-w-6xl mx-auto">
    <div class="mb-8">
        <h1 class="text-3xl font-black text-gray-900 mb-2">Navbar &amp; Footer</h1>
        <p class="text-gray-500">Customize the global navbar and footer of the site</p>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="bg-emerald-50 border border-emerald-200 text-emerald-700 px-4 py-3 rounded-xl mb-6 flex items-center gap-2">
            <i class="fas fa-check-circle text-emerald-600"></i> @TempData["Success"]
        </div>
    }

    <form asp-action="SaveSiteSettings" method="post">
        <div class="space-y-8">

            @* ── NAVBAR ── *@
            <div class="bg-white rounded-2xl border border-gray-200 shadow-sm overflow-hidden">
                <div class="bg-gradient-to-r from-blue-500 to-blue-600 px-6 py-4">
                    <h2 class="text-xl font-black text-white flex items-center gap-3">
                        <i class="fas fa-bars"></i> Navbar
                    </h2>
                </div>
                <div class="p-6 space-y-6">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div>
                            <label class="block text-xs font-black text-gray-500 uppercase mb-2">Background Color</label>
                            <div class="flex gap-2">
                                <input type="color" value="@nav.BackgroundColor"
                                       onchange="document.getElementById('navbarBgColor').value = this.value"
                                       class="h-10 w-14 rounded-lg border cursor-pointer" />
                                <input type="text" id="navbarBgColor" name="NavbarBackgroundColor"
                                       value="@nav.BackgroundColor"
                                       class="flex-1 px-3 py-2 text-sm border border-gray-200 rounded-lg font-mono" />
                            </div>
                        </div>
                        <div>
                            <label class="block text-xs font-black text-gray-500 uppercase mb-2">Text Color</label>
                            <div class="flex gap-2">
                                <input type="color" value="@nav.TextColor"
                                       onchange="document.getElementById('navbarTextColor').value = this.value"
                                       class="h-10 w-14 rounded-lg border cursor-pointer" />
                                <input type="text" id="navbarTextColor" name="NavbarTextColor"
                                       value="@nav.TextColor"
                                       class="flex-1 px-3 py-2 text-sm border border-gray-200 rounded-lg font-mono" />
                            </div>
                        </div>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div>
                            <label class="block text-xs font-black text-gray-500 uppercase mb-2">Logo URL</label>
                            <input type="text" name="NavbarLogo" value="@nav.Logo"
                                   class="w-full px-3 py-2 text-sm border border-gray-200 rounded-lg font-mono" />
                            @if (!string.IsNullOrEmpty(nav.Logo))
                            {
                                <img src="@nav.Logo" class="w-20 h-20 object-contain rounded-lg border mt-2" />
                            }
                        </div>
                        <div>
                            <label class="block text-xs font-black text-gray-500 uppercase mb-2">Logo Width</label>
                            <input type="text" name="NavbarLogoWidth" value="@nav.LogoWidth"
                                   placeholder="150px" class="w-full px-3 py-2 text-sm border border-gray-200 rounded-lg" />
                        </div>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                        <div>
                            <label class="block text-xs font-black text-gray-500 uppercase mb-2">Logo Alt Text</label>
                            <input type="text" name="NavbarLogoAltText" value="@nav.LogoAltText"
                                   placeholder="Logo" class="w-full px-3 py-2 text-sm border border-gray-200 rounded-lg" />
                        </div>
                        <div>
                            <label class="block text-xs font-black text-gray-500 uppercase mb-2">Logo Link</label>
                            <input type="text" name="NavbarLogoLink" value="@nav.LogoLink"
                                   placeholder="/" class="w-full px-3 py-2 text-sm border border-gray-200 rounded-lg" />
                        </div>
                        <div>
                            <label class="block text-xs font-black text-gray-500 uppercase mb-2">Vertical Padding</label>
                            <select name="NavbarPaddingVertical" class="w-full px-3 py-2 text-sm border border-gray-200 rounded-lg">
                                @{ string navPad = nav.PaddingVertical ?? "py-3"; }
                                @foreach (var opt in new[] { ("py-2", "Small (py-2)"), ("py-3", "Medium (py-3)"), ("py-4", "Large (py-4)") })
                                {
                                    <option value="@opt.Item1" selected="@(navPad == opt.Item1 ? "selected" : null)">@opt.Item2</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="flex items-center gap-6">
                        <label class="flex items-center gap-2">
                            <input type="checkbox" name="NavbarIsSticky" value="true"
                                   @(nav.IsSticky ? "checked" : "") class="w-4 h-4" />
                            <span class="text-sm">Sticky</span>
                        </label>
                        <label class="flex items-center gap-2">
                            <input type="checkbox" name="NavbarHasShadow" value="true"
                                   @(nav.HasShadow ? "checked" : "") class="w-4 h-4" />
                            <span class="text-sm">Shadow</span>
                        </label>
                    </div>

                    @* MENU ITEMS *@
                    <div class="border-t pt-6">
                        <div class="flex justify-between items-center mb-4">
                            <h3 class="font-bold text-gray-700">Menu Items</h3>
                            <button type="button" onclick="addMenuItem()"
                                    class="bg-blue-500 hover:bg-blue-600 text-white px-4 py-2 rounded-lg text-xs font-bold">
                                + Add Item
                            </button>
                        </div>
                        <p class="text-xs text-gray-400 mb-3">URL can be an internal path <code class="bg-gray-100 px-1 rounded">/about</code>, anchor <code class="bg-gray-100 px-1 rounded">#section</code>, or external link <code class="bg-gray-100 px-1 rounded">https://github.com</code></p>
                        <div id="menuItemsContainer" class="space-y-2">
                            @for (int i = 0; i < menuItems.Count; i++)
                            {
                                <div class="flex gap-3 items-center bg-gray-50 p-3 rounded-lg border border-gray-200 flex-wrap">
                                    <input type="hidden" name="MenuItems[@i].IsCustomUrl" value="true" />
                                    <div class="flex-1 min-w-[120px]">
                                        <label class="block text-xs text-gray-500 mb-1">Label</label>
                                        <input type="text" name="MenuItems[@i].CustomText" value="@menuItems[i].CustomText"
                                               placeholder="GitHub" class="w-full px-3 py-2 text-sm border border-gray-200 rounded-lg" />
                                    </div>
                                    <div class="flex-1 min-w-[160px]">
                                        <label class="block text-xs text-gray-500 mb-1">URL</label>
                                        <input type="text" name="MenuItems[@i].CustomUrl" value="@menuItems[i].CustomUrl"
                                               placeholder="/about  or  #section  or  https://..." class="w-full px-3 py-2 text-sm border border-gray-200 rounded-lg" />
                                    </div>
                                    <div class="flex flex-col items-center gap-1 mt-1">
                                        <label class="text-xs text-gray-500">New Tab</label>
                                        <input type="checkbox" name="MenuItems[@i].OpenInNewTab" value="true"
                                               @(menuItems[i].OpenInNewTab ? "checked" : "")
                                               class="w-4 h-4 rounded" />
                                    </div>
                                    <button type="button" onclick="this.closest('div.flex').remove()" class="text-red-500 hover:text-red-700 mt-4">
                                        <i class="fas fa-times"></i>
                                    </button>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            @* ── FOOTER ── *@
            <div class="bg-white rounded-2xl border border-gray-200 shadow-sm overflow-hidden">
                <div class="bg-gradient-to-r from-gray-700 to-gray-800 px-6 py-4">
                    <h2 class="text-xl font-black text-white flex items-center gap-3">
                        <i class="fas fa-align-justify"></i> Footer
                    </h2>
                </div>
                <div class="p-6 space-y-6">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div>
                            <label class="block text-xs font-black text-gray-500 uppercase mb-2">Background Color</label>
                            <div class="flex gap-2">
                                <input type="color" value="@foot.BackgroundColor"
                                       onchange="document.getElementById('footerBgColor').value = this.value"
                                       class="h-10 w-14 rounded-lg border cursor-pointer" />
                                <input type="text" id="footerBgColor" name="FooterBackgroundColor"
                                       value="@foot.BackgroundColor"
                                       class="flex-1 px-3 py-2 text-sm border border-gray-200 rounded-lg font-mono" />
                            </div>
                        </div>
                        <div>
                            <label class="block text-xs font-black text-gray-500 uppercase mb-2">Text Color</label>
                            <div class="flex gap-2">
                                <input type="color" value="@foot.TextColor"
                                       onchange="document.getElementById('footerTextColor').value = this.value"
                                       class="h-10 w-14 rounded-lg border cursor-pointer" />
                                <input type="text" id="footerTextColor" name="FooterTextColor"
                                       value="@foot.TextColor"
                                       class="flex-1 px-3 py-2 text-sm border border-gray-200 rounded-lg font-mono" />
                            </div>
                        </div>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                        <div>
                            <label class="block text-xs font-black text-gray-500 uppercase mb-2">Logo URL</label>
                            <input type="text" name="FooterLogo" value="@foot.Logo"
                                   class="w-full px-3 py-2 text-sm border border-gray-200 rounded-lg font-mono" />
                        </div>
                        <div>
                            <label class="block text-xs font-black text-gray-500 uppercase mb-2">Logo Width</label>
                            <input type="text" name="FooterLogoWidth" value="@foot.LogoWidth"
                                   placeholder="150px" class="w-full px-3 py-2 text-sm border border-gray-200 rounded-lg" />
                        </div>
                        <div>
                            <label class="block text-xs font-black text-gray-500 uppercase mb-2">Logo Position</label>
                            <select name="FooterLogoPosition" class="w-full px-3 py-2 text-sm border border-gray-200 rounded-lg">
                                @{ string logoPos = foot.LogoPosition ?? "left"; }
                                @foreach (var opt in new[] { ("left", "Left"), ("center", "Center"), ("right", "Right") })
                                {
                                    <option value="@opt.Item1" selected="@(logoPos == opt.Item1 ? "selected" : null)">@opt.Item2</option>
                                }
                            </select>
                        </div>
                    </div>

                    @* FOOTER PAGES COLUMN *@
                    <div class="border-t pt-6">
                        <div class="flex items-center gap-4 mb-4">
                            <label class="flex items-center gap-2">
                                <input type="checkbox" name="FooterShowPagesColumn" value="true"
                                       @(foot.ShowPagesColumn ? "checked" : "") class="w-4 h-4" />
                                <span class="text-sm font-bold text-gray-700">Show Pages Column</span>
                            </label>
                        </div>
                        <div class="mb-3">
                            <label class="block text-xs text-gray-500 uppercase mb-1">Column Title</label>
                            <input type="text" name="FooterPagesColumnTitle" value="@foot.PagesColumnTitle"
                                   placeholder="Pages" class="w-full md:w-64 px-3 py-2 text-sm border border-gray-200 rounded-lg" />
                        </div>
                        <div id="footerPagesContainer" class="space-y-2">
                            @for (int i = 0; i < footerPages.Count; i++)
                            {
                                <div class="flex gap-3 items-center bg-gray-50 p-3 rounded-lg border border-gray-200 flex-wrap">
                                    <input type="hidden" name="FooterPages[@i].IsCustomUrl" value="true" />
                                    <div class="flex-1 min-w-[120px]">
                                        <input type="text" name="FooterPages[@i].CustomText" value="@footerPages[i].CustomText"
                                               placeholder="Label" class="w-full px-3 py-2 text-sm border border-gray-200 rounded-lg" />
                                    </div>
                                    <div class="flex-1 min-w-[160px]">
                                        <input type="text" name="FooterPages[@i].CustomUrl" value="@footerPages[i].CustomUrl"
                                               placeholder="/url or https://..." class="w-full px-3 py-2 text-sm border border-gray-200 rounded-lg" />
                                    </div>
                                    <button type="button" onclick="this.closest('div.flex').remove()" class="text-red-500 hover:text-red-700">
                                        <i class="fas fa-times"></i>
                                    </button>
                                </div>
                            }
                        </div>
                        <button type="button" onclick="addFooterPage()"
                                class="mt-2 text-blue-500 hover:text-blue-700 text-sm font-bold">
                            + Add Page Link
                        </button>
                    </div>

                    @* SOCIAL MEDIA *@
                    <div class="border-t pt-6">
                        <div class="flex justify-between items-center mb-4">
                            <label class="flex items-center gap-2">
                                <input type="checkbox" name="FooterShowSocialMediaColumn" value="true"
                                       @(foot.ShowSocialMediaColumn ? "checked" : "") class="w-4 h-4" />
                                <span class="text-sm font-bold text-gray-700">Show Social Media</span>
                            </label>
                            <button type="button" onclick="addSocialMedia()"
                                    class="bg-blue-500 hover:bg-blue-600 text-white px-4 py-2 rounded-lg text-xs font-bold">
                                + Add
                            </button>
                        </div>
                        <div class="mb-3">
                            <label class="block text-xs text-gray-500 uppercase mb-1">Column Title</label>
                            <input type="text" name="FooterSocialMediaColumnTitle" value="@foot.SocialMediaColumnTitle"
                                   placeholder="Follow us" class="w-full md:w-64 px-3 py-2 text-sm border border-gray-200 rounded-lg" />
                        </div>
                        <div id="socialMediaContainer" class="space-y-3">
                            @for (int i = 0; i < socialList.Count; i++)
                            {
                                string p = socialList[i].Platform ?? "";
                                <div class="bg-gray-50 p-4 rounded-lg border border-gray-200 flex flex-col md:flex-row gap-3 items-center">
                                    <div class="flex-1 w-full">
                                        <label class="block text-xs text-gray-500 uppercase mb-1">Platform</label>
                                        <select name="SocialMedia[@i].Platform" class="w-full px-3 py-2 text-sm border border-gray-200 rounded-lg">
                                            @foreach (var s in new[] { ("", "Select..."), ("facebook", "Facebook"), ("instagram", "Instagram"), ("twitter", "Twitter/X"), ("linkedin", "LinkedIn"), ("youtube", "YouTube"), ("tiktok", "TikTok"), ("github", "GitHub"), ("custom", "Custom") })
                                            {
                                                <option value="@s.Item1" selected="@(p == s.Item1 ? "selected" : null)">@s.Item2</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="flex-1 w-full">
                                        <label class="block text-xs text-gray-500 uppercase mb-1">URL</label>
                                        <input type="text" name="SocialMedia[@i].Url" value="@socialList[i].Url"
                                               placeholder="https://..." class="w-full px-3 py-2 text-sm border border-gray-200 rounded-lg" />
                                    </div>
                                    <div class="flex-1 w-full">
                                        <label class="block text-xs text-gray-500 uppercase mb-1">Icon (FA class)</label>
                                        <input type="text" name="SocialMedia[@i].IconClass" value="@socialList[i].IconClass"
                                               placeholder="fab fa-github" class="w-full px-3 py-2 text-sm border border-gray-200 rounded-lg" />
                                    </div>
                                    <input type="hidden" name="SocialMedia[@i].IconType" value="class" />
                                    <button type="button" onclick="this.parentElement.remove()" class="text-red-500 hover:text-red-700 md:mt-5">
                                        <i class="fas fa-times"></i>
                                    </button>
                                </div>
                            }
                        </div>
                    </div>

                    @* COPYRIGHT *@
                    <div class="border-t pt-6">
                        <h3 class="font-bold text-gray-700 mb-4">Copyright</h3>
                        <div class="flex flex-wrap gap-6 mb-4">
                            <label class="flex items-center gap-2">
                                <input type="checkbox" name="FooterShowCopyrightRow" value="true"
                                       @(foot.ShowCopyrightRow ? "checked" : "") class="w-4 h-4" />
                                <span class="text-sm">Show copyright</span>
                            </label>
                            <label class="flex items-center gap-2">
                                <input type="checkbox" name="FooterShowHorizontalLine" value="true"
                                       @(foot.ShowHorizontalLine ? "checked" : "") class="w-4 h-4" />
                                <span class="text-sm">Horizontal line</span>
                            </label>
                        </div>
                        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                            <div>
                                <label class="block text-xs font-black text-gray-500 uppercase mb-2">Company</label>
                                <input type="text" name="CompanyName" value="@foot.CompanyName"
                                       placeholder="My Company" class="w-full px-3 py-2 text-sm border border-gray-200 rounded-lg" />
                            </div>
                            <div>
                                <label class="block text-xs font-black text-gray-500 uppercase mb-2">Company Number</label>
                                <input type="text" name="CompanyNumber" value="@foot.CompanyNumber"
                                       placeholder="B12345678" class="w-full px-3 py-2 text-sm border border-gray-200 rounded-lg" />
                            </div>
                            <div>
                                <label class="block text-xs font-black text-gray-500 uppercase mb-2">Copyright Text</label>
                                <input type="text" name="CopyrightText" value="@foot.CopyrightText"
                                       placeholder="All rights reserved" class="w-full px-3 py-2 text-sm border border-gray-200 rounded-lg" />
                            </div>
                        </div>
                    </div>

                    @* SPACING *@
                    <div class="border-t pt-6">
                        <h3 class="font-bold text-gray-700 mb-4">Spacing</h3>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                            <div>
                                <label class="block text-xs font-black text-gray-500 uppercase mb-2">Vertical Padding</label>
                                <select name="FooterPaddingVertical" class="w-full px-3 py-2 text-sm border border-gray-200 rounded-lg">
                                    @{ string footPad = foot.PaddingVertical ?? "py-6"; }
                                    @foreach (var opt in new[] { ("py-4", "Small (py-4)"), ("py-6", "Medium (py-6)"), ("py-10", "Large (py-10)") })
                                    {
                                        <option value="@opt.Item1" selected="@(footPad == opt.Item1 ? "selected" : null)">@opt.Item2</option>
                                    }
                                </select>
                            </div>
                            <div>
                                <label class="block text-xs font-black text-gray-500 uppercase mb-2">Columns Gap</label>
                                <select name="FooterColumnsGap" class="w-full px-3 py-2 text-sm border border-gray-200 rounded-lg">
                                    @{ string footGap = foot.ColumnsGap ?? "gap-8"; }
                                    @foreach (var opt in new[] { ("gap-4", "Small (gap-4)"), ("gap-8", "Medium (gap-8)"), ("gap-12", "Large (gap-12)") })
                                    {
                                        <option value="@opt.Item1" selected="@(footGap == opt.Item1 ? "selected" : null)">@opt.Item2</option>
                                    }
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="flex justify-end">
                <button type="submit"
                        class="bg-emerald-500 hover:bg-emerald-600 text-white px-8 py-3 rounded-xl font-bold text-sm shadow-lg">
                    <i class="fas fa-save mr-1"></i> Save Settings
                </button>
            </div>
        </div>
    </form>
</div>

<script>
    let menuCount       = @menuItems.Count;
    let footerPageCount = @footerPages.Count;
    let socialCount     = @socialList.Count;

    function addMenuItem() {
        const idx = menuCount++;
        document.getElementById('menuItemsContainer').insertAdjacentHTML('beforeend', `
            <div class="flex gap-3 items-center bg-gray-50 p-3 rounded-lg border border-gray-200 flex-wrap">
                <input type="hidden" name="MenuItems[${idx}].IsCustomUrl" value="true" />
                <div class="flex-1 min-w-[120px]">
                    <label class="block text-xs text-gray-500 mb-1">Label</label>
                    <input type="text" name="MenuItems[${idx}].CustomText" placeholder="GitHub"
                           class="w-full px-3 py-2 text-sm border border-gray-200 rounded-lg" />
                </div>
                <div class="flex-1 min-w-[160px]">
                    <label class="block text-xs text-gray-500 mb-1">URL</label>
                    <input type="text" name="MenuItems[${idx}].CustomUrl" placeholder="/about  or  #section  or  https://..."
                           class="w-full px-3 py-2 text-sm border border-gray-200 rounded-lg" />
                </div>
                <div class="flex flex-col items-center gap-1 mt-1">
                    <label class="text-xs text-gray-500">New Tab</label>
                    <input type="checkbox" name="MenuItems[${idx}].OpenInNewTab" value="true" class="w-4 h-4 rounded" />
                </div>
                <button type="button" onclick="this.closest('div.flex').remove()" class="text-red-500 hover:text-red-700 mt-4">
                    <i class="fas fa-times"></i>
                </button>
            </div>`);
    }

    function addFooterPage() {
        const idx = footerPageCount++;
        document.getElementById('footerPagesContainer').insertAdjacentHTML('beforeend', `
            <div class="flex gap-3 items-center bg-gray-50 p-3 rounded-lg border border-gray-200 flex-wrap">
                <input type="hidden" name="FooterPages[${idx}].IsCustomUrl" value="true" />
                <div class="flex-1 min-w-[120px]">
                    <input type="text" name="FooterPages[${idx}].CustomText" placeholder="Label"
                           class="w-full px-3 py-2 text-sm border border-gray-200 rounded-lg" />
                </div>
                <div class="flex-1 min-w-[160px]">
                    <input type="text" name="FooterPages[${idx}].CustomUrl" placeholder="/url or https://..."
                           class="w-full px-3 py-2 text-sm border border-gray-200 rounded-lg" />
                </div>
                <button type="button" onclick="this.closest('div.flex').remove()" class="text-red-500 hover:text-red-700">
                    <i class="fas fa-times"></i>
                </button>
            </div>`);
    }

    function addSocialMedia() {
        const idx = socialCount++;
        document.getElementById('socialMediaContainer').insertAdjacentHTML('beforeend', `
            <div class="bg-gray-50 p-4 rounded-lg border border-gray-200 flex flex-col md:flex-row gap-3 items-center">
                <div class="flex-1 w-full">
                    <label class="block text-xs text-gray-500 uppercase mb-1">Platform</label>
                    <select name="SocialMedia[${idx}].Platform" class="w-full px-3 py-2 text-sm border border-gray-200 rounded-lg">
                        <option value="">Select...</option>
                        <option value="facebook">Facebook</option>
                        <option value="instagram">Instagram</option>
                        <option value="twitter">Twitter/X</option>
                        <option value="linkedin">LinkedIn</option>
                        <option value="youtube">YouTube</option>
                        <option value="tiktok">TikTok</option>
                        <option value="github">GitHub</option>
                        <option value="custom">Custom</option>
                    </select>
                </div>
                <div class="flex-1 w-full">
                    <label class="block text-xs text-gray-500 uppercase mb-1">URL</label>
                    <input type="text" name="SocialMedia[${idx}].Url" placeholder="https://..."
                           class="w-full px-3 py-2 text-sm border border-gray-200 rounded-lg" />
                </div>
                <div class="flex-1 w-full">
                    <label class="block text-xs text-gray-500 uppercase mb-1">Icon (FA class)</label>
                    <input type="text" name="SocialMedia[${idx}].IconClass" placeholder="fab fa-github"
                           class="w-full px-3 py-2 text-sm border border-gray-200 rounded-lg" />
                </div>
                <input type="hidden" name="SocialMedia[${idx}].IconType" value="class" />
                <button type="button" onclick="this.parentElement.remove()" class="text-red-500 hover:text-red-700 md:mt-5">
                    <i class="fas fa-times"></i>
                </button>
            </div>`);
    }
</script>
