@using BrixCMS.Open.Components.BlazorBlocks
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    @* <base href="/" />     *@
    <title>BrixCMS</title>
    <link rel="icon" type="image/png" href="~/favicon.png" />
    <script src="https://cdn.tailwindcss.com"></script>
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <style>
        [x-cloak] {
            display: none !important;
        }

        #main-wrapper {
            min-height: 100vh;
        }
    </style>
</head>
<body class="font-sans">
    <div class="flex h-screen overflow-hidden">
        <aside class="w-60 bg-slate-900 text-white flex flex-col flex-shrink-0">
            @* Brand *@
            <div class="px-5 pt-6 pb-4 border-b border-white/10 group">
                <div class="flex items-center gap-2.5">
                    <!-- Logo mark -->
                    <div class="relative flex-shrink-0">
                        <div class="absolute inset-0 bg-emerald-500 rounded-xl blur-md opacity-0 group-hover:opacity-20 transition-opacity duration-500"></div>
                        <div class="relative bg-slate-800 rounded-xl p-1.5 border border-white/10">
                            <svg width="22" height="22" viewBox="0 0 18 18" fill="none">
                                <rect x="1" y="1" width="7" height="7" rx="1.5" fill="#22c55e"/>
                                <rect x="10" y="1" width="7" height="7" rx="1.5" fill="white" opacity="0.9"/>
                                <rect x="1" y="10" width="7" height="7" rx="1.5" fill="white" opacity="0.9"/>
                                <rect x="10" y="10" width="7" height="7" rx="1.5" fill="#22c55e" opacity="0.5"/>
                            </svg>
                        </div>
                    </div>

                    <!-- Wordmark -->
                    <div>
                        <p class="text-sm leading-none font-black tracking-tight">
                            <span class="text-white">BRIX</span><span style="color:#22c55e">cms</span>
                        </p>
                        <div class="flex items-center gap-1 mt-1">
                            <svg class="w-2 h-2 text-emerald-500" fill="currentColor" viewBox="0 0 8 8">
                                <circle cx="4" cy="4" r="4" />
                            </svg>
                            <p class="text-slate-500 text-[9px] font-medium truncate max-w-[6rem]">
                                @(Context.Session.GetString("AdminEmail") ?? "admin")
                            </p>
                        </div>
                    </div>
                </div>
            </div>

            @* Nav *@
            <nav class="flex-1 px-3 py-4 space-y-0.5">

                @{
                    var path = Context.Request.Path.Value ?? "";
                    string NavLink(string href, string icon, string label)
                    {
                        bool active = href == "/Manager"
                        ? (path.Equals("/Manager", StringComparison.OrdinalIgnoreCase) || path.Equals("/Manager/", StringComparison.OrdinalIgnoreCase))
                        : path.StartsWith(href, StringComparison.OrdinalIgnoreCase);
                        string cls = active
                            ? "bg-white/10 text-white"
                            : "text-slate-400 hover:bg-white/5 hover:text-white";
                        return $"<a href=\"{href}\" class=\"flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-semibold transition {cls}\"><i class=\"{icon} w-4 text-center text-xs\"></i> {label}</a>";
                    }
                }

                @{
                    var _role         = Context.Session.GetString("AdminRole") ?? "admin";
                    var _isFullAccess = _role is "owner" or "admin";
                    var _perms        = Context.Session.GetString("AdminPermissions") ?? "";
                    bool CanAccess(string p) => _isFullAccess || _perms.Contains($"\"{p}\"");
                }
                @Html.Raw(NavLink("/Manager", "fas fa-file-alt", "Pages"))
                @if (CanAccess("media"))         { @Html.Raw(NavLink("/Manager/Media",                 "fas fa-images",      "Media")) }
                @if (CanAccess("configuration")) { @Html.Raw(NavLink("/Manager/Configuration",         "fas fa-paint-brush", "Navbar &amp; Footer")) }
                @if (CanAccess("chatbot"))       { @Html.Raw(NavLink("/Manager/Configuration/Chatbot", "fas fa-robot",       "Chatbot")) }
                @if (CanAccess("backup"))        { @Html.Raw(NavLink("/Manager/Backup",                "fas fa-database",    "Backup")) }
                @Html.Raw(NavLink("/Manager/Admins", "fas fa-shield-alt", "Security"))

            </nav>

            @* Logout *@
            <div class="px-3 py-4 border-t border-white/5">
                <a href="/Manager/Login/Logout"
                   class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-semibold text-slate-400 hover:bg-red-500/10 hover:text-red-400 transition">
                    <i class="fas fa-sign-out-alt w-4 text-center text-xs"></i>
                    Logout
                </a>
            </div>

        </aside>
        <main id="main-wrapper" class="flex-1 overflow-y-auto">
            <div x-data="{ show: false }"
                 x-init="show = !localStorage.getItem('brix-gh-star-dismissed')"
                 x-show="show"
                 x-cloak
                 class="bg-slate-800/90 border-b border-emerald-500/20 px-5 py-2.5 flex items-center justify-between text-sm text-slate-300">
                <div class="flex items-center gap-2.5">
                    <svg class="w-4 h-4 text-yellow-400 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                        <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                    </svg>
                    <span>
                        Enjoying <strong class="text-white">BrixCMS</strong>?
                        <a href="https://github.com/Learsi23/BrixCMS" target="_blank" rel="noopener"
                           class="text-emerald-400 font-semibold hover:text-emerald-300 hover:underline transition-colors">
                            Star us on GitHub
                        </a>
                        — it takes 2 seconds and helps others discover the project!
                    </span>
                </div>
                <button @@click="show = false; localStorage.setItem('brix-gh-star-dismissed', '1')"
                        class="ml-4 flex-shrink-0 text-slate-500 hover:text-white transition-colors"
                        aria-label="Dismiss">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                    </svg>
                </button>
            </div>
            <div class="flex h-full">
                <div class="flex-1">
                    @RenderBody()
                </div>
            </div>
        </main>
    </div>

    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="/_framework/blazor.server.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
