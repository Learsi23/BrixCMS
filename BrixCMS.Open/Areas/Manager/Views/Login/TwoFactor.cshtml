@{
    Layout = null;
    ViewData["Title"] = "2FA Verification — BrixCMS";
    var returnUrl = ViewBag.ReturnUrl as string;
    var error = ViewBag.Error as string;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <style>
        body { background: #0f172a; }
        .glass {
            background: rgba(255,255,255,0.04);
            backdrop-filter: blur(20px);
            border: 1px solid rgba(255,255,255,0.08);
        }
        .dot-grid {
            background-image: radial-gradient(rgba(255,255,255,0.04) 1px, transparent 1px);
            background-size: 28px 28px;
        }
        .otp-input {
            background: rgba(255,255,255,0.05);
            border: 1px solid rgba(255,255,255,0.1);
            color: #e2e8f0;
            text-align: center;
            font-size: 1.5rem;
            font-weight: 900;
            letter-spacing: 0.5rem;
            transition: border-color .2s, box-shadow .2s;
        }
        .otp-input:focus {
            outline: none;
            border-color: #10b981;
            box-shadow: 0 0 0 3px rgba(16,185,129,0.15);
        }
        .otp-input::placeholder { color: #334155; letter-spacing: 0.3rem; }
    </style>
</head>
<body class="min-h-screen dot-grid flex items-center justify-center p-4">

    <div class="w-full max-w-sm">

        <div class="text-center mb-8">
            <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl mb-4"
                 style="background: linear-gradient(135deg,#6366f1,#4f46e5);">
                <i class="fas fa-shield-alt text-white text-2xl"></i>
            </div>
            <h1 class="text-2xl font-black text-white tracking-tight">2FA Verification</h1>
            <p class="text-slate-500 text-sm mt-1">Enter the code from your authenticator app</p>
        </div>

        <div class="glass rounded-3xl p-8">

            @if (!string.IsNullOrEmpty(error))
            {
                <div class="flex items-center gap-3 bg-red-500/10 border border-red-500/20 text-red-400 rounded-xl px-4 py-3 mb-6 text-sm">
                    <i class="fas fa-exclamation-circle flex-shrink-0"></i>
                    @error
                </div>
            }

            <form method="post" asp-action="TwoFactor" asp-route-returnUrl="@returnUrl">
                @Html.AntiForgeryToken()

                <div class="mb-6">
                    <label class="block text-xs font-bold text-slate-400 uppercase tracking-widest mb-3 text-center">
                        6-digit code
                    </label>
                    <input type="text" name="code" required maxlength="6" pattern="\d{6}"
                           inputmode="numeric" autocomplete="one-time-code"
                           placeholder="000000"
                           class="otp-input w-full py-4 rounded-xl"
                           autofocus />
                </div>

                <button type="submit"
                        class="w-full py-3 rounded-xl font-black text-white text-sm uppercase tracking-widest"
                        style="background: linear-gradient(135deg,#6366f1,#4f46e5);">
                    Verify
                </button>
            </form>

            <div class="mt-5 text-center">
                <a href="/Manager/Login/Index" class="text-slate-500 hover:text-slate-300 text-xs transition">
                    <i class="fas fa-arrow-left mr-1"></i> Back to login
                </a>
            </div>
        </div>

        <p class="text-center text-slate-600 text-xs mt-6">BrixCMS &copy; @DateTime.Now.Year</p>
    </div>
</body>
</html>
