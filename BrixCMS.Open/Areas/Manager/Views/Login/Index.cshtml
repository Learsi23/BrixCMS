@{
    Layout = null;
    ViewData["Title"] = "Access — BrixCMS";
    var returnUrl = ViewBag.ReturnUrl as string;
    var error = ViewBag.Error as string;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <style>
        body { background: #0f172a; }
        .glass {
            background: rgba(255,255,255,0.04);
            backdrop-filter: blur(20px);
            border: 1px solid rgba(255,255,255,0.08);
        }
        .input-field {
            background: rgba(255,255,255,0.05);
            border: 1px solid rgba(255,255,255,0.1);
            color: #e2e8f0;
            transition: border-color .2s, box-shadow .2s;
        }
        .input-field::placeholder { color: #475569; }
        .input-field:focus {
            outline: none;
            border-color: #10b981;
            box-shadow: 0 0 0 3px rgba(16,185,129,0.15);
        }
        .btn-primary {
            background: linear-gradient(135deg, #10b981, #059669);
            transition: all .2s;
        }
        .btn-primary:hover {
            background: linear-gradient(135deg, #059669, #047857);
            transform: translateY(-1px);
            box-shadow: 0 8px 25px rgba(16,185,129,0.4);
        }
        .dot-grid {
            background-image: radial-gradient(rgba(255,255,255,0.04) 1px, transparent 1px);
            background-size: 28px 28px;
        }
    </style>
</head>
<body class="min-h-screen dot-grid flex items-center justify-center p-4">

    <div class="w-full max-w-sm">

        @* Logo / Brand *@
        <div class="text-center mb-8">
            <div class="inline-flex items-center justify-center gap-1 mb-2">
                <div class="w-10 h-10 rounded-xl flex items-center justify-center"
                     style="background:linear-gradient(135deg,#1e293b,#0f172a);border:1px solid rgba(255,255,255,0.1);">
                    <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
                        <rect x="1" y="1" width="7" height="7" rx="1.5" fill="#22c55e"/>
                        <rect x="10" y="1" width="7" height="7" rx="1.5" fill="white" opacity="0.9"/>
                        <rect x="1" y="10" width="7" height="7" rx="1.5" fill="white" opacity="0.9"/>
                        <rect x="10" y="10" width="7" height="7" rx="1.5" fill="#22c55e" opacity="0.6"/>
                    </svg>
                </div>
            </div>
            <h1 class="text-3xl font-black tracking-tight leading-none">
                <span style="color:#ffffff">BRIX</span><span style="color:#22c55e">cms</span>
            </h1>
            <p class="text-slate-500 text-xs mt-2 uppercase tracking-widest font-semibold">Admin Panel</p>
        </div>

        @* Card *@
        <div class="glass rounded-3xl p-8">

            @if (!string.IsNullOrEmpty(error))
            {
                <div class="flex items-center gap-3 bg-red-500/10 border border-red-500/20 text-red-400 rounded-xl px-4 py-3 mb-6 text-sm">
                    <i class="fas fa-exclamation-circle flex-shrink-0"></i>
                    @error
                </div>
            }

            <form method="post" asp-action="Index" asp-route-returnUrl="@returnUrl">
                @Html.AntiForgeryToken()

                <div class="space-y-4">
                    <div>
                        <label class="block text-xs font-bold text-slate-400 uppercase tracking-widest mb-2">
                            Email
                        </label>
                        <div class="relative">
                            <i class="fas fa-envelope absolute left-3 top-1/2 -translate-y-1/2 text-slate-500 text-sm"></i>
                            <input type="email" name="email" required autocomplete="username"
                                   placeholder="admin@brix.com"
                                   class="input-field w-full pl-10 pr-4 py-3 rounded-xl text-sm" />
                        </div>
                    </div>

                    <div>
                        <label class="block text-xs font-bold text-slate-400 uppercase tracking-widest mb-2">
                            Password
                        </label>
                        <div class="relative" x-data="{ show: false }">
                            <i class="fas fa-lock absolute left-3 top-1/2 -translate-y-1/2 text-slate-500 text-sm"></i>
                            <input :type="show ? 'text' : 'password'" name="password" required autocomplete="current-password"
                                   placeholder="admin123"
                                   class="input-field w-full pl-10 pr-10 py-3 rounded-xl text-sm" />
                            <button type="button" @@click="show = !show"
                                    class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-500 hover:text-slate-300 transition">
                                <i class="fas text-sm" :class="show ? 'fa-eye-slash' : 'fa-eye'"></i>
                            </button>
                        </div>
                    </div>
                </div>

                <button type="submit"
                        class="btn-primary w-full mt-6 py-3 rounded-xl font-black text-white text-sm uppercase tracking-widest">
                    Sign In
                </button>
            </form>
        </div>

        <p class="text-center text-slate-700 text-xs mt-6 font-medium">
            <span style="color:#94a3b8">BRIX</span><span style="color:#22c55e">cms</span>
            <span class="text-slate-700 ml-1">&copy; @DateTime.Now.Year</span>
        </p>
    </div>

    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
</body>
</html>
