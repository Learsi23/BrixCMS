@using BrixCMS.Open.Services
@using BrixCMS.Open.Models.Base
@using System.Text.Json
@model BrixCMS.Open.Data.Page
@inject BlockRegistry Registry

@{
    Layout = null;
    ViewData["Title"] = "PREVIEW - " + Model.Title;

    var settings = JsonSerializer.Deserialize<Dictionary<string, JsonElement>>(Model.JsonData ?? "{}") ?? new();
    string bgColor = "#ffffff";
    if (settings.TryGetValue("BackgroundColor", out var colorElement))
    {
        if (colorElement.ValueKind == JsonValueKind.Object && colorElement.TryGetProperty("Value", out var valProp))
            bgColor = valProp.GetString() ?? "#ffffff";
        else if (colorElement.ValueKind == JsonValueKind.String)
            bgColor = colorElement.GetString() ?? "#ffffff";
    }

    var allBlocks = Model.Blocks.ToList();

    // Serialize ALL blocks (roots + children) for the publish script
    var allBlocksJson = @Html.Raw(JsonSerializer.Serialize(
    allBlocks
        .OrderBy(b => b.SortOrder)
        .Select(b => new { b.Type, b.JsonData, b.SortOrder, b.ParentId, OriginalId = b.Id.ToString() })
    ));

    // Safely escape page data for JS
    var titleJs = Model.Title.Replace("\\", "\\\\").Replace("'", "\\'");
    var slugJs = (Model.Slug ?? "").Replace("\\", "\\\\").Replace("'", "\\'");
    var jsonDataJs = (Model.JsonData ?? "{}").Replace("\\", "\\\\").Replace("'", "\\'");
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>PREVIEW - @Model.Title</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <style>
        [x-cloak] {
        display: none !important
        }
    </style>
</head>
<body>

    @* -- Preview Banner -- *@
    <div class="fixed top-0 left-0 right-0 bg-amber-500 text-white text-center py-3 z-50 shadow-lg flex items-center justify-center gap-4">
        <span><i class="fas fa-eye mr-1"></i> PREVIEW MODE</span>

        @* Publication status *@
        @if (Model.IsPublished)
        {
            <span class="bg-green-600 px-3 py-1 rounded-full text-xs font-bold">
                <i class="fas fa-check-circle mr-1"></i> Published — @Model.PublishedAt?.ToString("MM/dd/yyyy HH:mm")
            </span>
        }
        else
        {
            <span class="bg-gray-700 px-3 py-1 rounded-full text-xs font-bold">
                <i class="fas fa-pencil mr-1"></i> Draft
            </span>
        }

        <a href="/Manager/Manager/Edit/@Model.Id"
                class="underline font-bold text-sm">
            <i class="fas fa-arrow-left mr-1"></i> Back to Editor
        </a>

        <button onclick="publishFromPreview()"
                class="bg-green-600 px-4 py-1.5 rounded text-sm hover:bg-green-700 font-bold transition-colors">
            <i class="fas fa-globe mr-1"></i> Publish
        </button>
    </div>
    <div style="padding-top:60px"></div>

    @* -- Content -- *@
    <main style="background-color:@bgColor; min-height:calc(100vh - 60px); width:100%">
        <div class="container mx-auto px-4 py-10">

            @if (!allBlocks.Any(b => b.ParentId == null))
            {
                <div class="text-center py-20 text-gray-500">
                    <p><i class="fas fa-cube mr-1"></i> No blocks to display</p>
                    <a href="/Manager/Manager/Edit/@Model.Id" class="text-indigo-600"><i class="fas fa-arrow-left mr-1"></i> Back to editor</a>
                </div>
            }
            else
            {
                @foreach (var block in allBlocks.Where(b => b.ParentId == null).OrderBy(b => b.SortOrder))
                {
                    var blockModel = Registry.CreateModel(block);

                    var vd = new ViewDataDictionary(ViewData);
                    vd["RawBlock"] = block;
                    vd["Page"] = Model;
                    vd["IsPreview"] = true;
                    vd["AllBlocks"] = allBlocks; // ? Children available without touching DB

                    <div class="mb-10">
                        @if (blockModel != null)
                        {
                            @await Html.PartialAsync(Registry.GetViewPath(block.Type), blockModel, vd)
                        }
                        else
                        {
                            <div class="bg-red-50 border border-red-200 rounded p-4 text-red-700 text-sm">
                                ? Could not create model for: <code>@block.Type</code>
                            </div>
                        }
                    </div>
                }
            }

        </div>
    </main>

    <script>
        async function publishFromPreview() {
        if (!confirm('Publish this page? It will be publicly visible.')) return;

        const pageId = '@Model.Id';

        // ? ALL blocks (roots + children + grandchildren) serialized on server
        const blocks = @Html.Raw(allBlocksJson);

        const data = {
        Title:    '@Html.Raw(titleJs)',
        Slug:     '@Html.Raw(slugJs)',
        JsonData: '@Html.Raw(jsonDataJs)',
        Blocks:   blocks
        };

        // Button in loading state
        const btn = event.currentTarget;
        btn.disabled = true;
        btn.textContent = '? Publishing...';

        try {
        const res = await fetch(`/Manager/Manager/PublishPage?pageId=${pageId}`, {
        method:  'POST',
        headers: { 'Content-Type': 'application/json' },
        body:    JSON.stringify(data)
        });

        const result = await res.json();

        if (result.success) {
        btn.textContent = '? Published';
        btn.classList.replace('bg-green-600', 'bg-green-800');

        // Redirect to editor after 1 second
        setTimeout(() => {
        window.location.href = '/Manager/Manager/Edit/' + pageId;
        }, 1000);
        } else {
        alert('Error publishing: ' + result.error);
        btn.disabled = false;
        btn.textContent = 'Publish';
        } catch (e) {
        alert('Network error: ' + e.message);
        btn.disabled = false;
        btn.textContent = 'Publish';
        }
        } catch (e) {
        alert('? Network error: ' + e.message);
        btn.disabled = false;
        btn.textContent = '?? Publish';
        }
        }
    </script>

</body>
</html>
