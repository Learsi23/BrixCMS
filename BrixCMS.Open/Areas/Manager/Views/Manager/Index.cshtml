@using BrixCMS.Open.Data
@model IEnumerable<BrixCMS.Open.Data.Page>
@{
    Layout = "_ManagerLayout";
    var pages = Model.OrderBy(p => p.SortOrder).ToList();
}

<div class="container mx-auto px-12 mt-32">
    <div class="flex justify-between items-center mb-8">
        <div>
            <h2 class="text-3xl font-bold text-gray-800">Your Pages</h2>
            <p class="text-xs text-gray-400 mt-1">The first published page is the home page (<code>/</code>)</p>
        </div>
        <form asp-area="Manager" asp-controller="Manager" asp-action="CreatePage" method="post" class="flex gap-2 items-center">
            <input name="title" placeholder="Title of the new page..."
                   class="px-4 py-2 border rounded-lg outline-none" required />
            <select name="pageType"
                    class="px-3 py-2 border border-gray-200 rounded-lg text-sm text-gray-600 bg-white cursor-pointer">
                <option value="standard">?? Standard</option>
                <option value="product">??? Product</option>
            </select>

            <button type="submit" class="bg-emerald-600 text-white px-4 py-2 rounded-lg hover:bg-emerald-700">
                + New Page
            </button>
        </form>
    </div>

    <div class="bg-white rounded-xl shadow-sm border border-gray-200">
        <table class="w-full text-left">
            <thead class="bg-gray-50 border-b border-gray-200 text-gray-600 uppercase text-sm">
                <tr>
                    <th class="px-6 py-4 w-24">Order</th>
                    <th class="px-6 py-4">Title</th>
                    <th class="px-6 py-4">Type</th>
                    <th class="px-6 py-4">URL</th>
                    <th class="px-6 py-4">Status</th>
                    <th class="px-6 py-4 text-right">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-200">
                @if (pages.Any())
                {
                    @for (int i = 0; i < pages.Count; i++)
                    {
                        var p = pages[i];
                        <tr class="hover:bg-gray-50 transition">
                            <td class="px-6 py-4">
                                <div class="flex gap-1">
                                    @if (i > 0)
                                    {
                                        <form asp-area="Manager" asp-controller="Manager"
                                              asp-action="MovePage" method="post">
                                            <input type="hidden" name="pageId" value="@p.Id" />
                                            <input type="hidden" name="direction" value="up" />
                                            <button type="submit"
                                                    class="w-7 h-7 flex items-center justify-center bg-gray-100 hover:bg-gray-200 rounded text-xs">
                                                ?
                                            </button>
                                        </form>
                                    }
                                    @if (i < pages.Count - 1)
                                    {
                                        <form asp-area="Manager" asp-controller="Manager"
                                              asp-action="MovePage" method="post">
                                            <input type="hidden" name="pageId" value="@p.Id" />
                                            <input type="hidden" name="direction" value="down" />
                                            <button type="submit"
                                                    class="w-7 h-7 flex items-center justify-center bg-gray-100 hover:bg-gray-200 rounded text-xs">
                                                ?
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>

                            <td class="px-6 py-4 font-medium flex items-center gap-2">
                                @if (i == pages.FindIndex(x => x.IsPublished))
                                {
                                    <span class="bg-emerald-100 text-emerald-700 text-[9px] font-black uppercase px-2 py-0.5 rounded-full">
                                        ?? Home
                                    </span>
                                }
                                @p.Title
                            </td>

                            <td class="px-6 py-4">
                                @if (p.PageType == "product")
                                {
                                    <span class="bg-blue-100 text-blue-700 text-[9px] font-black uppercase px-2 py-1 rounded-full">
                                        ??? Product
                                    </span>
                                }
                                else
                                {
                                    <span class="bg-gray-100 text-gray-500 text-[9px] font-black uppercase px-2 py-1 rounded-full">
                                        ?? Standard
                                    </span>
                                }
                            </td>

                            <td class="px-6 py-4 text-gray-500 font-mono text-xs">/@p.Slug</td>

                            <td class="px-6 py-4">
                                @if (p.IsPublished)
                                {
                                    <span class="bg-green-100 text-green-700 text-[10px] font-bold px-2 py-1 rounded-full">
                                        ? Published
                                    </span>
                                }
                                else
                                {
                                    <span class="bg-gray-100 text-gray-500 text-[10px] font-bold px-2 py-1 rounded-full">
                                        ?? Draft
                                    </span>
                                }
                            </td>

                            <td class="px-6 py-4 text-right flex justify-end gap-3 items-center">
                                @if (p.IsPublished)
                                {
                                    <a href="/@p.Slug" target="_blank"
                                           class="text-emerald-600 hover:underline text-sm">
                                        ?? View
                                    </a>
                                }
                                <a asp-area="Manager" asp-controller="Manager"
                                       asp-action="Edit" asp-route-id="@p.Id"
                                       class="text-blue-600 hover:underline text-sm">
                                    Edit
                                </a>
                                <form asp-area="Manager" asp-controller="Manager"
                                      asp-action="DeletePage" asp-route-id="@p.Id"
                                      method="post"
                                      onsubmit="return confirm('Delete this page and all its blocks?')">
                                    <button type="submit" class="text-red-500 hover:text-red-700 text-sm font-medium">
                                        Delete
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="px-6 py-10 text-center text-gray-400">
                            No pages yet.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
