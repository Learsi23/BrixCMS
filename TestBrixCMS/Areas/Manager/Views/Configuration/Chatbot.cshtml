@{
    ViewData["Title"] = "Chatbot & Security";
    Layout = "_ManagerLayout";

    var pdfFiles = ViewBag.PdfFiles as List<PdfFileInfo> ?? new();
    var twoFactorEnabled = (bool)(ViewBag.TwoFactorEnabled ?? false);
    var ollamaUrl   = ViewBag.OllamaUrl   as string ?? "http://localhost:11434";
    var ollamaModel = ViewBag.OllamaModel as string ?? "llama3.2:3b";
}

<div class="p-8 max-w-5xl mx-auto space-y-8">

    <div class="mb-2">
        <h1 class="text-3xl font-black text-gray-900 mb-2">Chatbot &amp; Security</h1>
        <p class="text-gray-500">Configure the PDF chatbot, Ollama connection and account settings</p>
    </div>

    @if (TempData["ChatbotSuccess"] != null)
    {
        <div class="bg-emerald-50 border border-emerald-200 text-emerald-700 px-4 py-3 rounded-xl flex items-center gap-2">
            <i class="fas fa-check-circle text-emerald-600"></i> @TempData["ChatbotSuccess"]
        </div>
    }
    @if (TempData["ChatbotError"] != null)
    {
        <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-xl flex items-center gap-2">
            <i class="fas fa-times-circle text-red-600"></i> @TempData["ChatbotError"]
        </div>
    }
    @* ── OLLAMA CONFIG ── *@
    <div class="bg-white rounded-2xl border border-gray-200 shadow-sm overflow-hidden">
        <div class="bg-gradient-to-r from-violet-500 to-purple-600 px-6 py-4">
            <h2 class="text-xl font-black text-white flex items-center gap-3">
                <i class="fas fa-robot"></i> Ollama Configuration
            </h2>
            <p class="text-violet-100 text-sm mt-1">Local AI — runs entirely on your machine, no API key needed</p>
        </div>
        <div class="p-6 space-y-6">

            @* URL *@
            <div>
                <label class="block text-xs font-black text-gray-500 uppercase mb-2">Ollama URL</label>
                <input type="text" id="ollamaUrl" value="@ollamaUrl"
                       placeholder="http://localhost:11434"
                       class="w-full px-3 py-2 text-sm border border-gray-200 rounded-lg font-mono" />
                <p class="text-xs text-gray-400 mt-1">Default: http://localhost:11434</p>
            </div>

            @* MODEL SELECT *@
            <div>
                <label class="block text-xs font-black text-gray-500 uppercase mb-2">Model</label>
                <div class="flex gap-3">
                    <select id="ollamaModelSelect"
                            class="flex-1 px-3 py-2 text-sm border border-gray-200 rounded-lg font-mono">
                        <option value="">— Load models —</option>
                    </select>
                    <button type="button" id="loadModelsBtn" onclick="loadOllamaModels()"
                            class="bg-violet-100 hover:bg-violet-200 text-violet-700 px-4 py-2 rounded-xl font-bold text-sm whitespace-nowrap">
                        <i class="fas fa-sync-alt mr-1"></i> Refresh
                    </button>
                </div>
                <p id="modelsStatus" class="text-xs text-gray-400 mt-1">Click Refresh to list installed models</p>
            </div>

            @* SELECTED MODEL BADGE *@
            <div id="selectedModelBadge" class="hidden">
                <div class="flex items-center gap-3 bg-violet-50 border border-violet-200 rounded-xl px-4 py-3">
                    <div class="w-8 h-8 bg-violet-500 rounded-full flex items-center justify-center">
                        <i class="fas fa-check text-white text-sm"></i>
                    </div>
                    <div>
                        <p class="text-xs text-violet-500 font-bold uppercase">Active model</p>
                        <p id="selectedModelName" class="text-sm font-black text-violet-800 font-mono"></p>
                    </div>
                </div>
            </div>

            @* DOWNLOAD MODEL *@
            <div class="border-t pt-5">
                <h3 class="text-sm font-bold text-gray-700 mb-3 flex items-center gap-2">
                    <i class="fas fa-download text-violet-500"></i> Download Model
                </h3>
                <div class="flex flex-wrap gap-2 mb-4">
                    <button type="button" onclick="pullModel('llama3.2')"
                            class="bg-gray-100 hover:bg-gray-200 text-gray-700 px-3 py-1.5 rounded-lg text-xs font-bold border border-gray-200">
                        Llama 3.2
                    </button>
                    <button type="button" onclick="pullModel('llama3.2:3b')"
                            class="bg-gray-100 hover:bg-gray-200 text-gray-700 px-3 py-1.5 rounded-lg text-xs font-bold border border-gray-200">
                        Llama 3.2 3B
                    </button>
                    <button type="button" onclick="pullModel('phi3')"
                            class="bg-gray-100 hover:bg-gray-200 text-gray-700 px-3 py-1.5 rounded-lg text-xs font-bold border border-gray-200">
                        Phi-3
                    </button>
                    <button type="button" onclick="pullModel('gemma2:2b')"
                            class="bg-gray-100 hover:bg-gray-200 text-gray-700 px-3 py-1.5 rounded-lg text-xs font-bold border border-gray-200">
                        Gemma 2 2B
                    </button>
                    <button type="button" onclick="pullModel('qwen2.5:1.5b')"
                            class="bg-gray-100 hover:bg-gray-200 text-gray-700 px-3 py-1.5 rounded-lg text-xs font-bold border border-gray-200">
                        Qwen 2.5 1.5B
                    </button>
                    <button type="button" onclick="pullModel('mistral')"
                            class="bg-gray-100 hover:bg-gray-200 text-gray-700 px-3 py-1.5 rounded-lg text-xs font-bold border border-gray-200">
                        Mistral
                    </button>
                </div>
                <div class="flex gap-2">
                    <input type="text" id="customModelInput" placeholder="Or type any model name…"
                           class="flex-1 px-3 py-2 text-sm border border-gray-200 rounded-lg font-mono" />
                    <button type="button" id="pullCustomBtn" onclick="pullModelFromInput()"
                            class="bg-violet-600 hover:bg-violet-700 text-white px-5 py-2 rounded-xl font-bold text-sm whitespace-nowrap">
                        <i class="fas fa-cloud-download-alt mr-1"></i> Download
                    </button>
                </div>
                <div id="pullStatus" class="mt-3 hidden">
                    <div class="flex items-center gap-2 bg-gray-50 border border-gray-200 rounded-xl px-4 py-3">
                        <i id="pullIcon" class="fas fa-spinner fa-spin text-violet-500"></i>
                        <span id="pullText" class="text-sm text-gray-600"></span>
                    </div>
                </div>
            </div>

            @* SAVE BUTTON + OLLAMA LINK *@
            <div class="flex items-center gap-4">
                <form asp-action="SaveOllamaConfig" method="post" class="flex gap-3 flex-1">
                    <input type="hidden" name="url" id="ollamaUrlHidden" value="@ollamaUrl" />
                    <input type="hidden" name="model" id="ollamaModelHidden" value="@ollamaModel" />
                    <button type="submit" id="saveOllamaBtn"
                            class="bg-violet-600 hover:bg-violet-700 text-white px-6 py-2.5 rounded-xl font-bold text-sm">
                        <i class="fas fa-save mr-1"></i> Save Configuration
                    </button>
                </form>
                <a href="https://ollama.com" target="_blank"
                   class="text-sm text-violet-600 hover:text-violet-800 font-semibold">
                    Download Ollama →
                </a>
            </div>
        </div>
    </div>

    @* ── PDF FILES ── *@
    <div class="bg-white rounded-2xl border border-gray-200 shadow-sm overflow-hidden">
        <div class="bg-gradient-to-r from-amber-500 to-orange-500 px-6 py-4 flex items-center justify-between">
            <div>
                <h2 class="text-xl font-black text-white flex items-center gap-3">
                    <i class="fas fa-file-pdf"></i> PDF Knowledge Base
                </h2>
                <p class="text-amber-100 text-sm mt-1">@pdfFiles.Count PDF(s) indexed — used by the chatbot to answer questions</p>
            </div>
        </div>
        <div class="p-6 space-y-4">
            @* Upload *@
            <form asp-action="UploadPdf" method="post" enctype="multipart/form-data">
                <div class="flex gap-3 items-center">
                    <input type="file" name="file" accept=".pdf"
                           class="flex-1 px-3 py-2 text-sm border border-gray-200 rounded-lg bg-gray-50" />
                    <button type="submit"
                            class="bg-amber-500 hover:bg-amber-600 text-white px-5 py-2.5 rounded-xl font-bold text-sm whitespace-nowrap">
                        <i class="fas fa-upload mr-1"></i> Upload & Index
                    </button>
                </div>
            </form>

            @* File List *@
            @if (pdfFiles.Count == 0)
            {
                <div class="text-center py-10 text-gray-400">
                    <i class="fas fa-file-pdf text-4xl mb-3 block opacity-30"></i>
                    <p class="text-sm">No PDFs uploaded yet. Upload a PDF to power the chatbot.</p>
                </div>
            }
            else
            {
                <div class="space-y-2">
                    @foreach (var pdf in pdfFiles)
                    {
                        <div class="flex items-center justify-between bg-gray-50 border border-gray-200 rounded-xl px-4 py-3">
                            <div class="flex items-center gap-3">
                                <i class="fas fa-file-pdf text-red-500 text-lg"></i>
                                <div>
                                    <p class="text-sm font-semibold text-gray-800">@pdf.Name</p>
                                    <p class="text-xs text-gray-400">@pdf.FormattedSize · @pdf.LastModified.ToString("dd MMM yyyy HH:mm")</p>
                                </div>
                            </div>
                            <form asp-action="DeletePdf" method="post" onsubmit="return confirm('Delete this PDF?')">
                                <input type="hidden" name="fileName" value="@pdf.Name" />
                                <button type="submit" class="text-red-400 hover:text-red-600 text-sm font-bold">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </form>
                        </div>
                    }
                </div>

                <form asp-action="ReingestAll" method="post">
                    <button type="submit"
                            class="w-full mt-2 bg-gray-100 hover:bg-gray-200 text-gray-700 px-4 py-2.5 rounded-xl font-bold text-sm border border-gray-200">
                        <i class="fas fa-sync-alt mr-2"></i> Re-index All PDFs
                    </button>
                </form>
            }
        </div>
    </div>

</div>

<script>
    const currentModel = '@ollamaModel';
    const ollamaUrl = '@ollamaUrl';

    // ── Ollama models ──
    async function loadOllamaModels() {
        const select = document.getElementById('ollamaModelSelect');
        const status = document.getElementById('modelsStatus');
        const btn    = document.getElementById('loadModelsBtn');
        const url    = document.getElementById('ollamaUrl').value.trim() || 'http://localhost:11434';

        btn.disabled = true;
        btn.innerHTML = '<i class="fas fa-spinner fa-spin mr-1"></i> Loading…';
        status.textContent = 'Connecting to Ollama…';

        try {
            const res  = await fetch(`/Manager/Configuration/GetOllamaModels?url=${encodeURIComponent(url)}`);
            const data = await res.json();

            select.innerHTML = '';

            if (!data.ok || !data.models.length) {
                select.innerHTML = '<option value="">No models found</option>';
                status.textContent = data.error || 'No models installed. Download one below.';
                return;
            }

            data.models.forEach(m => {
                const opt = document.createElement('option');
                opt.value = m;
                opt.textContent = m;
                if (m === currentModel) opt.selected = true;
                select.appendChild(opt);
            });

            status.textContent = `${data.models.length} model(s) found`;
            updateSelectedBadge(currentModel);
        } catch {
            select.innerHTML = '<option value="">Connection failed</option>';
            status.textContent = 'Cannot connect to Ollama. Make sure it is running.';
        } finally {
            btn.disabled = false;
            btn.innerHTML = '<i class="fas fa-sync-alt mr-1"></i> Refresh';
        }
    }

    function updateSelectedBadge(model) {
        const badge = document.getElementById('selectedModelBadge');
        const name  = document.getElementById('selectedModelName');
        const hidden = document.getElementById('ollamaModelHidden');

        if (model) {
            badge.classList.remove('hidden');
            name.textContent = model;
            hidden.value = model;
        } else {
            badge.classList.add('hidden');
            hidden.value = '';
        }
    }

    document.getElementById('ollamaModelSelect').addEventListener('change', function () {
        updateSelectedBadge(this.value);
    });

    document.getElementById('ollamaUrl').addEventListener('change', function () {
        document.getElementById('ollamaUrlHidden').value = this.value;
    });

    async function pullModel(modelName) {
        if (!modelName) return;
        const status = document.getElementById('pullStatus');
        const icon   = document.getElementById('pullIcon');
        const text   = document.getElementById('pullText');
        const btn    = document.getElementById('pullCustomBtn');

        status.classList.remove('hidden');
        icon.className = 'fas fa-spinner fa-spin text-violet-500';
        text.textContent = `Downloading ${modelName}… This may take a while.`;
        btn.disabled = true;
        btn.innerHTML = '<i class="fas fa-spinner fa-spin mr-1"></i> Downloading…';

        try {
            const res = await fetch('/Manager/Configuration/PullOllamaModel', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '' },
                body: JSON.stringify({ model: modelName })
            });
            const data = await res.json();

            if (data.ok) {
                icon.className = 'fas fa-check text-emerald-500';
                text.textContent = `Model "${modelName}" downloaded successfully!`;
                loadOllamaModels();
            } else {
                icon.className = 'fas fa-times text-red-500';
                text.textContent = `Error: ${data.error}`;
            }
        } catch (e) {
            icon.className = 'fas fa-times text-red-500';
            text.textContent = `Error: ${e.message}`;
        } finally {
            btn.disabled = false;
            btn.innerHTML = '<i class="fas fa-cloud-download-alt mr-1"></i> Download';
        }
    }

    function pullModelFromInput() {
        const input = document.getElementById('customModelInput');
        const model = input.value.trim();
        if (model) {
            pullModel(model);
            input.value = '';
        }
    }

    document.getElementById('customModelInput').addEventListener('keydown', function (e) {
        if (e.key === 'Enter') pullModelFromInput();
    });

    // Auto-load models on page ready
    document.addEventListener('DOMContentLoaded', () => {
        loadOllamaModels();
    });
</script>
