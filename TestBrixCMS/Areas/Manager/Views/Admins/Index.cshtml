@model List<TestBrixCMS.Data.AdminUser>
@{
    Layout = "_ManagerLayout";
    ViewData["Title"] = "Team & Security";
    var currentEmail     = ViewBag.CurrentEmail as string ?? "";
    var twoFactorEnabled = (bool)(ViewBag.TwoFactorEnabled ?? false);
    var isOwner          = (bool)(ViewBag.IsOwner ?? false);
}

<div class="p-8 max-w-4xl mx-auto" x-data="{ showHowModal: false, show2fa: false }">

    @* ── HOW IT WORKS MODAL ── *@
    <div x-show="showHowModal" x-cloak
         class="fixed inset-0 z-50 flex items-center justify-center bg-black/50 backdrop-blur-sm p-4"
         @@click.self="showHowModal = false">
        <div class="bg-white rounded-2xl shadow-2xl max-w-lg w-full p-8" @@click.stop>
            <div class="flex items-center justify-between mb-6">
                <h2 class="text-xl font-black text-slate-800 flex items-center gap-2">
                    <i class="fas fa-users text-blue-500"></i> How Team Access Works
                </h2>
                <button @@click="showHowModal = false" class="text-slate-400 hover:text-slate-600 transition">
                    <i class="fas fa-times text-lg"></i>
                </button>
            </div>
            <div class="space-y-4 text-sm text-slate-600">
                <div class="flex gap-3 p-3 bg-amber-50 rounded-xl border border-amber-100">
                    <span class="text-amber-500 mt-0.5"><i class="fas fa-crown"></i></span>
                    <div>
                        <p class="font-semibold text-slate-800">Owner (you)</p>
                        <p class="mt-0.5">Full access to everything, including managing team members and deleting accounts. There is always exactly one owner and it cannot be removed.</p>
                    </div>
                </div>
                <div class="flex gap-3 p-3 bg-slate-50 rounded-xl border border-slate-100">
                    <span class="text-slate-500 mt-0.5"><i class="fas fa-user"></i></span>
                    <div>
                        <p class="font-semibold text-slate-800">Admin</p>
                        <p class="mt-0.5">Can manage pages, media, chatbot, and backups. Cannot add or remove other admins.</p>
                    </div>
                </div>
                <div class="flex gap-3 p-3 bg-blue-50 rounded-xl border border-blue-100">
                    <span class="text-blue-500 mt-0.5"><i class="fas fa-key"></i></span>
                    <div>
                        <p class="font-semibold text-slate-800">Each admin has their own credentials</p>
                        <p class="mt-0.5">Login by email. Each person changes their own password from this page. 2FA is per-account.</p>
                    </div>
                </div>
                <div class="flex gap-3 p-3 bg-emerald-50 rounded-xl border border-emerald-100">
                    <span class="text-emerald-500 mt-0.5"><i class="fas fa-shield-alt"></i></span>
                    <div>
                        <p class="font-semibold text-slate-800">Want white-label or SSO?</p>
                        <p class="mt-0.5">Advanced access control, custom roles, and SSO are available in <strong>BrixCMS Pro</strong>.</p>
                    </div>
                </div>
            </div>
            <button @@click="showHowModal = false"
                    class="mt-6 w-full py-2.5 bg-slate-900 text-white rounded-xl font-semibold text-sm hover:bg-slate-700 transition">
                Got it
            </button>
        </div>
    </div>

    @* ── HEADER ── *@
    <div class="flex items-center justify-between mb-8">
        <div>
            <h1 class="text-2xl font-bold text-slate-800">Team & Security</h1>
            <p class="text-sm text-slate-500 mt-1">Manage team members and your account security.</p>
        </div>
        <button @@click="showHowModal = true"
                class="flex items-center gap-2 text-sm text-slate-500 hover:text-slate-700 border border-slate-200 px-3 py-2 rounded-xl hover:bg-slate-50 transition">
            <i class="fas fa-circle-question"></i> How it works
        </button>
    </div>

    @* ── FLASH MESSAGES ── *@
    @if (TempData["Success"] != null)
    {
        <div class="mb-6 px-4 py-3 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-700 text-sm font-medium flex items-center gap-2">
            <i class="fas fa-check-circle"></i> @TempData["Success"]
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="mb-6 px-4 py-3 rounded-xl bg-red-50 border border-red-200 text-red-700 text-sm font-medium flex items-center gap-2">
            <i class="fas fa-times-circle"></i> @TempData["Error"]
        </div>
    }
    @if (TempData["AccountSuccess"] != null)
    {
        <div class="mb-6 px-4 py-3 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-700 text-sm font-medium flex items-center gap-2">
            <i class="fas fa-check-circle"></i> @TempData["AccountSuccess"]
        </div>
    }
    @if (TempData["AccountError"] != null)
    {
        <div class="mb-6 px-4 py-3 rounded-xl bg-red-50 border border-red-200 text-red-700 text-sm font-medium flex items-center gap-2">
            <i class="fas fa-times-circle"></i> @TempData["AccountError"]
        </div>
    }

    @* ── TEAM TABLE (owner only) ── *@
    @if (isOwner)
    {
        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm mb-6 overflow-hidden">
            <div class="px-6 py-4 border-b border-slate-100 flex items-center justify-between">
                <h2 class="text-sm font-semibold text-slate-700">Team members (@Model.Count)</h2>
            </div>
            <table class="w-full text-sm">
                <thead>
                    <tr class="bg-slate-50 text-slate-500 text-xs uppercase tracking-wide">
                        <th class="px-6 py-3 text-left font-semibold">Name</th>
                        <th class="px-6 py-3 text-left font-semibold">Email</th>
                        <th class="px-6 py-3 text-left font-semibold">Role</th>
                        <th class="px-6 py-3 text-left font-semibold">2FA</th>
                        <th class="px-6 py-3 text-right font-semibold">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @foreach (var admin in Model)
                    {
                        var isMe = string.Equals(admin.Email, currentEmail, StringComparison.OrdinalIgnoreCase);
                        <tr class="hover:bg-slate-50 transition-colors">
                            <td class="px-6 py-4 font-medium text-slate-800">
                                @(string.IsNullOrWhiteSpace(admin.Name) ? "—" : admin.Name)
                                @if (isMe)
                                {
                                    <span class="ml-2 text-[10px] bg-blue-100 text-blue-600 px-2 py-0.5 rounded-full font-semibold">you</span>
                                }
                            </td>
                            <td class="px-6 py-4 text-slate-600">@admin.Email</td>
                            <td class="px-6 py-4">
                                @if (admin.IsOwner)
                                {
                                    <span class="inline-flex items-center gap-1 text-xs bg-amber-50 text-amber-700 border border-amber-200 px-2.5 py-1 rounded-full font-semibold">
                                        <i class="fas fa-crown text-[9px]"></i> Owner
                                    </span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center gap-1 text-xs bg-slate-100 text-slate-600 px-2.5 py-1 rounded-full font-medium">Admin</span>
                                }
                            </td>
                            <td class="px-6 py-4">
                                @if (admin.TwoFactorEnabled)
                                {
                                    <span class="inline-flex items-center gap-1 text-xs bg-emerald-50 text-emerald-700 px-2 py-0.5 rounded-full font-medium">
                                        <i class="fas fa-shield-alt text-[9px]"></i> On
                                    </span>
                                }
                                else
                                {
                                    <span class="text-xs text-slate-400">Off</span>
                                }
                            </td>
                            <td class="px-6 py-4 text-right">
                                @if (!admin.IsOwner && !isMe)
                                {
                                    <form method="post" asp-action="Delete" asp-route-id="@admin.Id"
                                          onsubmit="return confirm('Remove @admin.Email from the team?')">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="text-xs text-red-500 hover:text-red-700 font-medium transition-colors">
                                            Remove
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <span class="text-xs text-slate-300">—</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @* Add admin *@
        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden mb-8">
            <div class="px-6 py-4 border-b border-slate-100">
                <h2 class="text-sm font-semibold text-slate-700">Add team member</h2>
            </div>
            <form method="post" asp-action="Create" class="px-6 py-5 space-y-4">
                @Html.AntiForgeryToken()
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <div>
                        <label class="block text-xs font-semibold text-slate-600 mb-1.5">Name</label>
                        <input type="text" name="name" placeholder="Jane Smith"
                               class="w-full px-3 py-2.5 rounded-xl border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-400 transition" />
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-600 mb-1.5">Email <span class="text-red-400">*</span></label>
                        <input type="email" name="email" placeholder="admin@company.com" required
                               class="w-full px-3 py-2.5 rounded-xl border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-400 transition" />
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-600 mb-1.5">Password <span class="text-red-400">*</span></label>
                        <input type="password" name="password" placeholder="Min. 8 characters" required minlength="8"
                               class="w-full px-3 py-2.5 rounded-xl border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-400 transition" />
                    </div>
                </div>
                <div class="flex justify-end">
                    <button type="submit"
                            class="px-5 py-2.5 bg-slate-900 text-white text-sm font-semibold rounded-xl hover:bg-slate-700 transition-colors">
                        Add member
                    </button>
                </div>
            </form>
        </div>
    }

    @* ── ACCOUNT SECURITY (every admin sees their own) ── *@
    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
        <div class="px-6 py-4 border-b border-slate-100">
            <h2 class="text-sm font-semibold text-slate-700 flex items-center gap-2">
                <i class="fas fa-shield-alt text-slate-400"></i> My Account Security
            </h2>
            <p class="text-xs text-slate-400 mt-0.5">Signed in as <strong>@currentEmail</strong></p>
        </div>

        <div class="p-6 grid grid-cols-1 md:grid-cols-2 gap-8">

            @* Change Email *@
            <div>
                <h3 class="text-sm font-bold text-slate-700 mb-4">Change Email</h3>
                <form asp-controller="Configuration" asp-action="ChangeEmail" method="post" class="space-y-3">
                    @Html.AntiForgeryToken()
                    <div>
                        <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wide mb-1.5">New Email</label>
                        <input type="email" name="newEmail" placeholder="new@@example.com"
                               class="w-full px-3 py-2.5 rounded-xl border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-400 transition" />
                    </div>
                    <button type="submit"
                            class="px-5 py-2.5 bg-slate-700 hover:bg-slate-800 text-white text-sm font-semibold rounded-xl transition">
                        Update Email
                    </button>
                </form>
            </div>

            @* Change Password *@
            <div>
                <h3 class="text-sm font-bold text-slate-700 mb-4">Change Password</h3>
                <form asp-controller="Configuration" asp-action="ChangePassword" method="post" class="space-y-3">
                    @Html.AntiForgeryToken()
                    <div>
                        <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wide mb-1.5">Current Password</label>
                        <input type="password" name="currentPassword"
                               class="w-full px-3 py-2.5 rounded-xl border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-400 transition" />
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wide mb-1.5">New Password</label>
                        <input type="password" name="newPassword"
                               class="w-full px-3 py-2.5 rounded-xl border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-400 transition" />
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wide mb-1.5">Confirm Password</label>
                        <input type="password" name="confirmPassword"
                               class="w-full px-3 py-2.5 rounded-xl border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-400 transition" />
                    </div>
                    <button type="submit"
                            class="px-5 py-2.5 bg-slate-700 hover:bg-slate-800 text-white text-sm font-semibold rounded-xl transition">
                        Update Password
                    </button>
                </form>
            </div>
        </div>

        @* 2FA *@
        <div class="border-t border-slate-100 px-6 py-6" x-data="{ show2fa: false }">
            <div class="flex items-center justify-between mb-4">
                <div>
                    <h3 class="text-sm font-bold text-slate-700">Two-Factor Authentication</h3>
                    <p class="text-xs text-slate-400 mt-0.5">Protect your account with any TOTP authenticator app</p>
                </div>
                @if (twoFactorEnabled)
                {
                    <span class="bg-emerald-100 text-emerald-700 text-xs font-bold px-3 py-1 rounded-full">ENABLED</span>
                }
                else
                {
                    <span class="bg-slate-100 text-slate-500 text-xs font-bold px-3 py-1 rounded-full">DISABLED</span>
                }
            </div>

            @if (!twoFactorEnabled)
            {
                <div x-show="!show2fa">
                    <button type="button" @@click="show2fa = true; setup2fa()"
                            class="px-5 py-2.5 bg-emerald-500 hover:bg-emerald-600 text-white text-sm font-semibold rounded-xl transition flex items-center gap-2">
                        <i class="fas fa-qrcode"></i> Enable 2FA
                    </button>
                </div>
                <div x-show="show2fa" x-cloak class="space-y-4 max-w-sm">
                    <div id="qrCodeArea" class="flex flex-col items-center gap-3 p-4 bg-slate-50 rounded-xl border border-slate-200">
                        <div class="text-sm text-slate-500 animate-pulse">Generating QR code...</div>
                    </div>
                    <form asp-controller="Configuration" asp-action="EnableTwoFactor" method="post" class="flex gap-3">
                        @Html.AntiForgeryToken()
                        <input type="text" name="totpCode" placeholder="000000" maxlength="6" inputmode="numeric"
                               class="flex-1 px-3 py-2.5 text-sm border border-slate-200 rounded-xl font-mono text-center text-lg tracking-widest focus:outline-none focus:ring-2 focus:ring-emerald-500/20 focus:border-emerald-400" />
                        <button type="submit"
                                class="px-5 py-2.5 bg-emerald-500 hover:bg-emerald-600 text-white text-sm font-semibold rounded-xl transition">
                            Verify & Enable
                        </button>
                    </form>
                    <p class="text-xs text-slate-400">
                        Scan with <strong>Google Authenticator</strong>, <strong>Authy</strong>, or any TOTP app — then enter the 6-digit code to confirm.
                    </p>
                </div>
            }
            else
            {
                <form asp-controller="Configuration" asp-action="DisableTwoFactor" method="post"
                      class="flex gap-3 items-end max-w-sm"
                      onsubmit="return confirm('Disable two-factor authentication on your account?')">
                    @Html.AntiForgeryToken()
                    <div class="flex-1">
                        <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wide mb-1.5">Confirm with password</label>
                        <input type="password" name="password" placeholder="Your current password"
                               class="w-full px-3 py-2.5 rounded-xl border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-red-500/20 focus:border-red-400 transition" />
                    </div>
                    <button type="submit"
                            class="px-5 py-2.5 bg-red-500 hover:bg-red-600 text-white text-sm font-semibold rounded-xl transition">
                        Disable 2FA
                    </button>
                </form>
            }
        </div>
    </div>

</div>

@section Scripts {
<script>
    async function setup2fa() {
        const csrf = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';
        const res  = await fetch('/Manager/Configuration/GenerateTotpSetup', {
            method: 'POST',
            headers: { 'RequestVerificationToken': csrf }
        });
        const data = await res.json();
        document.getElementById('qrCodeArea').innerHTML = `
            <img src="${data.qrUrl}" alt="QR Code" class="w-48 h-48 rounded border border-slate-200" />
            <div class="text-center">
                <p class="text-xs text-slate-500 mb-1">Or enter key manually:</p>
                <code class="bg-white px-3 py-1 rounded border border-slate-200 text-sm font-mono select-all">${data.secret}</code>
            </div>`;
    }
</script>
}
