@using Microsoft.Extensions.AI
@using TestBrixCMS.Components.Pages.Chat
@inject IJSRuntime JS

<div class="flex-1 overflow-y-auto" @ref="messagesContainer" style="background: @Theme.ChatBgColor;">
    <div class="space-y-6">
        @foreach (var message in Messages)
        {
            <ChatMessageItem @key="message" Message="@message" Logo="@AiLogo" AiLogoSize="@AiLogoSize" Theme="@Theme" />
        }
        @if (InProgressMessage is not null)
        {
            <ChatMessageItem @key="@("streaming")"
                             Message="@InProgressMessage"
                             InProgress="true"
                             Logo="@AiLogo"
                             AiLogoSize="@AiLogoSize"
                             Theme="@Theme" />
            <div class="flex justify-center py-4">
                <div class="animate-pulse flex space-x-2">
                    <div class="w-2.5 h-2.5 rounded-full animate-bounce" style="background: @Theme.SendButtonColor;"></div>
                    <div class="w-2.5 h-2.5 rounded-full animate-bounce [animation-delay:100ms]" style="background: @Theme.SendButtonColor;"></div>
                    <div class="w-2.5 h-2.5 rounded-full animate-bounce [animation-delay:200ms]" style="background: @Theme.SendButtonColor;"></div>
                </div>
            </div>
        }
        else if (!Messages.Any(m => m.Role == ChatRole.User || m.Role == ChatRole.Assistant))
        {
            @NoMessagesContent
        }
    </div>
</div>

@code {
    private ElementReference messagesContainer;
    private IJSObjectReference? _autoScrollRef;

    [Parameter] public string? Logo { get; set; }
    [Parameter] public string? AiLogo { get; set; }
    [Parameter] public string AiLogoSize { get; set; } = "28px";
    [Parameter] public ChatTheme Theme { get; set; } = ChatTheme.Default;
    [Parameter] public required IEnumerable<ChatMessage> Messages { get; set; } = Enumerable.Empty<ChatMessage>();
    [Parameter] public ChatMessage? InProgressMessage { get; set; }
    [Parameter] public RenderFragment? NoMessagesContent { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && messagesContainer.Context is not null)
        {
            await Task.Delay(100);
            try { _autoScrollRef = await JS.InvokeAsync<IJSObjectReference>("initAutoScroll", messagesContainer); }
            catch { }
        }
    }

    public async ValueTask DisposeAsync()
    {
        try { if (_autoScrollRef is not null) await _autoScrollRef.InvokeVoidAsync("dispose"); }
        catch { }
    }
}
