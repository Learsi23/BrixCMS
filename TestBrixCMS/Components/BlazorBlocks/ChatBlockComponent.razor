@inject IJSRuntime JS

@using TestBrixCMS.Models.BlazorBlocks
@using TestBrixCMS.Components.Pages.Chat

@{
    var displayMode = Model.DisplayMode?.Value ?? "embedded";
    var isFullscreen = displayMode == "fullscreen";
    var bgColor         = SafeColor(Model.BackgroundColor?.Value, "#FFFFFF");
    var borderColor     = SafeColor(Model.BorderColor?.Value, "#E2E8F0");
    var borderRadius    = Model.BorderRadius?.Value ?? "16px";
    var headerBg        = SafeColor(Model.HeaderBgColor?.Value, "#6366F1");
    var headerGradient  = SafeColor(Model.HeaderGradientColor?.Value, "#8B5CF6");
    var headerText      = SafeColor(Model.HeaderTextColor?.Value, "#FFFFFF");
    var titleText       = Model.Title?.Value ?? "AI Assistant";
    var titleSize       = Model.TitleSize?.Value ?? "18px";
    var logoUrl         = Model.Logo?.Value;
    var logoSize        = Model.LogoSize?.Value ?? "28px";
    var aiLogoUrl       = Model.Ai_Logo?.Value;
    var aiLogoSize      = Model.Ai_LogoSize?.Value ?? "28px";
    var chatBg          = SafeColor(Model.ChatBgColor?.Value, "#F8FAFC");
    var userBubble      = SafeColor(Model.UserBubbleColor?.Value, "#6366F1");
    var userText        = SafeColor(Model.UserTextColor?.Value, "#FFFFFF");
    var aiBubble        = SafeColor(Model.AiBubbleColor?.Value, "#FFFFFF");
    var aiText          = SafeColor(Model.AiTextColor?.Value, "#1E293B");
    var aiBorder        = SafeColor(Model.AiBubbleBorderColor?.Value, "#E2E8F0");
    var inputBg         = SafeColor(Model.InputBgColor?.Value, "#FFFFFF");
    var inputText       = SafeColor(Model.InputTextColor?.Value, "#0F172A");
    var inputBorder     = SafeColor(Model.InputBorderColor?.Value, "#CBD5E1");
    var inputPlaceholder = SafeColor(Model.InputPlaceholderColor?.Value, "#94A3B8");
    var sendBtn         = SafeColor(Model.SendButtonColor?.Value, "#6366F1");
    var effectiveChatId = !string.IsNullOrWhiteSpace(ChatId) ? ChatId : $"chat_{Guid.NewGuid():N}";
}

@if (isFullscreen)
{
    @* Fullscreen mode: desktop app style — z-40 so site navbar (z-50) stays visible *@
    <div id="brix-chat-fs" class="fixed inset-x-0 bottom-0 z-[40] flex flex-col"
         style="background: @chatBg; top: 0;">

        @* Compact app navigation bar *@
        <div class="flex items-center gap-3 px-4 py-2.5 flex-shrink-0"
             style="background: linear-gradient(135deg, @headerBg, @headerGradient); border-bottom: 1px solid rgba(0,0,0,0.12); min-height: 52px;">

            @* Back button *@
            <button onclick="history.back()" title="Go back"
                    class="w-9 h-9 rounded-xl flex items-center justify-center hover:bg-white/15 active:bg-white/25 transition-all flex-shrink-0"
                    style="color: @headerText; border: 1px solid rgba(255,255,255,0.2);">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M19 12H5M12 19l-7-7 7-7"/>
                </svg>
            </button>

            <div style="width:1px; height:24px; background:rgba(255,255,255,0.2); flex-shrink:0;"></div>

            @* Logo *@
            @if (!string.IsNullOrEmpty(logoUrl))
            {
                <img src="@logoUrl" alt="logo" style="height: @logoSize; width: auto; max-height: 32px;" class="rounded-lg object-contain bg-white/10 p-1" />
            }

            @* Title + BRIXcms badge *@
            <div class="flex-1 min-w-0">
                <div class="flex items-center gap-2 flex-wrap">
                    <span class="font-bold truncate" style="color: @headerText; font-size: clamp(14px, 2vw, @titleSize);">@titleText</span>
                    <div class="flex items-center gap-1 flex-shrink-0">
                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-300 animate-pulse"></span>
                        <svg width="9" height="9" viewBox="0 0 18 18" fill="none" style="opacity:0.85;flex-shrink:0">
                            <rect x="1" y="1" width="7" height="7" rx="1.5" fill="#22c55e"/>
                            <rect x="10" y="1" width="7" height="7" rx="1.5" fill="@headerText" opacity="0.9"/>
                            <rect x="1" y="10" width="7" height="7" rx="1.5" fill="@headerText" opacity="0.9"/>
                            <rect x="10" y="10" width="7" height="7" rx="1.5" fill="#22c55e" opacity="0.5"/>
                        </svg>
                        <span class="text-[10px] font-black tracking-tight" style="color: @headerText; opacity: 0.75;"><span>BRIX</span><span style="color:#22c55e">cms</span></span>
                    </div>
                </div>
            </div>

            @* New Chat button *@
            <button @onclick="NewChatAsync" title="New conversation"
                    class="flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-semibold hover:bg-white/20 active:bg-white/30 transition-all flex-shrink-0"
                    style="color: @headerText; border: 1px solid rgba(255,255,255,0.25);">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 5v14M5 12h14"/>
                </svg>
                <span class="hidden sm:inline">New chat</span>
            </button>
        </div>

        @* Chat area *@
        <div class="flex-1 flex flex-col overflow-hidden">
            <Chat @ref="fullscreenChatRef"
                  CustomSystemPrompt="@(Model.CustomPrompt?.Value)"
                  WelcomeMessage="@(Model.WelcomeMessage?.Value)"
                  AiProvider="@(Model.AiProvider?.Value)"
                  PdfFilter="@(Model.PdfFiles?.Value)"
                  Logo="@logoUrl"
                  LogoSize="@logoSize"
                  AiLogo="@(aiLogoUrl)"
                  AiLogoSize="@aiLogoSize"
                  Title="@titleText"
                  ChatId="@effectiveChatId"
                  ShowHeader="false"
                  Theme="@CreateTheme()" />
        </div>
    </div>
}
else
{
    @* Embedded mode: card-style widget *@
    <div class="w-full max-w-2xl mx-auto overflow-hidden"
         style="background: @bgColor; border: 1px solid @borderColor; border-radius: @borderRadius; box-shadow: 0 4px 24px rgba(0,0,0,0.06);">
        
        @* Header *@
        <div class="px-6 py-5 flex items-center gap-4"
             style="background: linear-gradient(135deg, @headerBg, @headerGradient);">
            @if (!string.IsNullOrEmpty(logoUrl))
            {
                <img src="@logoUrl" alt="logo" style="height: @logoSize; width: auto;" class="rounded-lg object-contain bg-white/10 p-1.5" />
            }
            else
            {
                <div class="w-10 h-10 rounded-xl bg-white/20 backdrop-blur flex items-center justify-center">
                    <span class="text-lg">🤖</span>
                </div>
            }
            <div>
                <h2 style="color: @headerText; font-size: @titleSize;" class="font-bold">@titleText</h2>
                <div class="flex items-center gap-1.5 mt-0.5">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-300 animate-pulse"></span>
                    <svg width="10" height="10" viewBox="0 0 18 18" fill="none" style="opacity:0.8;flex-shrink:0">
                        <rect x="1" y="1" width="7" height="7" rx="1.5" fill="#22c55e"/>
                        <rect x="10" y="1" width="7" height="7" rx="1.5" fill="@headerText" opacity="0.9"/>
                        <rect x="1" y="10" width="7" height="7" rx="1.5" fill="@headerText" opacity="0.9"/>
                        <rect x="10" y="10" width="7" height="7" rx="1.5" fill="#22c55e" opacity="0.5"/>
                    </svg>
                    <span class="text-[11px] font-black tracking-tight" style="color: @headerText; opacity: 0.8;"><span>BRIX</span><span style="color:#22c55e">cms</span></span>
                </div>
            </div>
        </div>

        @* Chat body *@
        <div class="overflow-hidden" style="background: @chatBg;">
            <Chat CustomSystemPrompt="@(Model.CustomPrompt?.Value)"
                  WelcomeMessage="@(Model.WelcomeMessage?.Value)"
                  AiProvider="@(Model.AiProvider?.Value)"
                  PdfFilter="@(Model.PdfFiles?.Value)"
                  Logo="@logoUrl"
                  LogoSize="@logoSize"
                  AiLogo="@(aiLogoUrl)"
                  AiLogoSize="@aiLogoSize"
                  Title="@titleText"
                  ChatId="@effectiveChatId"
                  Theme="@CreateTheme()" />
        </div>
    </div>
}

@code {
    [Parameter] public ChatBlock Model { get; set; } = new();
    [Parameter] public string? ChatId { get; set; }

    private Chat? fullscreenChatRef;

    private async Task NewChatAsync()
    {
        if (fullscreenChatRef is not null)
            await fullscreenChatRef.ResetConversationAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var displayMode = Model.DisplayMode?.Value ?? "embedded";
        if (displayMode == "fullscreen" && firstRender)
        {
            try { await JS.InvokeVoidAsync("adjustFullscreenChatTop", "brix-chat-fs"); } catch { }
        }
    }

    private ChatTheme CreateTheme() => new()
    {
        UserBubbleColor = SafeColor(Model.UserBubbleColor?.Value, "#6366F1"),
        UserTextColor = SafeColor(Model.UserTextColor?.Value, "#FFFFFF"),
        AiBubbleColor = SafeColor(Model.AiBubbleColor?.Value, "#FFFFFF"),
        AiTextColor = SafeColor(Model.AiTextColor?.Value, "#1E293B"),
        AiBubbleBorderColor = SafeColor(Model.AiBubbleBorderColor?.Value, "#E2E8F0"),
        InputBgColor = SafeColor(Model.InputBgColor?.Value, "#FFFFFF"),
        InputTextColor = SafeColor(Model.InputTextColor?.Value, "#0F172A"),
        InputBorderColor = SafeColor(Model.InputBorderColor?.Value, "#CBD5E1"),
        InputPlaceholderColor = SafeColor(Model.InputPlaceholderColor?.Value, "#94A3B8"),
        SendButtonColor = SafeColor(Model.SendButtonColor?.Value, "#6366F1"),
        ChatBgColor = SafeColor(Model.ChatBgColor?.Value, "#F8FAFC"),
        AiLogo = Model.Ai_Logo?.Value,
        AiLogoSize = Model.Ai_LogoSize?.Value ?? "28px"
    };

    private static string SafeColor(string? hex, string fallback)
    {
        if (string.IsNullOrWhiteSpace(hex)) return fallback;
        return hex.Trim();
    }
}
