@using Microsoft.AspNetCore.Components.Web

@* Inyectamos la fuente si se ha definido una global *@
@if (!string.IsNullOrEmpty(GlobalFontFamily))
{
    <style>
        @@import url('https://fonts.googleapis.com/css2?family=@(GlobalFontFamily.Replace(" ", "+")):wght@300;400;700&display=swap');
    </style>
}

<div class="p-12" style="font-family: '@GlobalFontFamily', sans-serif;">
    <p class="text-left" style="color: @TitleColor; font-size: @TitleSize; font-weight: @TitleWeight">
        @((MarkupString)Title)
    </p>
    <p style="color: @SubtitleColor; font-size: @SubtitleSize; font-weight: @SubtitleWeight">
        @((MarkupString)Subtitle)
    </p>
    <div class="my-12 text-left" style="color: @DescriptionColor; font-size: @DescriptionSize; font-weight: @DescriptionWeight">
        @((MarkupString)Description)
    </div>
    <div style="text-align: @(ButtonPosition ?? "left")">
        <ButtonLinkBlazor Text="@ButtonText"
                          Url="@ButtonUrl"
                          Color="@ButtonColor"
                          HoverColor="@ButtonHoverColor"
                          BorderRadius="@ButtonBorderRadius"
                          Border="@ButtonBorder"
                          Width="@ButtonWidth"
                          Padding="@ButtonPadding"
                          TextColor="@ButtonTextColor"
                          ButtonPosition="@ButtonPosition" />
    </div>
</div>

@code {
    [Parameter] public string GlobalFontFamily { get; set; }
    
    [Parameter] public string Title { get; set; }
    [Parameter] public string TitleColor { get; set; }
    [Parameter] public string TitleSize { get; set; }
    [Parameter] public string TitleWeight { get; set; }

    [Parameter] public string Subtitle { get; set; }
    [Parameter] public string SubtitleColor { get; set; }
    [Parameter] public string SubtitleSize { get; set; }
    [Parameter] public string SubtitleWeight { get; set; }

    [Parameter] public string Description { get; set; }
    [Parameter] public string DescriptionColor { get; set; }
    [Parameter] public string DescriptionSize { get; set; }
    [Parameter] public string DescriptionWeight { get; set; }

    [Parameter] public string ButtonText { get; set; }
    [Parameter] public string ButtonUrl { get; set; }
    [Parameter] public string ButtonColor { get; set; }
    [Parameter] public string ButtonHoverColor { get; set; }
    [Parameter] public string ButtonBorderRadius { get; set; }
    [Parameter] public string ButtonBorder { get; set; }
    [Parameter] public string ButtonWidth { get; set; }
    [Parameter] public string ButtonPadding { get; set; }
    [Parameter] public string ButtonTextColor { get; set; }
    [Parameter] public string ButtonPosition { get; set; }
}
