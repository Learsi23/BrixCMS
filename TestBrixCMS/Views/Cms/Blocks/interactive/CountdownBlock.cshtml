@using TestBrixCMS.Models.Blocks
@model CountdownBlock

@{
    var bg       = Model.BackgroundColor?.Value;
    var textClr  = Model.TextColor?.Value ?? "#1f2937";
    var digitBg  = Model.DigitBgColor?.Value ?? "#1f2937";
    var digitClr = Model.DigitColor?.Value ?? "#ffffff";
    var showLbls = Model.ShowLabels?.IsTrue ?? true;
    var target   = Model.TargetDate?.Value ?? "";
    var cdId     = "cd-" + Guid.NewGuid().ToString()[..8];
}

<section style="@(string.IsNullOrWhiteSpace(bg)||bg=="transparent"?"":$"background-color:{bg};")"
         class="py-12 px-4">
    <div class="max-w-2xl mx-auto text-center">
        @if (!string.IsNullOrWhiteSpace(Model.Title?.Value))
        {
            <h2 class="text-2xl font-bold mb-8" style="color:@textClr">@Model.Title.Value</h2>
        }

        <div id="@cdId"
             x-data="countdown('@target', '@(Model.OnEndText?.Value ?? "Ha terminado!")')"
             class="flex justify-center gap-4 flex-wrap">
            <template x-if="!ended">
                <div class="flex justify-center gap-4 flex-wrap">
                    <div class="flex flex-col items-center">
                        <span class="text-4xl font-mono font-extrabold w-20 h-20 flex items-center justify-center rounded-xl shadow"
                              style="background-color:@digitBg; color:@digitClr;"
                              x-text="days"></span>
                        @if(showLbls){ <span class="text-xs mt-2 font-medium" style="color:@textClr">Días</span> }
                    </div>
                    <div class="flex flex-col items-center">
                        <span class="text-4xl font-mono font-extrabold w-20 h-20 flex items-center justify-center rounded-xl shadow"
                              style="background-color:@digitBg; color:@digitClr;"
                              x-text="hours"></span>
                        @if(showLbls){ <span class="text-xs mt-2 font-medium" style="color:@textClr">Hrs</span> }
                    </div>
                    <div class="flex flex-col items-center">
                        <span class="text-4xl font-mono font-extrabold w-20 h-20 flex items-center justify-center rounded-xl shadow"
                              style="background-color:@digitBg; color:@digitClr;"
                              x-text="minutes"></span>
                        @if(showLbls){ <span class="text-xs mt-2 font-medium" style="color:@textClr">Min</span> }
                    </div>
                    <div class="flex flex-col items-center">
                        <span class="text-4xl font-mono font-extrabold w-20 h-20 flex items-center justify-center rounded-xl shadow"
                              style="background-color:@digitBg; color:@digitClr;"
                              x-text="seconds"></span>
                        @if(showLbls){ <span class="text-xs mt-2 font-medium" style="color:@textClr">Seg</span> }
                    </div>
                </div>
            </template>
            <template x-if="ended">
                <p class="text-2xl font-bold" style="color:@textClr" x-text="endText"></p>
            </template>
        </div>
    </div>
</section>

<script>
document.addEventListener('alpine:init', () => {
    Alpine.data('countdown', (target, endText) => ({
        days: '00', hours: '00', minutes: '00', seconds: '00',
        ended: false, endText,
        init() {
            this.tick();
            setInterval(() => this.tick(), 1000);
        },
        tick() {
            const now  = new Date().getTime();
            const end  = new Date(target).getTime();
            const diff = end - now;
            if (diff <= 0) { this.ended = true; return; }
            const pad = n => String(Math.floor(n)).padStart(2, '0');
            this.days    = pad(diff / (1000*60*60*24));
            this.hours   = pad((diff % (1000*60*60*24)) / (1000*60*60));
            this.minutes = pad((diff % (1000*60*60)) / (1000*60));
            this.seconds = pad((diff % (1000*60)) / 1000);
        }
    }));
});
</script>
