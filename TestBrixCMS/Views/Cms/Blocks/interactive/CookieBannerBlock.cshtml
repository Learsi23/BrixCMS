@using TestBrixCMS.Models.Blocks
@model CookieBannerBlock

@{
    var position = Model.Position?.Value ?? "bottom";
    var bgColor = Model.BackgroundColor?.Value ?? "#1f2937";
    var textColor = Model.TextColor?.Value ?? "#ffffff";
    var title = Model.Title?.Value ?? "We use cookies";
    var message = Model.Message?.Value ?? "We use cookies to enhance your browsing experience and analyze our traffic.";
    var privacyUrl = Model.PrivacyPolicyUrl?.Value ?? "";
    var acceptText = Model.AcceptButtonText?.Value ?? "Accept All";
    var declineText = Model.DeclineButtonText?.Value ?? "Decline";
    var acceptColor = Model.AcceptButtonColor?.Value ?? "#10b981";
    var declineColor = Model.DeclineButtonColor?.Value ?? "#6b7280";
    var btnTextColor = Model.ButtonTextColor?.Value ?? "#ffffff";
    var borderRadius = Model.BorderRadius?.Value ?? "8px";
    var width = Model.Width?.Value ?? "100%";
    var padding = Model.Padding?.Value ?? "16px";
    var zIndex = Model.ZIndex?.Value ?? "9999";
    
    var positionClass = position switch {
        "bottom" => "bottom-0 left-0 right-0",
        "top" => "top-0 left-0 right-0",
        "bottom-left" => "bottom-4 left-4",
        "bottom-right" => "bottom-4 right-4",
        _ => "bottom-0 left-0 right-0"
    };
}

<div class="fixed @positionClass" 
     style="background-color:@bgColor;padding:@padding;border-radius:@(position == "bottom" || position == "top" ? "0" : borderRadius);z-index:@zIndex;width:@(position == "bottom" || position == "top" ? "100%" : width);max-width:@(position == "bottom" || position == "top" ? "100%" : "400px");">
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
        <div class="flex-1">
            <h3 class="font-medium mb-1" style="color:@textColor;">@title</h3>
            <p class="text-sm" style="color:@textColor;opacity:0.8;">
                @message
                @if (!string.IsNullOrEmpty(privacyUrl))
                {
                    <a href="@privacyUrl" class="underline ml-1 hover:opacity-80" style="color:@textColor;">Learn more</a>
                }
            </p>
        </div>
        <div class="flex gap-3 flex-shrink-0">
            <button onclick="localStorage.setItem('cookieConsent','declined');this.closest('.fixed').style.display='none';" 
                    class="px-4 py-2 rounded font-medium text-sm transition-opacity hover:opacity-80"
                    style="background-color:@declineColor;color:@btnTextColor;">
                @declineText
            </button>
            <button onclick="localStorage.setItem('cookieConsent','accepted');this.closest('.fixed').style.display='none';" 
                    class="px-4 py-2 rounded font-medium text-sm transition-opacity hover:opacity-80"
                    style="background-color:@acceptColor;color:@btnTextColor;">
                @acceptText
            </button>
        </div>
    </div>
</div>
