@using TestBrixCMS.Models.Blocks
@model IconCardBlock

@{
    var iconPosition = Model.IconPosition?.Value ?? "left";
    var textAlign    = Model.TextAlign?.Value ?? "left";
    var hasLeftIcon  = !string.IsNullOrEmpty(Model.LeftIcon?.Value) || !string.IsNullOrEmpty(Model.LeftIconClass?.Value);
    var hasRightIcon = !string.IsNullOrEmpty(Model.RightIcon?.Value) || !string.IsNullOrEmpty(Model.RightIconClass?.Value);
    var hasLink      = !string.IsNullOrWhiteSpace(Model.LinkUrl?.Value);

    // Contenedor
    var containerStyle = $"background-color:{(Model.BackgroundColor?.Value ?? "transparent")};" +
                         $"border-radius:{(Model.BorderRadius?.Value ?? "0")};" +
                         $"border:{(Model.BorderWidth?.Value ?? "0")} solid {(Model.BorderColor?.Value ?? "transparent")};" +
                         $"padding:{(Model.Padding?.Value ?? "1.5rem")};" +
                         (string.IsNullOrWhiteSpace(Model.Shadow?.Value) ? "" : $"box-shadow:{Model.Shadow.Value};");

    // Icono principal (imagen o FA)
    var iconImgSize = Model.LeftIconSize?.Value ?? "48px";
    var iconFaSize  = Model.LeftIconFaSize?.Value ?? "2rem";

    // Texto
    var titleStyle    = $"color:{(Model.TitleColor?.Value ?? "inherit")}; font-size:{(Model.TitleSize?.Value ?? "1.25rem")};";
    var subtitleStyle = $"color:{(Model.SubtitleColor?.Value ?? "inherit")}; font-size:{(Model.SubtitleSize?.Value ?? "1rem")};";
    var textStyle     = $"color:{(Model.TextColor?.Value ?? "inherit")}; font-size:{(Model.TextSize?.Value ?? "0.95rem")};";
    var mdStyle       = $"color:{(Model.MarkDownColor?.Value ?? "inherit")};";

    // CTA
    var linkTarget = Model.LinkNewTab?.IsTrue == true ? "_blank" : "_self";
    var btnStyle   = $"background-color:{(Model.LinkBgColor?.Value ?? "#4f46e5")}; color:{(Model.LinkTextColor?.Value ?? "#ffffff")};";

    // Layout según posición del icono
    bool isTop   = iconPosition == "top";
    bool isRight = iconPosition == "right";
    string outerFlex = isTop ? "flex-col items-" + (textAlign == "center" ? "center" : textAlign == "right" ? "end" : "start")
                             : "flex-row items-center";
}

<div class="relative w-full h-full" style="@containerStyle">
    <div class="flex @outerFlex gap-4 h-full">

        @* ── Icono (top o left) ── *@
        @if (hasLeftIcon && !isRight)
        {
            <div class="flex-shrink-0 flex items-center justify-center">
                @if (!string.IsNullOrEmpty(Model.LeftIcon?.Value))
                {
                    <img src="@Url.Content(Model.LeftIcon.Value)"
                         alt="@(Model.LeftIcon.AltText ?? "")"
                         style="width:@iconImgSize; height:@iconImgSize;"
                         class="object-contain">
                }
                else
                {
                    <i class="@Model.LeftIconClass.Value"
                       style="font-size:@iconFaSize; color:@(Model.LeftIconColor?.Value ?? "inherit");"></i>
                }
            </div>
        }

        @* ── Contenido de texto ── *@
        <div class="flex-grow text-@textAlign flex flex-col justify-center">

            @if (!string.IsNullOrWhiteSpace(Model.Title?.Value))
            {
                <p class="font-bold mb-2 leading-snug" style="@titleStyle">
                    @Html.Raw(Model.Title.Value)
                </p>
            }

            @if (!string.IsNullOrWhiteSpace(Model.Subtitle?.Value))
            {
                <p class="font-medium mb-2 opacity-80" style="@subtitleStyle">
                    @Html.Raw(Model.Subtitle.Value)
                </p>
            }

            @if (!string.IsNullOrWhiteSpace(Model.Text?.Value))
            {
                <p class="leading-relaxed mb-2" style="@textStyle">
                    @Html.Raw(Model.Text.Value)
                </p>
            }

            @if (!string.IsNullOrWhiteSpace(Model.MarkDown?.Value))
            {
                <div class="markdown-content leading-relaxed" style="@mdStyle">
                    @Html.Raw(Model.MarkDown.Value)
                </div>
            }

            @if (hasLink && !string.IsNullOrWhiteSpace(Model.LinkText?.Value))
            {
                <a href="@Model.LinkUrl.Value"
                   target="@linkTarget"
                   class="inline-block mt-4 px-5 py-2 rounded font-semibold text-sm transition-opacity hover:opacity-80 self-start"
                   style="@btnStyle">
                    @Model.LinkText.Value
                </a>
            }
        </div>

        @* ── Icono derecho (decorativo o posición right) ── *@
        @if ((hasLeftIcon && isRight) || hasRightIcon)
        {
            <div class="flex-shrink-0 flex items-center justify-center">
                @if (hasLeftIcon && isRight)
                {
                    @* Icono principal en posición right *@
                    @if (!string.IsNullOrEmpty(Model.LeftIcon?.Value))
                    {
                        <img src="@Url.Content(Model.LeftIcon.Value)"
                             alt="@(Model.LeftIcon.AltText ?? "")"
                             style="width:@iconImgSize; height:@iconImgSize;"
                             class="object-contain">
                    }
                    else
                    {
                        <i class="@Model.LeftIconClass.Value"
                           style="font-size:@iconFaSize; color:@(Model.LeftIconColor?.Value ?? "inherit");"></i>
                    }
                }
                else if (hasRightIcon)
                {
                    @* Icono decorativo derecho *@
                    @if (!string.IsNullOrEmpty(Model.RightIcon?.Value))
                    {
                        <img src="@Url.Content(Model.RightIcon.Value)"
                             alt=""
                             style="width:@(Model.RightIconSize?.Value ?? "32px"); height:@(Model.RightIconSize?.Value ?? "32px");"
                             class="object-contain opacity-60">
                    }
                    else if (!string.IsNullOrEmpty(Model.RightIconClass?.Value))
                    {
                        <i class="@Model.RightIconClass.Value"
                           style="color:@(Model.RightIconColor?.Value ?? "inherit"); opacity:0.6;"></i>
                    }
                }
            </div>
        }

    </div>
</div>
