@using TestBrixCMS.Models.Blocks
@model FeatureGridBlock

@{
    var cols = Model.Columns?.Value ?? "3";
    var gap = Model.Gap?.Value ?? "1rem";
    var bgColor = Model.BackgroundColor?.Value ?? "transparent";
    var paddingY = Model.PaddingY?.Value ?? "3rem";
    var maxWidth = Model.MaxWidth?.Value ?? "1200px";
    
    var titleColor = Model.TitleColor?.Value ?? "#ffffff";
    var titleSize = Model.TitleSize?.Value ?? "2rem";
    var subColor = Model.SubtitleColor?.Value ?? "#9ca3af";
    var subSize = Model.SubtitleSize?.Value ?? "1rem";
}

<section class="w-full" style="background-color:@bgColor; padding:@paddingY 0;">
    <div class="mx-auto" style="max-width:@maxWidth; padding:0 1rem;">
        
        @* Header *@
        @if (!string.IsNullOrWhiteSpace(Model.Title?.Value))
        {
            <div class="text-center mb-8">
                @if (!string.IsNullOrWhiteSpace(Model.Subtitle?.Value))
                {
                    <p class="text-xs uppercase tracking-wider mb-2" style="color:#5B6EF5; font-weight:600;">@Model.Subtitle.Value</p>
                }
                <h2 class="font-bold" style="color:@titleColor; font-size:@titleSize;">
                    @Html.Raw(Model.Title.Value)
                </h2>
            </div>
        }

        @* Grid *@
        <div class="grid gap-@gap" style="grid-template-columns:repeat(@cols, 1fr);">
            
            @* Feature 1 *@
            @if (!string.IsNullOrWhiteSpace(Model.Title1?.Value))
            {
                <div class="p-6 rounded-lg border" style="background:#111113; border-color:#2A2A30;">
                    @if (!string.IsNullOrWhiteSpace(Model.Icon1?.Value))
                    {
                        <div class="mb-3 text-2xl" style="color:@(Model.Icon1Color?.Value ?? "#5B6EF5");">
                            <i class="@Model.Icon1.Value"></i>
                        </div>
                    }
                    <h3 class="font-semibold mb-2" style="color:#F0F0F5; font-size:1.125rem;">@Model.Title1.Value</h3>
                    @if (!string.IsNullOrWhiteSpace(Model.Description1?.Value))
                    {
                        <p class="text-sm" style="color:#9696A6;">@Model.Description1.Value</p>
                    }
                </div>
            }

            @* Feature 2 *@
            @if (!string.IsNullOrWhiteSpace(Model.Title2?.Value))
            {
                <div class="p-6 rounded-lg border" style="background:#111113; border-color:#2A2A30;">
