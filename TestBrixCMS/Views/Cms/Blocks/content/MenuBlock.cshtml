@using TestBrixCMS.Models.Blocks
@using System.Text.Json
@model MenuBlock

@{
    var accent      = Model.AccentColor?.Value ?? "#b45309";
    var showDiv     = Model.ShowDividers?.IsTrue ?? true;
    var menuJson    = Model.MenuJson?.Value ?? "[]";

    List<MenuSection> sections = new();
    try
    {
        sections = JsonSerializer.Deserialize<List<MenuSection>>(menuJson,
            new JsonSerializerOptions { PropertyNameCaseInsensitive = true }) ?? new();
    }
    catch { }
}

@functions {
    public class MenuItem  { public string Name { get; set; } = ""; public string Description { get; set; } = ""; public string Price { get; set; } = ""; public string? Badge { get; set; } }
    public class MenuSection { public string Category { get; set; } = ""; public List<MenuItem> Items { get; set; } = new(); }
}

<section class="w-full py-14 px-4">
    <div class="max-w-3xl mx-auto">
        @if (!string.IsNullOrEmpty(Model.Title?.Value))
        {
            <h2 class="text-3xl font-bold text-center text-gray-900 mb-2">@Model.Title.Value</h2>
        }
        @if (!string.IsNullOrEmpty(Model.Subtitle?.Value))
        {
            <p class="text-center text-gray-500 mb-10">@Model.Subtitle.Value</p>
        }

        @foreach (var menuSection in sections)
        {
            <div class="mb-10">
                <h3 class="text-lg font-semibold uppercase tracking-widest mb-4 pb-2 border-b-2"
                    style="color:@accent; border-color:@accent;">
                    @menuSection.Category
                </h3>
                <ul class="space-y-4">
                    @foreach (var item in menuSection.Items)
                    {
                        <li class="@(showDiv ? "pb-4 border-b border-gray-100" : "")">
                            <div class="flex items-start justify-between gap-4">
                                <div>
                                    <div class="flex items-center gap-2">
                                        <span class="font-semibold text-gray-900">@item.Name</span>
                                        @if (!string.IsNullOrEmpty(item.Badge))
                                        {
                                            <span class="text-xs px-2 py-0.5 rounded-full font-medium text-white"
                                                  style="background-color:@accent;">@item.Badge</span>
                                        }
                                    </div>
                                    @if (!string.IsNullOrEmpty(item.Description))
                                    {
                                        <p class="text-sm text-gray-500 mt-0.5">@item.Description</p>
                                    }
                                </div>
                                @if (!string.IsNullOrEmpty(item.Price))
                                {
                                    <span class="font-semibold text-gray-800 whitespace-nowrap">@item.Price</span>
                                }
                            </div>
                        </li>
                    }
                </ul>
            </div>
        }
    </div>
</section>
