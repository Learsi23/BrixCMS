@using TestBrixCMS.Models.Blocks
@model SocialProofBlock

@{
    var bg       = Model.BackgroundColor?.Value;
    var textClr  = Model.TextColor?.Value ?? "#6b7280";
    var logos    = (Model.LogoUrls?.Value ?? "")
                    .Split(',', StringSplitOptions.RemoveEmptyEntries)
                    .Select(u => u.Trim())
                    .Where(u => !string.IsNullOrEmpty(u))
                    .ToList();
    var hasReviews = !string.IsNullOrEmpty(Model.ReviewCount?.Value) || !string.IsNullOrEmpty(Model.ReviewScore?.Value);
    var source   = Model.ReviewSource?.Value ?? "Google";
    var logoH    = Model.LogoHeight?.Value ?? "40px";
}

<section style="@(string.IsNullOrWhiteSpace(bg)||bg=="transparent"?"":$"background-color:{bg};")"
         class="py-10 px-4">
    <div class="max-w-5xl mx-auto text-center">
        @if (!string.IsNullOrWhiteSpace(Model.Title?.Value))
        {
            <p class="text-sm font-medium uppercase tracking-wider mb-8" style="color:@textClr">
                @Model.Title.Value
            </p>
        }

        @if (logos.Any())
        {
            <div class="flex flex-wrap justify-center items-center gap-8 opacity-60 mb-8">
                @foreach (var logo in logos)
                {
                    <img src="@logo" alt="Client logo"
                         style="height:@logoH; width:auto; object-fit:contain; filter:grayscale(100%);"
                         class="hover:opacity-100 transition-all" />
                }
            </div>
        }

        @if (hasReviews)
        {
            <div class="inline-flex items-center gap-3 bg-white border border-gray-100 rounded-full px-5 py-3 shadow-sm">
                @* Stars *@
                <div class="flex gap-0.5">
                    @for (int i = 0; i < 5; i++)
                    {
                        <svg class="w-4 h-4" fill="#f59e0b" viewBox="0 0 20 20">
                            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                        </svg>
                    }
                </div>
                @if (!string.IsNullOrEmpty(Model.ReviewScore?.Value))
                {
                    <span class="font-bold text-gray-800 text-sm">@Model.ReviewScore.Value</span>
                }
                @if (!string.IsNullOrEmpty(Model.ReviewCount?.Value))
                {
                    <span class="text-gray-400 text-sm">(@Model.ReviewCount.Value reseñas en @source)</span>
                }
            </div>
        }
    </div>
</section>
