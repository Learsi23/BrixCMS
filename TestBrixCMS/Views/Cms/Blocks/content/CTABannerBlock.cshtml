@using TestBrixCMS.Extensions
@model TestBrixCMS.Models.Blocks.CTABannerBlock
@{
    var bg1    = Model.BackgroundColor?.Value ?? "#10b981";
    var bg2    = Model.BackgroundColor2?.Value;
    var bgImg  = Model.BackgroundImage?.Value;
    var padY   = Model.PaddingY?.Value ?? "5rem";
    var align  = Model.TextAlign?.Value ?? "center";

    var bgStyle = "";
    if (!string.IsNullOrWhiteSpace(bgImg))
        bgStyle = $"background-image:url('{bgImg}'); background-size:cover; background-position:center;";
    else if (!string.IsNullOrWhiteSpace(bg2))
        bgStyle = $"background:linear-gradient(135deg,{bg1},{bg2});";
    else
        bgStyle = $"background-color:{bg1};";

    var hasBtn2 = !string.IsNullOrWhiteSpace(Model.Btn2Text?.Value);
}

<section class="relative overflow-hidden" style="@bgStyle padding:@padY 1.5rem;">

    @* Overlay sutil *@
    @if (!string.IsNullOrWhiteSpace(bgImg))
    {
        <div class="absolute inset-0 bg-black/40"></div>
    }

    <div class="relative z-10 container mx-auto max-w-4xl text-@align">

        @if (!string.IsNullOrWhiteSpace(Model.Title?.Value))
        {
            <h2 class="font-black leading-tight mb-4"
                style="color:@(Model.TitleColor?.Value ?? "#fff"); font-size:@(Model.TitleSize?.Value ?? "2rem");">
                @RichText.Render(Model.Title.Value)
            </h2>
        }

        @if (!string.IsNullOrWhiteSpace(Model.Subtitle?.Value))
        {
            <p class="text-lg mb-8 max-w-2xl @(align == "center" ? "mx-auto" : "")"
               style="color:@(Model.SubtitleColor?.Value ?? "rgba(255,255,255,0.8)");">
                @RichText.Render(Model.Subtitle.Value)
            </p>
        }

        <div class="flex flex-wrap gap-4 @(align == "center" ? "justify-center" : align == "right" ? "justify-end" : "justify-start")">

            @if (!string.IsNullOrWhiteSpace(Model.Btn1Text?.Value))
            {
                <a href="@(Model.Btn1Url?.Value ?? "#")"
                   class="inline-block px-8 py-3.5 rounded-xl font-bold text-sm shadow-lg hover:opacity-90 transition-all hover:scale-105"
                   style="background-color:@(Model.Btn1BgColor?.Value ?? "#fff"); color:@(Model.Btn1TextColor?.Value ?? "#111");">
                    @Model.Btn1Text.Value
                </a>
            }

            @if (hasBtn2)
            {
                <a href="@(Model.Btn2Url?.Value ?? "#")"
                   class="inline-block px-8 py-3.5 rounded-xl font-bold text-sm border-2 hover:opacity-90 transition-all"
                   style="border-color:@(Model.Btn2Color?.Value ?? "#fff"); color:@(Model.Btn2Color?.Value ?? "#fff");">
                    @Model.Btn2Text!.Value
                </a>
            }

        </div>
    </div>
</section>
