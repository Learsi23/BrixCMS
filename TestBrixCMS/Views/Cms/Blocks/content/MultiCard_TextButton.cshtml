@model TestBrixCMS.Models.BlazorBlocks.MultiCard_TextButton
@using TestBrixCMS.Components.BlazorBlocks

@{
    // Estilos del Card
    var bgColor = Model.BackgroundColor?.Value;
    
    // LÓGICA DE IMAGEN CORREGIDA:
    var bgImage = !string.IsNullOrEmpty(Model.BackgroundImage?.Value)
                  ? Model.BackgroundImage.Value
                  : "";
    
    var padding = Model.Padding?.Value;
    var borderRadius = Model.CardBorderRadius?.Value;
    var border = Model.CardBorder?.Value;
    var globalFont = Model.GlobalFontFamily?.Value;

    // Datos de Textos
    var title = Model.Title?.Value;
    var subtitle = Model.Subtitle?.Value;
    var extraText = Model.Text?.Value;
    
    // IMPORTANTE: PASAMOS HtmlValue PARA QUE TENGA LOS <br/>
    var description = Model.Description?.HtmlValue;

    // Botón
    var btnText = Model.ButtonText?.Value;
    var btnUrl = Model.ButtonUrl?.Value;
}

<div class="card-wrapper my-8">
    <component type="typeof(MultiTextCardBlock)"
               render-mode="Static"
               param-GlobalFontFamily="@(Model.GlobalFontFamily?.Value ?? "")"
               param-TextAlign="@(Model.TextAlign?.Value ?? "left")"
    @* PASAMOS EL BOOLEANO REAL *@
               param-EnableHoverScale="@(Model.EnableHoverScale?.IsTrue ?? false)"
               param-BackgroundColor="@bgColor"
               param-BackgroundHoverColor="@(Model.BackgroundHoverColor?.Value ?? "")"
               param-BackgroundImage="@bgImage"
               param-Padding="@padding"
               param-BorderRadius="@borderRadius"
               param-Border="@border"
               param-Title="@title"
               param-TitleColor="@(Model.TitleColor?.Value ?? "")"
               param-TitleHoverColor="@(Model.TitleHoverColor?.Value ?? "")"
               param-TitleSize="@(Model.TitleSize?.Value ?? "")"
               param-TitleWeight="@(Model.TitleWeight?.Value ?? "")"
               param-Subtitle="@subtitle"
               param-SubtitleColor="@(Model.SubtitleColor?.Value ?? "")"
               param-SubtitleHoverColor="@(Model.SubtitleHoverColor?.Value ?? "")"
               param-SubtitleSize="@(Model.SubtitleSize?.Value ?? "")"
               param-SubtitleWeight="@(Model.SubtitleWeight?.Value ?? "")"
               param-ExtraText="@extraText"
               param-ExtraTextColor="@(Model.TextColor?.Value ?? "")"
               param-TextHoverColor="@(Model.TextHoverColor?.Value ?? "")"
               param-ExtraTextSize="@(Model.TextSize?.Value ?? "")"
               param-ExtraTextWeight="@(Model.TextWeight?.Value ?? "")"
               param-Description="@description"
               param-DescriptionColor="@(Model.DescriptionColor?.Value ?? "")"
               param-DescriptionHoverColor="@(Model.DescriptionHoverColor?.Value ?? "")"
               param-DescriptionSize="@(Model.DescriptionSize?.Value ?? "")"
               param-DescriptionWeight="@(Model.DescriptionWeight?.Value ?? "")"
               param-ButtonText="@btnText"
               param-ButtonUrl="@btnUrl"
               param-ButtonColor="@(Model.ButtonColor?.Value ?? "")"
               param-ButtonHoverColor="@(Model.ButtonHoverColor?.Value ?? "")"
               param-ButtonTextColor="@(Model.ButtonTextColor?.Value ?? "")"
               param-ButtonBorderRadius="@(Model.ButtonBorderRadius?.Value ?? "")"
               param-ButtonPadding="@(Model.ButtonPadding?.Value ?? "")"
               param-ButtonPosition="@(Model.ButtonPosition?.Value ?? "left")" />
</div>
