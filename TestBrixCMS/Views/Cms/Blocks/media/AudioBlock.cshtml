@using TestBrixCMS.Models.Blocks
@model AudioBlock

@{
    var audioUrl = Model.AudioUrl?.Value ?? "";
    var coverImage = Model.CoverImage?.Value ?? "";
    var title = Model.Title?.Value ?? "";
    var description = Model.Description?.Value ?? "";
    var artist = Model.Artist?.Value ?? "";
    var showControls = Model.ShowControls?.Value ?? "true";
    var autoPlay = Model.AutoPlay?.Value ?? "false";
    var loop = Model.Loop?.Value ?? "false";
    var style = Model.Style?.Value ?? "card";
    var bgColor = Model.BackgroundColor?.Value ?? "#f3f4f6";
    var textColor = Model.TextColor?.Value ?? "#000000";
    var accentColor = Model.AccentColor?.Value ?? "#5B6EF5";
    var sectionId = Model.SectionId?.Value ?? "";
}

<section id="@sectionId" class="py-4">
    @if (string.IsNullOrEmpty(audioUrl))
    {
        <div class="text-center text-gray-400 py-8">
            <p>Configure audio URL in block settings</p>
        </div>
    }
    else if (style == "minimal")
    {
        <audio src="@audioUrl" controls="@(showControls == "true")" autoplay="@(autoPlay == "true")" loop="@(loop == "true")" style="accent-color:@accentColor;"></audio>
    }
    else if (style == "card")
    {
        <div class="flex items-center gap-4 p-4 rounded-lg" style="background-color:@bgColor;">
            @if (!string.IsNullOrEmpty(coverImage))
            {
                <img src="@coverImage" alt="@title" class="w-16 h-16 object-cover rounded" />
            }
            <div class="flex-1 min-w-0">
                @if (!string.IsNullOrEmpty(title))
                {
                    <p class="font-medium truncate" style="color:@textColor;">@title</p>
                }
                @if (!string.IsNullOrEmpty(artist))
                {
                    <p class="text-sm truncate" style="color:@textColor;opacity:0.7;">@artist</p>
                }
            </div>
            <audio src="@audioUrl" controls="@(showControls == "true")" autoplay="@(autoPlay == "true")" loop="@(loop == "true")" style="accent-color:@accentColor;"></audio>
        </div>
    }
    else @* full *@
    {
        <div class="rounded-lg overflow-hidden" style="background-color:@bgColor;">
            @if (!string.IsNullOrEmpty(coverImage))
            {
                <img src="@coverImage" alt="@title" class="w-full h-48 object-cover" />
            }
            <div class="p-4">
                @if (!string.IsNullOrEmpty(title))
                {
                    <h3 class="font-medium text-lg" style="color:@textColor;">@title</h3>
                }
                @if (!string.IsNullOrEmpty(artist))
                {
                    <p class="text-sm mb-3" style="color:@textColor;opacity:0.7;">@artist</p>
                }
                @if (!string.IsNullOrEmpty(description))
                {
                    <p class="text-sm mb-4" style="color:@textColor;">@description</p>
                }
                <audio src="@audioUrl" controls="@(showControls == "true")" autoplay="@(autoPlay == "true")" loop="@(loop == "true")" class="w-full" style="accent-color:@accentColor;"></audio>
            </div>
        </div>
    }
</section>
