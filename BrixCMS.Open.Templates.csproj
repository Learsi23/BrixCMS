<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageType>Template</PackageType>
    <PackageVersion>1.2.0</PackageVersion>
    <PackageId>BrixCMS.Open.Templates</PackageId>
    <Title>BrixCMS Open — Block-based CMS Template</Title>
    <Authors>BrixCMS</Authors>
    <Description>Project template for BrixCMS Open — open-source .NET 10 block-based CMS with Blazor Server, MVC, visual page editor, 40+ blocks, headless Content API and local Ollama AI chatbot. Zero config, SQLite, MIT license.

Install: dotnet new install BrixCMS.Open.Templates
Create:  dotnet new brixcms -n MyWebsite

Also available in Visual Studio 2022 via New Project → Search "BrixCMS".</Description>
    <PackageTags>dotnet-new;template;cms;blazor;mvc;ollama;ai;brixcms;sqlite;headless;aspnetcore</PackageTags>
    <PackageProjectUrl>https://github.com/Learsi23/BrixCMS</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/Learsi23/BrixCMS</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <!-- Minimal target — no code is compiled, only content is packed -->
    <TargetFramework>net10.0</TargetFramework>
    <IncludeContentInPack>true</IncludeContentInPack>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <ContentTargetFolders>content</ContentTargetFolders>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
  </PropertyGroup>

  <!-- Remove ALL compile items — this project only packs content, never compiles -->
  <ItemGroup>
    <Compile Remove="**\*" />
    <EmbeddedResource Remove="**\*" />
  </ItemGroup>

  <!-- NuGet package assets (README shown on nuget.org; icon optional) -->
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="icon.png"  Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="BrixCMS.Open\**\*"
             Exclude="BrixCMS.Open\**\bin\**;
                      BrixCMS.Open\**\obj\**;
                      BrixCMS.Open\**\*.db;
                      BrixCMS.Open\**\*.db-shm;
                      BrixCMS.Open\**\*.db-wal;
                      BrixCMS.Open\**\*.user;
                      BrixCMS.Open\**\appsettings.Development.json;
                      BrixCMS.Open\Migrations\**" />
  </ItemGroup>

</Project>
