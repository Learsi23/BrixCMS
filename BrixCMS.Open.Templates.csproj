<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageType>Template</PackageType>
    <PackageVersion>1.2.2</PackageVersion>
    <PackageId>BrixCMS.Open.Templates</PackageId>
    <Title>BrixCMS Open — .NET 10 CMS Template (Blazor, Headless, AI)</Title>
    <Authors>Lear23</Authors>
    <Copyright>Copyright © 2025 BrixCMS Contributors</Copyright>
    <Description>dotnet new template for BrixCMS — a free, open-source, block-based CMS for ASP.NET Core 10.

✅ 45+ drag-and-drop content blocks (Hero, Gallery, FAQ, Cards, Map, Video, QR, Countdown…)
✅ AI chatbot — local Ollama (free, private) or Gemini cloud (free tier, BYOK)
✅ PDF semantic search with vector embeddings
✅ Headless REST API — serve content to Next.js, Nuxt, React, Vue or Flutter
✅ Visual page editor — no code required
✅ Multi-admin with role-based permissions
✅ SQLite (zero-config) · SQL Server · PostgreSQL
✅ Newsletter, Cookie banner, XML Sitemap, SEO meta
✅ AES-256-GCM key encryption · TOTP 2FA · PBKDF2 passwords
✅ MIT license — free to use, modify, distribute

Install template:
  dotnet new install BrixCMS.Open.Templates

Create a new site:
  dotnet new brixcms -n MyWebsite
  cd MyWebsite
  dotnet run

Also available in Visual Studio 2022: New Project → search "BrixCMS".

Docs: https://github.com/Learsi23/BrixCMS
Pro: https://brixc-ms.com</Description>
    <PackageTags>cms;content-management;content-management-system;headless-cms;dotnet-cms;aspnetcore-cms;blazor-cms;net10;dotnet-new;template;page-builder;visual-editor;block-editor;ai-chatbot;ollama;gemini;sqlite;self-hosted;open-source;brixcms;aspnetcore;blazor;headless;mvc;web-cms;dotnet10</PackageTags>
    <PackageProjectUrl>https://brixc-ms.com</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <RepositoryUrl>https://github.com/Learsi23/BrixCMS</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReleaseNotes>v1.2.2 — AiClientFactory multi-provider abstraction, AES-256-GCM EncryptionService, ApiKey model, improved PDF chunking, GitHub star banner in admin panel. v1.2.1 — Auto-generate EncryptionKey on project creation. v1.2.0 — Gemini cloud AI, Headless REST API, 45+ blocks.</PackageReleaseNotes>
    <!-- Minimal target — no code is compiled, only content is packed -->
    <TargetFramework>net10.0</TargetFramework>
    <IncludeContentInPack>true</IncludeContentInPack>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <ContentTargetFolders>content</ContentTargetFolders>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
  </PropertyGroup>

  <!-- Remove ALL compile items — this project only packs content, never compiles -->
  <ItemGroup>
    <Compile Remove="**\*" />
    <EmbeddedResource Remove="**\*" />
  </ItemGroup>

  <!-- NuGet package assets (README shown on nuget.org; icon optional) -->
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="icon.png"  Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="BrixCMS.Open\**\*"
             Exclude="BrixCMS.Open\**\bin\**;
                      BrixCMS.Open\**\obj\**;
                      BrixCMS.Open\**\*.db;
                      BrixCMS.Open\**\*.db-shm;
                      BrixCMS.Open\**\*.db-wal;
                      BrixCMS.Open\**\*.user;
                      BrixCMS.Open\**\appsettings.Development.json;
                      BrixCMS.Open\Migrations\**" />
  </ItemGroup>

</Project>
