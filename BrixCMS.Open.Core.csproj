<!--
  BrixCMS.Open.Core — Headless NuGet Library
  ============================================
  This project packs the BrixCMS core (models, services, DB, AI, block registry)
  as a standalone installable NuGet library.

  Usage once published:
    dotnet add package BrixCMS.Open.Core

  Then in Program.cs:
    builder.Services.AddBrixCms(builder.Configuration);
    var app = builder.Build();
    await app.InitializeBrixCmsAsync();
    app.MapBrixCmsApi();     // /api/content/* headless endpoints
    app.Run();

  NOTE: This project compiles ONLY the headless source files from BrixCMS.Open/
  (Models, Data, Services, Extensions, DTOs) and deliberately EXCLUDES all
  web-UI items — Controllers, Views, Areas, Blazor, TagHelpers, ViewComponents.
  Those are NOT packed into this NuGet package.

  This means MapBrixCmsAdmin() (the /Manager visual admin panel) will 404
  unless the host project supplies its own copies of Areas/Manager/**,
  Controllers/**, Views/** and TagHelpers/ViewComponents — e.g. by starting
  from `dotnet new install BrixCMS.Open.Templates` instead of this package,
  or by copying those folders from the GitHub repo. If you only need the
  headless engine (DbContext + services + Content API), Core alone is enough.
-->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>BrixCMS.Open</RootNamespace>
    <AssemblyName>BrixCMS.Open.Core</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>

    <!-- NuGet package metadata -->
    <PackageId>BrixCMS.Open.Core</PackageId>
    <PackageVersion>1.5.0</PackageVersion>
    <Title>BrixCMS Open — Headless CMS Core Library for ASP.NET Core 10</Title>
    <Authors>Lear23</Authors>
    <Copyright>Copyright © 2025 BrixCMS Contributors</Copyright>
    <Description>Headless engine behind BrixCMS — a free, open-source, block-based CMS with visual editor, AI chatbot, PDF semantic search and a full Content Delivery API.

⚠️ THIS PACKAGE IS HEADLESS ONLY — no admin UI included
This package contains the DbContext, services, models and Content Delivery API only. It does NOT include the MVC Controllers, Razor Views or the /Manager visual admin panel — those are web-UI files that are intentionally not packed into this library. If you want the full CMS with the drag-and-drop admin panel out of the box, use the project template instead:

  dotnet new install BrixCMS.Open.Templates
  dotnet new brixcms -n MyWebsite

Use BrixCMS.Open.Core directly only if you're embedding the headless engine (DbContext + services + Content API) into your own ASP.NET Core project and will build/bring your own admin UI, or will copy Areas/Controllers/Views from the GitHub repo yourself.

QUICK SETUP (headless)
  dotnet add package BrixCMS.Open.Core

  // Program.cs
  builder.Services.AddBrixCms(builder.Configuration);
  var app = builder.Build();
  await app.InitializeBrixCmsAsync();
  app.MapBrixCmsApi();     // /api/content/*  — headless REST API
  app.Run();

WHAT YOU GET
✅ 50+ content block types (Hero, Gallery, FAQ, Cards, Map, Video, QR Code, Countdown…)
✅ Automatic page version history — restore any prior published version
✅ AI chatbot — Ollama (local, free) or Gemini (cloud, free tier BYOK)
✅ PDF semantic search with in-memory vector store
✅ Headless REST API: GET /api/content/pages/{slug} returns nested block tree
✅ Multi-admin with role-based permissions (owner / admin / member)
✅ SQLite (zero-config) · SQL Server · PostgreSQL via EF Core 10
✅ Newsletter subscriber API
✅ Image optimisation (ImageSharp), QR codes, Markdown, XML Sitemap
✅ AES-256-GCM API key encryption · TOTP 2FA · PBKDF2-SHA256 passwords
✅ Rate limiting, CSRF, security headers out of the box
✅ MIT license

GitHub: https://github.com/Learsi23/BrixCMS
Pro / Docs: https://brixc-ms.com</Description>
    <PackageTags>cms;content-management;content-management-system;headless-cms;dotnet-cms;aspnetcore-cms;blazor-cms;net10;page-builder;visual-editor;block-editor;ai-chatbot;ollama;gemini;sqlite;self-hosted;open-source;brixcms;aspnetcore;blazor;headless;content-api;dotnet10;web-cms;blocks</PackageTags>
    <PackageProjectUrl>https://brixc-ms.com</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <RepositoryUrl>https://github.com/Learsi23/BrixCMS</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReleaseNotes>v1.5.0 — Fixed misleading package description: BrixCMS.Open.Core is headless-only (DbContext + services + Content API) and does not include MVC Controllers/Razor Views, so /admin/manager (and any MapBrixCmsAdmin() route) 404s when this package is used alone. MapBrixCmsAdmin() removed from the quick-setup snippet; docs now point to BrixCMS.Open.Templates for the full admin UI. Live text editing: double-click any highlighted text on the live preview to edit it in place, saved in the background. Device preview (Desktop/Tablet/Mobile) via a real iframe so responsive breakpoints re-trigger. Automatic page version history with one-click restore. Merged CardBlock + MultiCard into one flexible card block with horizontal/overlay layouts. Refreshed the block showcase to list all 50+ blocks. v1.4.0 — Navbar auto-shows published top-level pages alongside configured menu items with dropdown children support; seed items auto-clear on first real page publish. Fixed 404 on root URL. Fixed admin anti-forgery token rendering. Improved route ordering (CMS before Blazor). v1.2.3 — Fix custom icon in Visual Studio New Project dialog. v1.2.2 — AiClientFactory multi-provider abstraction, AES-256-GCM EncryptionService, ApiKey model, improved PDF chunking. v1.2.0 — Gemini cloud AI (free tier BYOK), full Headless REST API with nested block tree, 45+ blocks, PDF upload via admin panel, improved security headers.</PackageReleaseNotes>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- NuGet package assets -->
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="icon.png"  Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- Compile source from the main project, excluding web-only code -->
  <ItemGroup>
    <Compile Include="BrixCMS.Open\Models\**\*.cs" />
    <Compile Include="BrixCMS.Open\Data\**\*.cs" />
    <Compile Include="BrixCMS.Open\Services\**\*.cs" />
    <Compile Include="BrixCMS.Open\Extensions\**\*.cs" />
    <Compile Include="BrixCMS.Open\DTOs\**\*.cs" />

    <!-- Exclude web-specific code that requires MVC / Razor / Blazor -->
    <Compile Remove="BrixCMS.Open\**\bin\**" />
    <Compile Remove="BrixCMS.Open\**\obj\**" />
  </ItemGroup>

  <!-- Same dependencies as the main project (non-web subset) -->
  <ItemGroup>
    <!-- Database -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite"     Version="10.0.7" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer"  Version="10.0.7" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL"    Version="10.0.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design"     Version="10.0.7">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>

    <!-- AI -->
    <PackageReference Include="Microsoft.Extensions.AI"                           Version="10.4.0" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI"                   Version="10.4.0" />
    <PackageReference Include="Microsoft.Extensions.VectorData.Abstractions"     Version="10.1.0" />
    <PackageReference Include="Microsoft.SemanticKernel.Connectors.InMemory"     Version="1.74.0-preview" />
    <PackageReference Include="OllamaSharp"                                       Version="5.4.25" />

    <!-- Content -->
    <PackageReference Include="PdfPig"          Version="0.1.14" />
    <PackageReference Include="Markdig"         Version="1.1.3"  />
    <PackageReference Include="HtmlSanitizer"   Version="9.0.892" />
    <PackageReference Include="System.Linq.Async" Version="7.0.1" />

    <!-- Image optimisation -->
    <PackageReference Include="SixLabors.ImageSharp.Web" Version="3.2.0" />

    <!-- QR Codes -->
    <PackageReference Include="QRCoder" Version="1.6.0" />

    <!-- Email -->
    <PackageReference Include="MailKit" Version="4.16.0" />

  </ItemGroup>

  <!-- ASP.NET Core framework (provides IServiceCollection, WebApplication, IConfiguration, etc.) -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- Global usings that Microsoft.NET.Sdk.Web adds automatically but Microsoft.NET.Sdk does not -->
  <ItemGroup>
    <Using Include="Microsoft.AspNetCore.Builder" />
    <Using Include="Microsoft.AspNetCore.Http" />
    <Using Include="Microsoft.AspNetCore.Routing" />
    <Using Include="Microsoft.AspNetCore.RateLimiting" />
    <Using Include="Microsoft.Extensions.Configuration" />
    <Using Include="Microsoft.Extensions.DependencyInjection" />
    <Using Include="Microsoft.Extensions.Logging" />
    <Using Include="System.Threading.RateLimiting" />
  </ItemGroup>

</Project>
