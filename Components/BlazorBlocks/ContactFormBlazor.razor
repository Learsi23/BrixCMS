@using BrixCMS.Open.Services.Email
@inject EmailSender EmailService

<div class="p-8 bg-white shadow-2xl rounded-3xl border border-gray-100 transition-all duration-500 hover:shadow-blue-100" 
     style="max-width: @(string.IsNullOrEmpty(Width) ? "500px" : Width); margin: 0 auto;">
    
    <h3 class="text-3xl font-extrabold mb-2 text-gray-800">@(Title ?? "Contact Us")</h3>
    <p class="text-gray-500 mb-8 text-sm">Send us a message and we'll get back to you as soon as possible.</p>

    @if (submitted)
    {
        <div class="animate-bounce-in p-6 text-center">
            <div class="w-16 h-16 bg-green-100 text-green-600 rounded-full flex items-center justify-center mx-auto mb-4">
                <i class="fas fa-paper-plane fa-lg"></i>
            </div>
            <h4 class="text-xl font-bold text-gray-800">Message Sent!</h4>
            <p class="text-green-700 mt-2">Thanks for reaching out, @contactModel.Name.</p>
        </div>
    }
    else
    {
        @* Corregido: Toda la lógica de la clase dentro de un solo bloque @() *@
        <EditForm Model="@contactModel" 
                  OnValidSubmit="HandleValidSubmit" 
                  class="@(isSending ? "opacity-50 pointer-events-none transition-opacity duration-500" : "transition-opacity duration-500")">
            <DataAnnotationsValidator />
            
            <div class="space-y-5">
                <div>
                    <label class="block text-xs font-bold uppercase tracking-wider text-gray-400 mb-1 ml-1">Full Name</label>
                    <InputText @bind-Value="contactModel.Name" class="w-full bg-gray-50 border-transparent border-2 p-3 rounded-xl focus:bg-white focus:border-blue-400 focus:ring-0 outline-none transition-all" placeholder="e.g. John Doe" />
                    <ValidationMessage For="@(() => contactModel.Name)" class="text-red-400 text-xs mt-1 italic" />
                </div>

                <div>
                    <label class="block text-xs font-bold uppercase tracking-wider text-gray-400 mb-1 ml-1">Email Address</label>
                    <InputText @bind-Value="contactModel.Email" class="w-full bg-gray-50 border-transparent border-2 p-3 rounded-xl focus:bg-white focus:border-blue-400 focus:ring-0 outline-none transition-all" placeholder="your@email.com" />
                    <ValidationMessage For="@(() => contactModel.Email)" class="text-red-400 text-xs mt-1 italic" />
                </div>

                <div>
                    <label class="block text-xs font-bold uppercase tracking-wider text-gray-400 mb-1 ml-1">Message</label>
                    <InputTextArea @bind-Value="contactModel.Message" class="w-full bg-gray-50 border-transparent border-2 p-3 rounded-xl focus:bg-white focus:border-blue-400 focus:ring-0 outline-none transition-all" rows="4" placeholder="Tell us more about your project..." />
                    <ValidationMessage For="@(() => contactModel.Message)" class="text-red-400 text-xs mt-1 italic" />
                </div>

                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="p-3 text-sm text-red-600 bg-red-50 rounded-lg border border-red-100 animate-pulse">
                        <i class="fas fa-exclamation-circle mr-1"></i> @errorMessage
                    </div>
                }

                <div style="text-align: @(string.IsNullOrEmpty(ButtonPosition) ? "center" : ButtonPosition)">
                    <button type="submit" 
                            disabled="@isSending" 
                            class="custom-btn shadow-lg transform hover:-translate-y-1 active:scale-95 transition-all duration-200"
                            style="@ButtonStyle">
                        @if (isSending)
                        {
                            <i class="fas fa-circle-notch fa-spin mr-2"></i>
                            <span>Processing...</span>
                        }
                        else
                        {
                            <span>@(ButtonText ?? "Send Message")</span>
                        }
                    </button>
                </div>
            </div>
        </EditForm>
    }
</div>

<style>
    .custom-btn:hover {
        background-color: @(HoverColor ?? "#1e40af") !important;
        box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
    }
    .animate-bounce-in {
        animation: bounceIn 0.6s ease-out;
    }
    @@keyframes bounceIn {
        0% { transform: scale(0.8); opacity: 0; }
        70% { transform: scale(1.05); }
        100% { transform: scale(1); opacity: 1; }
    }
</style>

@code {
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? RecipientEmail { get; set; }
    [Parameter] public string? ButtonText { get; set; }
    [Parameter] public string? ButtonColor { get; set; }
    [Parameter] public string? HoverColor { get; set; }
    [Parameter] public string? TextColor { get; set; }
    [Parameter] public string? BorderRadius { get; set; }
    [Parameter] public string? Border { get; set; }
    [Parameter] public string? Width { get; set; }
    [Parameter] public string? Padding { get; set; }
    [Parameter] public string? ButtonPosition { get; set; }

    private string ButtonStyle => 
        $"background-color: {ButtonColor ?? "#2563eb"}; " +
        $"color: {TextColor ?? "#ffffff"}; " +
        $"border-radius: {BorderRadius ?? "12px"}; " +
        $"border: {Border ?? "none"}; " +
        $"padding: {Padding ?? "14px 32px"}; " +
        $"font-weight: 700; display: inline-flex; items-center; justify-content: center; min-width: 160px;";

    private ContactModel contactModel = new();
    private bool isSending = false;
    private bool submitted = false;
    private string? errorMessage;

    private async Task HandleValidSubmit()
    {
        isSending = true;
        errorMessage = null;

        try
        {
            await Task.Run(() =>
            {
                EmailService.SendEmail(
                    senderName: contactModel.Name,
                    senderEmail: contactModel.Email,
                    toName: "Admin",
                    toEmail: RecipientEmail ?? "support@yourweb.com",
                    subject: $"?? New Lead: {contactModel.Name}",
                    textContent: $"Contact Details:\nName: {contactModel.Name}\nEmail: {contactModel.Email}\n\nMessage:\n{contactModel.Message}"
                );
            });

            isSending = false;
            submitted = true;
            StateHasChanged();

            await Task.Delay(4000);
            submitted = false;
            contactModel = new ContactModel(); 
            StateHasChanged();
        }
        catch (Exception)
        {
            isSending = false;
            errorMessage = "Connection error. Please try again later.";
        }
    }

    public class ContactModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Please enter your name")]
        public string Name { get; set; } = "";

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Email is required")]
        [System.ComponentModel.DataAnnotations.EmailAddress(ErrorMessage = "Invalid email format")]
        public string Email { get; set; } = "";

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Please write a message")]
        [System.ComponentModel.DataAnnotations.StringLength(1000, MinimumLength = 10, ErrorMessage = "Message is too short")]
        public string Message { get; set; } = "";
    }
}
